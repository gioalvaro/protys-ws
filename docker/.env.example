# PROTYS-WS Docker environment variables
#
# Copy this file to docker/.env and adjust the values before deploying.
# docker compose automatically loads .env from the directory where it runs.
# The defaults shown here match the development fallbacks declared in
# docker-compose.yml; NEVER use them in production.

# Apache Jena Fuseki administrator password (ADMIN_PASSWORD of the
# protys-fuseki service, used to manage datasets at http://localhost:3030).
FUSEKI_ADMIN_PASSWORD=admin123

# PostgreSQL database used for ERP data (ADempiere/Odoo schemas) and the
# backend's JPA persistence. Shared by protys-postgres and protys-backend.
POSTGRES_DB=protys_db
POSTGRES_USER=protys_user
POSTGRES_PASSWORD=protys_password
