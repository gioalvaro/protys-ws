# Credenciales de DEMOSTRACIÓN para las fuentes ERP de la prueba de integración.
# Son los mismos valores por defecto de docker-compose.erp.yml; no son credenciales reales.
# Para cambiarlos, copiar estas líneas a docker/.env (Compose lee el .env de la carpeta del
# primer archivo -f).

# Superusuario de la base de ADempiere (sólo para restaurar la semilla y para las huellas).
ERP_ADMIN_USER=postgres
ERP_ADMIN_PASSWORD=demo_admin
# Dueño de los objetos del volcado de ADempiere.
ADEMPIERE_DB_PASSWORD=adempiere_demo

# Base de Odoo (usuario dueño, el que usa el servidor de Odoo).
ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=odoo_demo

# Rol de sólo lectura con el que PROTYS-WS se conecta a los dos ERP.
PROTYS_RO_USER=protys_ro
PROTYS_RO_PASSWORD=protys_ro_demo

# Puertos publicados sólo en 127.0.0.1.
ERP_ADEMPIERE_DB_PORT=55433
ERP_ODOO_DB_PORT=55432
ERP_ODOO_HTTP_PORT=8069
