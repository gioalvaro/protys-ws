    <!-- http://w3id.org/protys/ontology/alignment#flowRefersToProduct -->

    <owl:ObjectProperty rdf:about="http://w3id.org/protys/ontology/alignment#flowRefersToProduct">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://w3id.org/protys/ontology/iso14040#ElementaryFlow"/>
                    <rdf:Description rdf:about="http://w3id.org/protys/ontology/iso14040#ProductFlow"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://w3id.org/protys/ontology/product#Product"/>
        <rdfs:range rdf:resource="http://w3id.org/protys/ontology/product#Production_Item"/>
        <rdfs:range rdf:resource="http://w3id.org/protys/ontology/product#Substance"/>
        <rdfs:range rdf:resource="http://w3id.org/protys/ontology/product#Thing"/>
    </owl:ObjectProperty>
    


