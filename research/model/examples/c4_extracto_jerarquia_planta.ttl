@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix c: <http://w3id.org/protys/ontology/core#> .
@prefix ent: <http://w3id.org/protys/ontology/enterprise#> .
# Extracto de ontologies/enterprise-module.owl: isPartOf transitiva y la cadena Station - Cell - Shop - Factory - Enterprise.
ent:isPartOf a owl:ObjectProperty, owl:TransitiveProperty .
ent:Station rdfs:subClassOf [ a owl:Restriction ; owl:onProperty ent:isPartOf ; owl:someValuesFrom ent:Cell ] .
ent:Cell rdfs:subClassOf [ a owl:Restriction ; owl:onProperty ent:isPartOf ; owl:someValuesFrom ent:Shop ] .
ent:Shop rdfs:subClassOf [ a owl:Restriction ; owl:onProperty ent:isPartOf ; owl:someValuesFrom ent:Factory ] .
ent:Factory rdfs:subClassOf [ a owl:Restriction ; owl:onProperty ent:isPartOf ; owl:someValuesFrom c:Enterprise ] .
