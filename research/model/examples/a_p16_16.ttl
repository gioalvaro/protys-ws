@prefix : <urn:protys:example:> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
# Marca declarativa de balance de masa: el booleano satisfiesMassBalance
# no se calcula en OWL; lo asigna un procedimiento externo que verifica
# entradas = salidas + pérdidas con tolerancia documentada (véase Q07, Anexo B).
:Balanced_Process rdf:type owl:Class ;
owl:equivalentClass [
rdf:type owl:Class ;
owl:intersectionOf ( :Process
[ rdf:type owl:Restriction ;
owl:onProperty :satisfiesMassBalance ;
owl:hasValue true ] )
] .
