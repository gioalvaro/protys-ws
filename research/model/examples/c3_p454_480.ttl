@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix i: <http://w3id.org/protys/ontology/iso15531#> .
# Extracto de declaraciones nombradas y vínculos directos.
# Fuente: ontologies/iso15531-module.owl; no reproduce todas sus restricciones.
i:ManufacturingResource a owl:Class .
i:EquipmentResource a owl:Class .
i:EquipmentResource rdfs:subClassOf i:ManufacturingResource .
i:HumanResource a owl:Class .
i:HumanResource rdfs:subClassOf i:ManufacturingResource .
i:ManufacturingProcess a owl:Class .
i:ProcessOperation a owl:Class .
i:ProcessPlan a owl:Class .
i:ManufacturingFlow a owl:Class .
i:ManufacturingData a owl:Class .
i:ProductionOrder a owl:Class .
i:WorkOrder a owl:Class .
i:Lot a owl:Class .
i:ManufacturingCapability a owl:Class .
i:ResourceState a owl:Class .
i:ProcessState a owl:Class .
i:TimeAttribute a owl:Class .
i:CostAttribute a owl:Class .
i:QualityAttribute a owl:Class .
i:ManufacturingFacility a owl:Class .
