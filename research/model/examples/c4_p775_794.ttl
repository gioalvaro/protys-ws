@prefix i: <http://w3id.org/protys/ontology/iso15531#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
i:requiresResource a owl:ObjectProperty ;
  rdfs:domain i:ProcessOperation ;
  rdfs:range i:ManufacturingResource .
i:hasInput a owl:ObjectProperty ;
  rdfs:domain i:ProcessOperation ;
  rdfs:range i:ManufacturingResource .
