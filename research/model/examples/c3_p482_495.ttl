@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix c: <http://w3id.org/protys/ontology/core#> .
@prefix i: <http://w3id.org/protys/ontology/iso15531#> .
@prefix e: <http://w3id.org/protys/ontology/iso14040#> .
@prefix a: <http://w3id.org/protys/ontology/alignment#> .
@prefix t: <http://w3id.org/protys/ontology/research#> .
# Extracto de declaraciones nombradas y vínculos directos.
# Fuente: ontologies/alignment-rules.owl; no reproduce todas sus restricciones.
a:flowRefersToProduct a owl:ObjectProperty .
a:flowRefersToProduct rdfs:domain e:ProductFlow .
a:flowRefersToProduct rdfs:range c:Product .
a:hasInventoryRepresentation a owl:ObjectProperty .
a:hasInventoryRepresentation rdfs:domain i:ManufacturingProcess .
a:hasInventoryRepresentation rdfs:range e:UnitProcess .
a:inputFlowForResource a owl:ObjectProperty .
a:inputFlowForResource rdfs:domain e:ProductFlow .
a:inputFlowForResource rdfs:range i:ManufacturingResource .
a:facilityInBoundary a owl:ObjectProperty .
a:facilityInBoundary rdfs:domain i:ManufacturingFacility .
a:facilityInBoundary rdfs:range e:SystemBoundary .
a:indicatorForLot a owl:ObjectProperty .
a:indicatorForLot rdfs:domain e:ImpactIndicator .
a:indicatorForLot rdfs:range i:Lot .
a:allocationForOperation a owl:ObjectProperty .
a:allocationForOperation rdfs:domain e:AllocationProcedure .
a:allocationForOperation rdfs:range i:ProcessOperation .
a:inventoryForPlan a owl:ObjectProperty .
a:inventoryForPlan rdfs:domain e:LifeCycleInventory .
a:inventoryForPlan rdfs:range i:ProcessPlan .
a:qualityForLot a owl:ObjectProperty .
a:qualityForLot rdfs:domain i:QualityAttribute .
a:qualityForLot rdfs:range i:Lot .
t:flowRefersToProduct a owl:ObjectProperty .
t:flowRefersToProduct rdfs:subPropertyOf a:flowRefersToProduct .
t:hasInventoryRepresentation a owl:ObjectProperty .
t:hasInventoryRepresentation rdfs:subPropertyOf a:hasInventoryRepresentation .
t:inputFlowForResource a owl:ObjectProperty .
t:inputFlowForResource rdfs:subPropertyOf a:inputFlowForResource .
t:facilityInBoundary a owl:ObjectProperty .
t:facilityInBoundary rdfs:subPropertyOf a:facilityInBoundary .
t:indicatorForLot a owl:ObjectProperty .
t:indicatorForLot rdfs:subPropertyOf a:indicatorForLot .
t:allocationForOperation a owl:ObjectProperty .
t:allocationForOperation rdfs:subPropertyOf a:allocationForOperation .
t:inventoryForPlan a owl:ObjectProperty .
t:inventoryForPlan rdfs:subPropertyOf a:inventoryForPlan .
t:qualityForLot a owl:ObjectProperty .
t:qualityForLot rdfs:subPropertyOf a:qualityForLot .
