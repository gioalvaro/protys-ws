PREFIX i: <http://w3id.org/protys/ontology/iso15531#>
PREFIX e: <http://w3id.org/protys/ontology/iso14040#>
PREFIX c: <http://w3id.org/protys/ontology/core#>
PREFIX a: <http://w3id.org/protys/ontology/alignment#>
PREFIX t: <http://w3id.org/protys/ontology/research#>
PREFIX p: <http://w3id.org/protys/ontology/paint-ext#>
PREFIX r: <http://w3id.org/protys/ontology/resource#>
PREFIX f: <http://w3id.org/protys/fixture#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK { ?lot a i:Lot ; i:hasProcess ?process ; i:hasActivity ?op .
?op a i:ProcessOperation ; i:partOfProcess ?process .
FILTER NOT EXISTS { ?op i:consumesEnergyKWh ?energy .
FILTER(isNumeric(?energy) && ?energy >= 0)
FILTER NOT EXISTS { ?op i:consumesEnergyKWh ?nEnergyOther .
FILTER(!isNumeric(?nEnergyOther) || ?nEnergyOther != ?energy) }
?op t:hasEmissionFactor ?nFactor .
FILTER(isIRI(?nFactor))
FILTER NOT EXISTS { ?op t:hasEmissionFactor ?nOtherFactor .
FILTER(!sameTerm(?nOtherFactor,?nFactor)) }
?nFactor a t:ElectricityEmissionFactor ; t:factorUnit "kg CO2e/kWh" .
FILTER NOT EXISTS { ?nFactor t:factorUnit ?nOtherUnit .
FILTER(STR(?nOtherUnit) != "kg CO2e/kWh") }
?nFactor t:factorValue ?nFactorValue .
FILTER(isNumeric(?nFactorValue) && ?nFactorValue >= 0)
FILTER NOT EXISTS { ?nFactor t:factorValue ?nFactorOther .
FILTER(!isNumeric(?nFactorOther) || ?nFactorOther != ?nFactorValue) }
?op e:hasGHGImpactKgCO2e ?ghg .
FILTER(isNumeric(?ghg) && ?ghg >= 0)
FILTER NOT EXISTS { ?op e:hasGHGImpactKgCO2e ?nGHGOther .
FILTER(!isNumeric(?nGHGOther) || ?nGHGOther != ?ghg) }
FILTER(ABS(?ghg - ?energy * ?nFactorValue) <= 0.000000001) } }
