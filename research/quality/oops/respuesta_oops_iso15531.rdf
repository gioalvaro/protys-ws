  <rdf:Description rdf:about="http://oops.linkeddata.es/data/95eeef01-6067-42e7-8d5c-705d85eb27ba">
    <oops:hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Missing annotations</oops:hasName>
    <oops:hasAffectedElement rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://w3id.org/protys/ontology/iso15531#ManufacturingFacility</oops:hasAffectedElement>
