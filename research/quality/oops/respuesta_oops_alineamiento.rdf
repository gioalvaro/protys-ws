  <rdf:Description rdf:about="http://oops.linkeddata.es/data/cd5abe1d-f001-4a4f-8a14-72bf38fa7887">
    <oops:hasNumberAffectedElements rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</oops:hasNumberAffectedElements>
    <oops:hasAffectedElement rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://w3id.org/protys/ontology/alignment#SPARQLValidationPattern</oops:hasAffectedElement>
    <oops:hasAffectedElement rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://w3id.org/protys/ontology/core#Hotspot</oops:hasAffectedElement>
    <oops:hasAffectedElement rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://w3id.org/protys/ontology/core#MissingEnvironmentalData</oops:hasAffectedElement>
