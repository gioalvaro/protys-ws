          </swrl:ClassAtom>
        </rdf:first>
      </rdf:List>
    </swrl:body>
    <rdfs:label>R14: Operador responsable de la operación de su orden</rdfs:label>
  </swrl:Imp>
  <swrl:Imp rdf:about="http://w3id.org/protys/ontology/alignment#R02">
    <swrl:head>
      <rdf:List>
        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        <rdf:first>
          <swrl:IndividualPropertyAtom>
            <swrl:argument2>
              <e:ElementaryFlow rdf:about="http://w3id.org/protys/ontology/core#WaterFlow">
                <rdfs:comment xml:lang="es">Flujo elemental de agua (cabeza de R02; IRI protys:WaterFlow tal como figura en el Anexo C).</rdfs:comment>
                <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
              </e:ElementaryFlow>
            </swrl:argument2>
            <swrl:argument1 rdf:resource="http://w3id.org/protys/ontology/alignment#var_process"/>
            <swrl:propertyPredicate rdf:resource="http://w3id.org/protys/ontology/iso14040#hasInventoryFlow"/>
          </swrl:IndividualPropertyAtom>
        </rdf:first>
      </rdf:List>
    </swrl:head>
    <swrl:body>
      <rdf:List>
        <rdf:rest>
          <rdf:List>
            <rdf:rest>
              <rdf:List>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                <rdf:first>
                  <swrl:IndividualPropertyAtom>
                    <swrl:argument2 rdf:resource="http://w3id.org/protys/ontology/alignment#var_process"/>
                    <swrl:argument1 rdf:resource="http://w3id.org/protys/ontology/alignment#var_op"/>
                    <swrl:propertyPredicate rdf:resource="http://w3id.org/protys/ontology/iso15531#partOfProcess"/>
                  </swrl:IndividualPropertyAtom>
                </rdf:first>
              </rdf:List>
            </rdf:rest>
            <rdf:first>
              <swrl:DatavaluedPropertyAtom>
                <swrl:argument2>
                  <swrl:Variable rdf:about="http://w3id.org/protys/ontology/alignment#var_water"/>
                </swrl:argument2>
                <swrl:argument1 rdf:resource="http://w3id.org/protys/ontology/alignment#var_op"/>
                <swrl:propertyPredicate rdf:resource="http://w3id.org/protys/ontology/iso15531#consumesWaterL"/>
              </swrl:DatavaluedPropertyAtom>
            </rdf:first>
          </rdf:List>
        </rdf:rest>
        <rdf:first>
          <swrl:ClassAtom>
            <swrl:argument1 rdf:resource="http://w3id.org/protys/ontology/alignment#var_op"/>
            <swrl:classPredicate rdf:resource="http://w3id.org/protys/ontology/iso15531#ProcessOperation"/>
          </swrl:ClassAtom>
        </rdf:first>
      </rdf:List>
    </swrl:body>
    <rdfs:label>R02: Presencia de inventario de agua del proceso</rdfs:label>
  </swrl:Imp>
  <i:WorkOrder rdf:about="http://w3id.org/protys/fixture#order">
    <i:producesLot>
      <i:Lot rdf:about="http://w3id.org/protys/fixture#lot">
