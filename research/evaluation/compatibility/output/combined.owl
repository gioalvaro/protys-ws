    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label>capacityTonsPerMonth</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://w3id.org/protys/ontology/research#startTimeSeconds">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://w3id.org/protys/ontology/paint-ext#numberOfEmployees">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label>numberOfEmployees</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://w3id.org/protys/ontology/iso15531#cycleTime">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:comment xml:lang="es">Tiempo de ciclo de una operación (reglas R12 y R23, Listado 3.4).</rdfs:comment>
    <rdfs:label>cycleTime</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://w3id.org/protys/ontology/iso15531#cycleTimeMinutes">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:comment xml:lang="es">Tiempo de ciclo en minutos (instancias del caso de estudio, Cap. 4).</rdfs:comment>
    <rdfs:label>cycleTimeMinutes</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://w3id.org/protys/ontology/iso14040#hasFunctionalUnitQuantity">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:comment xml:lang="es">Cantidad expresada en la unidad funcional, para comparación entre lotes (cabeza de la regla R08, Anexo C).</rdfs:comment>
    <rdfs:label>hasFunctionalUnitQuantity</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://w3id.org/protys/ontology/paint-ext#capacityUnitsPerMinute">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label>capacityUnitsPerMinute</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://w3id.org/protys/ontology/core#hasPriorVersion">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="es">Versión anterior de un término o entidad (soporta la CQ P5 de versionado, Anexo B Q21).</rdfs:comment>
    <rdfs:label>hasPriorVersion</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://w3id.org/protys/ontology/paint-ext#yearOfExperience">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label>yearOfExperience</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://w3id.org/protys/ontology/research#eventTimeSeconds">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://w3id.org/protys/ontology/paint-ext#OEEPercent">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label>OEEPercent</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://w3id.org/protys/ontology/research#lifecycleStage">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://w3id.org/protys/ontology/iso14040#factorValue">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:domain rdf:resource="http://w3id.org/protys/ontology/iso14040#CharacterizationFactor"/>
    <rdfs:comment xml:lang="es">Valor numérico de un factor de emisión/caracterización (reglas R01 y R21, Anexo C).</rdfs:comment>
    <rdfs:label>factorValue</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://w3id.org/protys/ontology/paint-ext#hasURI">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
    <rdfs:label>hasURI</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://w3id.org/protys/ontology/research#stageIndex">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://w3id.org/protys/ontology/iso14040#hasIndicatorValue">
    <owl:equivalentProperty rdf:resource="http://w3id.org/protys/ontology/iso14040#indicatorValue"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:domain rdf:resource="http://w3id.org/protys/ontology/iso14040#ImpactIndicator"/>
    <rdfs:comment xml:lang="es">Valor numérico de un indicador de impacto (regla R04, Anexo C).</rdfs:comment>
    <rdfs:label>hasIndicatorValue</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://w3id.org/protys/ontology/paint-ext#glassTransitionTemp">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label>glassTransitionTemp</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://w3id.org/protys/ontology/core#hasLotGHGImpact">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:comment xml:lang="es">Impacto GHG agregado por lote (cabeza de R21).</rdfs:comment>
    <rdfs:label>hasLotGHGImpact</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://w3id.org/protys/ontology/research#endTimeSeconds">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:TransitiveProperty rdf:about="http://w3id.org/protys/ontology/enterprise#isPartOf">
    <rdfs:comment xml:lang="es">Agregación jerárquica entre niveles organizacionales (Station en Cell, Cell en Shop, Shop en Factory, Factory en Enterprise).</rdfs:comment>
    <rdfs:label>isPartOf</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </owl:TransitiveProperty>
  <owl:FunctionalProperty rdf:about="http://w3id.org/protys/ontology/iso14040#hasFunctionalUnit">
    <rdfs:range rdf:resource="http://w3id.org/protys/ontology/iso14040#FunctionalUnit"/>
    <rdfs:domain rdf:resource="http://w3id.org/protys/ontology/iso14040#LCAStudy"/>
    <rdfs:comment xml:lang="es">Todo estudio de ACV tiene exactamente una unidad funcional (Listado 3.1).</rdfs:comment>
    <rdfs:label>hasFunctionalUnit</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </owl:FunctionalProperty>
  <owl:AllDisjointClasses>
    <owl:members rdf:parseType="Collection">
      <owl:Class rdf:about="http://w3id.org/protys/ontology/iso14040#ElementaryFlow"/>
      <owl:Class rdf:about="http://w3id.org/protys/ontology/iso14040#ProductFlow"/>
    </owl:members>
  </owl:AllDisjointClasses>
  <swrl:Variable rdf:about="http://w3id.org/protys/ontology/alignment#var_ef"/>
  <swrl:Variable rdf:about="http://w3id.org/protys/ontology/alignment#var_ip"/>
  <swrl:Variable rdf:about="http://w3id.org/protys/ontology/alignment#var_a"/>
  <swrl:Variable rdf:about="http://w3id.org/protys/ontology/alignment#var_cf"/>
  <swrl:Variable rdf:about="http://w3id.org/protys/ontology/alignment#var_eco"/>
  <swrl:Variable rdf:about="http://w3id.org/protys/ontology/alignment#var_wo"/>
  <swrl:Variable rdf:about="http://w3id.org/protys/ontology/alignment#var_d"/>
  <swrl:Variable rdf:about="http://w3id.org/protys/ontology/alignment#var_oper"/>
  <t:RatioObservation rdf:about="http://w3id.org/protys/fixture#ratio">
    <t:forIndicator>
      <e:ImpactIndicator rdf:about="http://w3id.org/protys/fixture#indicator">
        <e:hasIndicatorValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal"
        >10</e:hasIndicatorValue>
        <e:indicatorValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal"
        >10</e:indicatorValue>
        <e:computedForProcess>
          <i:ManufacturingProcess rdf:about="http://w3id.org/protys/fixture#process">
            <e:emits>
              <e:ElementaryFlow rdf:about="http://w3id.org/protys/fixture#flow">
                <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
              </e:ElementaryFlow>
            </e:emits>
            <rdf:type rdf:resource="http://w3id.org/protys/ontology/iso14040#UnitProcess"/>
            <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
          </i:ManufacturingProcess>
        </e:computedForProcess>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
      </e:ImpactIndicator>
    </t:forIndicator>
    <t:forOperation>
      <t:FineGrindingOperation rdf:about="http://w3id.org/protys/fixture#op">
        <i:consumesEnergyKWh rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal"
        >10</i:consumesEnergyKWh>
        <i:cycleTime rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal"
        >20</i:cycleTime>
        <e:hasEmissionFactor>
          <e:CharacterizationFactor rdf:about="http://w3id.org/protys/fixture#factor">
            <e:factorUnit>kg CO2e/kWh</e:factorUnit>
            <e:factorValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal"
            >0.5</e:factorValue>
            <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
          </e:CharacterizationFactor>
        </e:hasEmissionFactor>
        <rdf:type rdf:resource="http://w3id.org/protys/ontology/iso15531#ProcessOperation"/>
        <i:partOfProcess rdf:resource="http://w3id.org/protys/fixture#process"/>
        <i:yield rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal"
        >98</i:yield>
        <i:requiresResource>
          <i:EquipmentResource rdf:about="http://w3id.org/protys/fixture#mill">
            <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
          </i:EquipmentResource>
        </i:requiresResource>
        <i:duration rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal"
        >20</i:duration>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
      </t:FineGrindingOperation>
    </t:forOperation>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </t:RatioObservation>
  <swrl:Imp rdf:about="http://w3id.org/protys/ontology/alignment#R09">
    <swrl:head>
      <rdf:List>
        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        <rdf:first>
          <swrl:IndividualPropertyAtom>
            <swrl:argument2>
              <swrl:Variable rdf:about="http://w3id.org/protys/ontology/alignment#var_resource"/>
            </swrl:argument2>
            <swrl:argument1>
              <swrl:Variable rdf:about="http://w3id.org/protys/ontology/alignment#var_op"/>
            </swrl:argument1>
            <swrl:propertyPredicate rdf:resource="http://w3id.org/protys/ontology/iso15531#usesResource"/>
          </swrl:IndividualPropertyAtom>
        </rdf:first>
      </rdf:List>
    </swrl:head>
    <swrl:body>
      <rdf:List>
        <rdf:rest>
          <rdf:List>
            <rdf:rest>
              <rdf:List>
                <rdf:rest>
                  <rdf:List>
                    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                    <rdf:first>
                      <swrl:IndividualPropertyAtom>
                        <swrl:argument2 rdf:resource="http://w3id.org/protys/ontology/alignment#var_resource"/>
                        <swrl:argument1 rdf:resource="http://w3id.org/protys/ontology/alignment#var_op"/>
                        <swrl:propertyPredicate rdf:resource="http://w3id.org/protys/ontology/iso15531#requiresResource"/>
                      </swrl:IndividualPropertyAtom>
                    </rdf:first>
                  </rdf:List>
                </rdf:rest>
                <rdf:first>
                  <swrl:IndividualPropertyAtom>
                    <swrl:argument2 rdf:resource="http://w3id.org/protys/ontology/alignment#var_op"/>
                    <swrl:argument1>
                      <swrl:Variable rdf:about="http://w3id.org/protys/ontology/alignment#var_plan"/>
                    </swrl:argument1>
                    <swrl:propertyPredicate rdf:resource="http://w3id.org/protys/ontology/iso15531#includesActivity"/>
                  </swrl:IndividualPropertyAtom>
                </rdf:first>
              </rdf:List>
            </rdf:rest>
            <rdf:first>
              <swrl:IndividualPropertyAtom>
                <swrl:argument2 rdf:resource="http://w3id.org/protys/ontology/alignment#var_resource"/>
                <swrl:argument1 rdf:resource="http://w3id.org/protys/ontology/alignment#var_plan"/>
                <swrl:propertyPredicate rdf:resource="http://w3id.org/protys/ontology/iso15531#assignsResource"/>
              </swrl:IndividualPropertyAtom>
            </rdf:first>
          </rdf:List>
        </rdf:rest>
        <rdf:first>
          <swrl:ClassAtom>
            <swrl:argument1 rdf:resource="http://w3id.org/protys/ontology/alignment#var_plan"/>
            <swrl:classPredicate rdf:resource="http://w3id.org/protys/ontology/iso15531#ProcessPlan"/>
          </swrl:ClassAtom>
        </rdf:first>
      </rdf:List>
    </swrl:body>
    <rdfs:label>R09: Uso del recurso requerido y asignado en el mismo plan</rdfs:label>
  </swrl:Imp>
  <swrl:Variable rdf:about="http://w3id.org/protys/ontology/alignment#var_thr"/>
  <swrl:Imp rdf:about="http://w3id.org/protys/ontology/alignment#R08">
    <swrl:head>
      <rdf:List>
        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        <rdf:first>
          <swrl:DatavaluedPropertyAtom>
            <swrl:argument2>
              <swrl:Variable rdf:about="http://w3id.org/protys/ontology/alignment#var_qty"/>
            </swrl:argument2>
            <swrl:argument1>
              <swrl:Variable rdf:about="http://w3id.org/protys/ontology/alignment#var_lot"/>
            </swrl:argument1>
            <swrl:propertyPredicate rdf:resource="http://w3id.org/protys/ontology/iso14040#hasFunctionalUnitQuantity"/>
          </swrl:DatavaluedPropertyAtom>
        </rdf:first>
      </rdf:List>
    </swrl:head>
    <swrl:body>
      <rdf:List>
        <rdf:rest>
          <rdf:List>
            <rdf:rest>
              <rdf:List>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                <rdf:first>
                  <swrl:DatavaluedPropertyAtom>
                    <swrl:argument2 rdf:resource="http://w3id.org/protys/ontology/alignment#var_qty"/>
                    <swrl:argument1 rdf:resource="http://w3id.org/protys/ontology/alignment#var_lot"/>
                    <swrl:propertyPredicate rdf:resource="http://w3id.org/protys/ontology/iso15531#producesQuantity"/>
                  </swrl:DatavaluedPropertyAtom>
                </rdf:first>
              </rdf:List>
            </rdf:rest>
            <rdf:first>
              <swrl:DatavaluedPropertyAtom>
                <swrl:argument2>
                  <swrl:Variable rdf:about="http://w3id.org/protys/ontology/alignment#var_unit"/>
                </swrl:argument2>
                <swrl:argument1 rdf:resource="http://w3id.org/protys/ontology/alignment#var_lot"/>
                <swrl:propertyPredicate rdf:resource="http://w3id.org/protys/ontology/iso15531#functionalUnit"/>
              </swrl:DatavaluedPropertyAtom>
            </rdf:first>
          </rdf:List>
        </rdf:rest>
        <rdf:first>
          <swrl:ClassAtom>
            <swrl:argument1 rdf:resource="http://w3id.org/protys/ontology/alignment#var_lot"/>
            <swrl:classPredicate rdf:resource="http://w3id.org/protys/ontology/iso15531#Lot"/>
          </swrl:ClassAtom>
        </rdf:first>
      </rdf:List>
    </swrl:body>
    <rdfs:label>R08: Cantidad de unidad funcional del lote</rdfs:label>
  </swrl:Imp>
  <swrl:Variable rdf:about="http://w3id.org/protys/ontology/alignment#var_i"/>
  <swrl:Imp rdf:about="http://w3id.org/protys/ontology/alignment#R18">
    <swrl:head>
      <rdf:List>
        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        <rdf:first>
          <swrl:ClassAtom>
            <swrl:argument1 rdf:resource="http://w3id.org/protys/ontology/alignment#var_lot"/>
            <swrl:classPredicate rdf:resource="http://w3id.org/protys/ontology/iso15531#requiresReprocess"/>
          </swrl:ClassAtom>
        </rdf:first>
      </rdf:List>
    </swrl:head>
    <swrl:body>
      <rdf:List>
        <rdf:rest>
          <rdf:List>
            <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            <rdf:first>
              <swrl:IndividualPropertyAtom>
                <swrl:argument2>
                  <swrl:Variable rdf:about="http://w3id.org/protys/ontology/alignment#var_nonconformity"/>
                </swrl:argument2>
                <swrl:argument1 rdf:resource="http://w3id.org/protys/ontology/alignment#var_lot"/>
                <swrl:propertyPredicate rdf:resource="http://w3id.org/protys/ontology/iso15531#hasNonConformity"/>
              </swrl:IndividualPropertyAtom>
            </rdf:first>
          </rdf:List>
        </rdf:rest>
        <rdf:first>
          <swrl:ClassAtom>
            <swrl:argument1 rdf:resource="http://w3id.org/protys/ontology/alignment#var_lot"/>
            <swrl:classPredicate rdf:resource="http://w3id.org/protys/ontology/iso15531#Lot"/>
          </swrl:ClassAtom>
        </rdf:first>
      </rdf:List>
    </swrl:body>
    <rdfs:label>R18: Marcar lote candidato a reproceso por no conformidad</rdfs:label>
  </swrl:Imp>
  <swrl:Imp rdf:about="http://w3id.org/protys/ontology/alignment#R06">
    <swrl:head>
      <rdf:List>
        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        <rdf:first>
          <swrl:IndividualPropertyAtom>
            <swrl:argument2>
              <swrl:Variable rdf:about="http://w3id.org/protys/ontology/alignment#var_factor"/>
            </swrl:argument2>
            <swrl:argument1>
              <swrl:Variable rdf:about="http://w3id.org/protys/ontology/alignment#var_flow"/>
            </swrl:argument1>
            <swrl:propertyPredicate rdf:resource="http://w3id.org/protys/ontology/iso14040#usesCharacterizationFactor"/>
          </swrl:IndividualPropertyAtom>
        </rdf:first>
      </rdf:List>
    </swrl:head>
    <swrl:body>
      <rdf:List>
        <rdf:rest>
          <rdf:List>
            <rdf:rest>
              <rdf:List>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                <rdf:first>
                  <swrl:IndividualPropertyAtom>
                    <swrl:argument2 rdf:resource="http://w3id.org/protys/ontology/alignment#var_factor"/>
                    <swrl:argument1>
                      <swrl:Variable rdf:about="http://w3id.org/protys/ontology/alignment#var_material"/>
                    </swrl:argument1>
                    <swrl:propertyPredicate rdf:resource="http://w3id.org/protys/ontology/iso14040#hasCharacterizationFactor"/>
                  </swrl:IndividualPropertyAtom>
                </rdf:first>
              </rdf:List>
            </rdf:rest>
            <rdf:first>
              <swrl:IndividualPropertyAtom>
                <swrl:argument2 rdf:resource="http://w3id.org/protys/ontology/alignment#var_material"/>
                <swrl:argument1 rdf:resource="http://w3id.org/protys/ontology/alignment#var_flow"/>
                <swrl:propertyPredicate rdf:resource="http://w3id.org/protys/ontology/iso14040#refersToMaterial"/>
              </swrl:IndividualPropertyAtom>
            </rdf:first>
          </rdf:List>
        </rdf:rest>
        <rdf:first>
          <swrl:ClassAtom>
            <swrl:argument1 rdf:resource="http://w3id.org/protys/ontology/alignment#var_flow"/>
            <swrl:classPredicate rdf:resource="http://w3id.org/protys/ontology/iso14040#ElementaryFlow"/>
          </swrl:ClassAtom>
        </rdf:first>
      </rdf:List>
    </swrl:body>
    <rdfs:label>R06: Asociar factor al flujo del material correspondiente</rdfs:label>
  </swrl:Imp>
  <swrl:Variable rdf:about="http://w3id.org/protys/ontology/alignment#var_fu"/>
  <a:SPARQLValidationPattern rdf:about="http://w3id.org/protys/ontology/alignment#R07_ValidationPattern">
    <rdfs:comment xml:lang="es">Detectar faltantes de datos ambientales requeridos (completitud). Reformulada como consulta SPARQL ASK con FILTER NOT EXISTS (el built-in swrlb:notBound no existe en SWRL); no es una regla de inferencia. Consulta completa en ontologies/alignment-queries.sparql (R07).</rdfs:comment>
    <rdfs:label>R07: patrón de validación SPARQL ASK</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </a:SPARQLValidationPattern>
  <swrl:Variable rdf:about="http://w3id.org/protys/ontology/alignment#var_eq"/>
  <a:SPARQLValidationPattern rdf:about="http://w3id.org/protys/ontology/alignment#R16_ValidationPattern">
    <rdfs:comment xml:lang="es">Validar consistencia: toda actividad debe consumir al menos un input material. Reformulada como consulta SPARQL ASK con FILTER NOT EXISTS (el built-in swrlb:notBound no existe en SWRL); no es una regla de inferencia. Consulta completa en ontologies/alignment-queries.sparql (R16).</rdfs:comment>
    <rdfs:label>R16: patrón de validación SPARQL ASK</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </a:SPARQLValidationPattern>
  <swrl:Variable rdf:about="http://w3id.org/protys/ontology/alignment#var_up"/>
