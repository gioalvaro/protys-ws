          </swrl:ClassAtom>
        </rdf:first>
      </rdf:List>
    </swrl:body>
    <rdfs:label>R15: Marcar indisponibilidad temporal con mantenimiento registrado</rdfs:label>
  </swrl:Imp>
  <swrl:Imp rdf:about="http://w3id.org/protys/ontology/alignment#R03">
    <swrl:head>
      <rdf:List>
        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
