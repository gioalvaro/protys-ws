      </i:Lot>
    </i:producesLot>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </i:WorkOrder>
  <swrl:Variable rdf:about="http://w3id.org/protys/ontology/alignment#var_y"/>
  <swrl:Imp rdf:about="http://w3id.org/protys/ontology/alignment#R21">
    <swrl:head>
      <rdf:List>
        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        <rdf:first>
          <swrl:IndividualPropertyAtom>
            <swrl:argument2 rdf:resource="http://w3id.org/protys/ontology/alignment#var_op"/>
            <swrl:argument1 rdf:resource="http://w3id.org/protys/ontology/alignment#var_lot"/>
            <swrl:propertyPredicate rdf:resource="http://w3id.org/protys/ontology/research#hasGHGContribution"/>
          </swrl:IndividualPropertyAtom>
        </rdf:first>
      </rdf:List>
    </swrl:head>
    <swrl:body>
      <rdf:List>
        <rdf:rest>
          <rdf:List>
            <rdf:rest>
              <rdf:List>
                <rdf:rest>
                  <rdf:List>
                    <rdf:rest>
                      <rdf:List>
                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                        <rdf:first>
                          <swrl:DatavaluedPropertyAtom>
                            <swrl:argument2 rdf:resource="http://w3id.org/protys/ontology/alignment#var_ghg"/>
                            <swrl:argument1 rdf:resource="http://w3id.org/protys/ontology/alignment#var_op"/>
                            <swrl:propertyPredicate rdf:resource="http://w3id.org/protys/ontology/iso14040#hasGHGImpactKgCO2e"/>
                          </swrl:DatavaluedPropertyAtom>
                        </rdf:first>
                      </rdf:List>
                    </rdf:rest>
                    <rdf:first>
                      <swrl:IndividualPropertyAtom>
                        <swrl:argument2 rdf:resource="http://w3id.org/protys/ontology/alignment#var_process"/>
                        <swrl:argument1 rdf:resource="http://w3id.org/protys/ontology/alignment#var_lot"/>
                        <swrl:propertyPredicate rdf:resource="http://w3id.org/protys/ontology/iso15531#hasProcess"/>
                      </swrl:IndividualPropertyAtom>
                    </rdf:first>
                  </rdf:List>
                </rdf:rest>
                <rdf:first>
                  <swrl:IndividualPropertyAtom>
                    <swrl:argument2 rdf:resource="http://w3id.org/protys/ontology/alignment#var_process"/>
                    <swrl:argument1 rdf:resource="http://w3id.org/protys/ontology/alignment#var_op"/>
                    <swrl:propertyPredicate rdf:resource="http://w3id.org/protys/ontology/iso15531#partOfProcess"/>
                  </swrl:IndividualPropertyAtom>
                </rdf:first>
              </rdf:List>
            </rdf:rest>
            <rdf:first>
              <swrl:IndividualPropertyAtom>
                <swrl:argument2 rdf:resource="http://w3id.org/protys/ontology/alignment#var_op"/>
                <swrl:argument1 rdf:resource="http://w3id.org/protys/ontology/alignment#var_lot"/>
                <swrl:propertyPredicate rdf:resource="http://w3id.org/protys/ontology/iso15531#hasActivity"/>
              </swrl:IndividualPropertyAtom>
            </rdf:first>
          </rdf:List>
        </rdf:rest>
        <rdf:first>
          <swrl:ClassAtom>
            <swrl:argument1 rdf:resource="http://w3id.org/protys/ontology/alignment#var_lot"/>
            <swrl:classPredicate rdf:resource="http://w3id.org/protys/ontology/iso15531#Lot"/>
          </swrl:ClassAtom>
        </rdf:first>
      </rdf:List>
    </swrl:body>
    <rdfs:label>R21: Contribución eléctrica identificable por operación del lote</rdfs:label>
  </swrl:Imp>
  <swrl:Imp rdf:about="http://w3id.org/protys/ontology/alignment#R20">
    <swrl:head>
      <rdf:List>
        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        <rdf:first>
          <swrl:IndividualPropertyAtom>
            <swrl:argument2 rdf:resource="http://w3id.org/protys/ontology/alignment#var_op"/>
            <swrl:argument1 rdf:resource="http://w3id.org/protys/ontology/alignment#var_flow"/>
            <swrl:propertyPredicate rdf:resource="http://w3id.org/protys/ontology/core#bridgesFlowToActivity"/>
          </swrl:IndividualPropertyAtom>
        </rdf:first>
      </rdf:List>
    </swrl:head>
    <swrl:body>
      <rdf:List>
        <rdf:rest>
          <rdf:List>
            <rdf:rest>
              <rdf:List>
                <rdf:rest>
                  <rdf:List>
                    <rdf:rest>
                      <rdf:List>
                        <rdf:rest>
                          <rdf:List>
                            <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            <rdf:first>
                              <swrl:IndividualPropertyAtom>
                                <swrl:argument2 rdf:resource="http://w3id.org/protys/ontology/alignment#var_process"/>
                                <swrl:argument1 rdf:resource="http://w3id.org/protys/ontology/alignment#var_flow"/>
                                <swrl:propertyPredicate rdf:resource="http://w3id.org/protys/ontology/research#belongsToProcess"/>
                              </swrl:IndividualPropertyAtom>
                            </rdf:first>
                          </rdf:List>
                        </rdf:rest>
                        <rdf:first>
                          <swrl:IndividualPropertyAtom>
                            <swrl:argument2 rdf:resource="http://w3id.org/protys/ontology/alignment#var_material"/>
                            <swrl:argument1 rdf:resource="http://w3id.org/protys/ontology/alignment#var_flow"/>
                            <swrl:propertyPredicate rdf:resource="http://w3id.org/protys/ontology/iso14040#refersToMaterial"/>
                          </swrl:IndividualPropertyAtom>
                        </rdf:first>
                      </rdf:List>
                    </rdf:rest>
                    <rdf:first>
                      <swrl:ClassAtom>
                        <swrl:argument1 rdf:resource="http://w3id.org/protys/ontology/alignment#var_flow"/>
                        <swrl:classPredicate rdf:resource="http://w3id.org/protys/ontology/iso14040#ElementaryFlow"/>
                      </swrl:ClassAtom>
                    </rdf:first>
                  </rdf:List>
                </rdf:rest>
                <rdf:first>
                  <swrl:IndividualPropertyAtom>
                    <swrl:argument2 rdf:resource="http://w3id.org/protys/ontology/alignment#var_process"/>
                    <swrl:argument1 rdf:resource="http://w3id.org/protys/ontology/alignment#var_op"/>
                    <swrl:propertyPredicate rdf:resource="http://w3id.org/protys/ontology/iso15531#partOfProcess"/>
                  </swrl:IndividualPropertyAtom>
                </rdf:first>
              </rdf:List>
            </rdf:rest>
            <rdf:first>
              <swrl:IndividualPropertyAtom>
                <swrl:argument2 rdf:resource="http://w3id.org/protys/ontology/alignment#var_material"/>
                <swrl:argument1 rdf:resource="http://w3id.org/protys/ontology/alignment#var_op"/>
                <swrl:propertyPredicate rdf:resource="http://w3id.org/protys/ontology/iso15531#consumesMaterial"/>
              </swrl:IndividualPropertyAtom>
            </rdf:first>
          </rdf:List>
        </rdf:rest>
        <rdf:first>
          <swrl:ClassAtom>
            <swrl:argument1 rdf:resource="http://w3id.org/protys/ontology/alignment#var_op"/>
            <swrl:classPredicate rdf:resource="http://w3id.org/protys/ontology/iso15531#ProcessOperation"/>
          </swrl:ClassAtom>
        </rdf:first>
      </rdf:List>
    </swrl:body>
    <rdfs:label>R20: Puente flujo y operación de consumo del mismo proceso</rdfs:label>
  </swrl:Imp>
  <a:SPARQLValidationPattern rdf:about="http://w3id.org/protys/ontology/alignment#R26_ValidationPattern">
    <rdfs:comment xml:lang="es">Detectar riesgo de contaminación cruzada / mapeos puente faltantes cuando no existe operación de limpieza entre campañas incompatibles. Nota: en el Anexo C este patrón aparece bajo el encabezado de R24; reconciliar la numeración R24/R26 en el Anexo C. Reformulada como consulta SPARQL ASK con FILTER NOT EXISTS (el built-in swrlb:notBound no existe en SWRL); no es una regla de inferencia. Consulta completa en ontologies/alignment-queries.sparql (R26).</rdfs:comment>
    <rdfs:label>R26: patrón de validación SPARQL ASK</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </a:SPARQLValidationPattern>
</rdf:RDF>
