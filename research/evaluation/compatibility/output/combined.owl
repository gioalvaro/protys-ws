      <rdf:List>
        <rdf:rest>
          <rdf:List>
            <rdf:rest>
              <rdf:List>
                <rdf:rest>
                  <rdf:List>
                    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                    <rdf:first>
                      <swrl:IndividualPropertyAtom>
                        <swrl:argument2 rdf:resource="http://w3id.org/protys/ontology/alignment#var_op"/>
                        <swrl:argument1 rdf:resource="http://w3id.org/protys/ontology/alignment#var_order"/>
                        <swrl:propertyPredicate rdf:resource="http://w3id.org/protys/ontology/iso15531#executesActivity"/>
                      </swrl:IndividualPropertyAtom>
                    </rdf:first>
                  </rdf:List>
                </rdf:rest>
                <rdf:first>
                  <swrl:ClassAtom>
                    <swrl:argument1 rdf:resource="http://w3id.org/protys/ontology/alignment#var_operator"/>
                    <swrl:classPredicate rdf:resource="http://w3id.org/protys/ontology/iso15531#HumanResource"/>
                  </swrl:ClassAtom>
                </rdf:first>
              </rdf:List>
            </rdf:rest>
            <rdf:first>
              <swrl:IndividualPropertyAtom>
                <swrl:argument2 rdf:resource="http://w3id.org/protys/ontology/alignment#var_operator"/>
                <swrl:argument1 rdf:resource="http://w3id.org/protys/ontology/alignment#var_order"/>
                <swrl:propertyPredicate rdf:resource="http://w3id.org/protys/ontology/iso15531#executedBy"/>
              </swrl:IndividualPropertyAtom>
            </rdf:first>
          </rdf:List>
        </rdf:rest>
        <rdf:first>
          <swrl:ClassAtom>
            <swrl:argument1 rdf:resource="http://w3id.org/protys/ontology/alignment#var_order"/>
