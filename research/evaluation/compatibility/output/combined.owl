                    <swrl:argument2 rdf:resource="http://w3id.org/protys/ontology/alignment#var_indicator"/>
                    <swrl:argument1 rdf:resource="http://w3id.org/protys/ontology/alignment#var_process"/>
                    <swrl:propertyPredicate rdf:resource="http://w3id.org/protys/ontology/iso14040#hasImpact"/>
                  </swrl:IndividualPropertyAtom>
                </rdf:first>
              </rdf:List>
            </rdf:rest>
            <rdf:first>
              <swrl:IndividualPropertyAtom>
                <swrl:argument2 rdf:resource="http://w3id.org/protys/ontology/alignment#var_process"/>
                <swrl:argument1 rdf:resource="http://w3id.org/protys/ontology/alignment#var_lot"/>
                <swrl:propertyPredicate rdf:resource="http://w3id.org/protys/ontology/iso15531#hasProcess"/>
              </swrl:IndividualPropertyAtom>
            </rdf:first>
          </rdf:List>
        </rdf:rest>
        <rdf:first>
          <swrl:ClassAtom>
            <swrl:argument1 rdf:resource="http://w3id.org/protys/ontology/alignment#var_lot"/>
            <swrl:classPredicate rdf:resource="http://w3id.org/protys/ontology/iso15531#Lot"/>
          </swrl:ClassAtom>
        </rdf:first>
      </rdf:List>
    </swrl:body>
    <rdfs:label>R05: Vincular al lote los indicadores de sus procesos, sin sumar</rdfs:label>
  </swrl:Imp>
  <swrl:Variable rdf:about="http://w3id.org/protys/ontology/alignment#var_v"/>
  <swrl:Variable rdf:about="http://w3id.org/protys/ontology/alignment#var_pp"/>
  <owl:AllDisjointClasses>
    <owl:members rdf:parseType="Collection">
