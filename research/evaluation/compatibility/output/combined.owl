  <swrl:Imp rdf:about="http://w3id.org/protys/ontology/alignment#R04">
    <swrl:head>
      <rdf:List>
        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        <rdf:first>
          <swrl:ClassAtom>
            <swrl:argument1 rdf:resource="http://w3id.org/protys/ontology/alignment#var_indicator"/>
            <swrl:classPredicate rdf:resource="http://w3id.org/protys/ontology/core#HighImpactIndicator"/>
          </swrl:ClassAtom>
        </rdf:first>
      </rdf:List>
    </swrl:head>
    <swrl:body>
      <rdf:List>
        <rdf:rest>
          <rdf:List>
            <rdf:rest>
              <rdf:List>
                <rdf:rest>
                  <rdf:List>
                    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                    <rdf:first>
                      <swrl:BuiltinAtom>
                        <swrl:arguments>
                          <rdf:List>
                            <rdf:rest>
                              <rdf:List>
                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                <rdf:first>
                                  <swrl:Variable rdf:about="http://w3id.org/protys/ontology/alignment#var_threshold"/>
                                </rdf:first>
                              </rdf:List>
                            </rdf:rest>
                            <rdf:first rdf:resource="http://w3id.org/protys/ontology/alignment#var_value"/>
                          </rdf:List>
                        </swrl:arguments>
                        <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#greaterThan"/>
                      </swrl:BuiltinAtom>
                    </rdf:first>
                  </rdf:List>
                </rdf:rest>
                <rdf:first>
                  <swrl:DatavaluedPropertyAtom>
                    <swrl:argument2 rdf:resource="http://w3id.org/protys/ontology/alignment#var_threshold"/>
                    <swrl:argument1>
                      <owl:NamedIndividual rdf:about="http://w3id.org/protys/ontology/alignment#GlobalConfig">
                        <a:impactThreshold rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal"
                        >5</a:impactThreshold>
                        <rdfs:comment xml:lang="es">Individuo de configuración global; porta align:impactThreshold para la regla R04.</rdfs:comment>
                      </owl:NamedIndividual>
                    </swrl:argument1>
                    <swrl:propertyPredicate rdf:resource="http://w3id.org/protys/ontology/alignment#impactThreshold"/>
                  </swrl:DatavaluedPropertyAtom>
                </rdf:first>
              </rdf:List>
            </rdf:rest>
            <rdf:first>
              <swrl:DatavaluedPropertyAtom>
                <swrl:argument2 rdf:resource="http://w3id.org/protys/ontology/alignment#var_value"/>
                <swrl:argument1 rdf:resource="http://w3id.org/protys/ontology/alignment#var_indicator"/>
                <swrl:propertyPredicate rdf:resource="http://w3id.org/protys/ontology/iso14040#hasIndicatorValue"/>
              </swrl:DatavaluedPropertyAtom>
            </rdf:first>
          </rdf:List>
        </rdf:rest>
        <rdf:first>
          <swrl:ClassAtom>
            <swrl:argument1 rdf:resource="http://w3id.org/protys/ontology/alignment#var_indicator"/>
            <swrl:classPredicate rdf:resource="http://w3id.org/protys/ontology/iso14040#ImpactIndicator"/>
          </swrl:ClassAtom>
        </rdf:first>
      </rdf:List>
    </swrl:body>
    <rdfs:label>R04: Indicador de alto impacto por umbral del escenario</rdfs:label>
  </swrl:Imp>
  <swrl:Variable rdf:about="http://w3id.org/protys/ontology/alignment#var_eff"/>
  <swrl:Variable rdf:about="http://w3id.org/protys/ontology/alignment#var_qs"/>
