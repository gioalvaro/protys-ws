          <swrl:IndividualPropertyAtom>
            <swrl:argument2 rdf:resource="http://w3id.org/protys/ontology/alignment#var_flow"/>
            <swrl:argument1 rdf:resource="http://w3id.org/protys/ontology/alignment#var_lot"/>
            <swrl:propertyPredicate rdf:resource="http://w3id.org/protys/ontology/alignment#hasEmittedFlow"/>
          </swrl:IndividualPropertyAtom>
        </rdf:first>
      </rdf:List>
    </swrl:head>
    <swrl:body>
      <rdf:List>
        <rdf:rest>
          <rdf:List>
            <rdf:rest>
              <rdf:List>
                <rdf:rest>
                  <rdf:List>
                    <rdf:rest>
                      <rdf:List>
                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                        <rdf:first>
                          <swrl:IndividualPropertyAtom>
                            <swrl:argument2 rdf:resource="http://w3id.org/protys/ontology/alignment#var_flow"/>
                            <swrl:argument1 rdf:resource="http://w3id.org/protys/ontology/alignment#var_process"/>
                            <swrl:propertyPredicate rdf:resource="http://w3id.org/protys/ontology/iso14040#emits"/>
                          </swrl:IndividualPropertyAtom>
                        </rdf:first>
                      </rdf:List>
                    </rdf:rest>
                    <rdf:first>
                      <swrl:ClassAtom>
                        <swrl:argument1 rdf:resource="http://w3id.org/protys/ontology/alignment#var_process"/>
                        <swrl:classPredicate rdf:resource="http://w3id.org/protys/ontology/iso14040#UnitProcess"/>
                      </swrl:ClassAtom>
                    </rdf:first>
                  </rdf:List>
                </rdf:rest>
                <rdf:first>
                  <swrl:IndividualPropertyAtom>
                    <swrl:argument2 rdf:resource="http://w3id.org/protys/ontology/alignment#var_process"/>
                    <swrl:argument1 rdf:resource="http://w3id.org/protys/ontology/alignment#var_lot"/>
                    <swrl:propertyPredicate rdf:resource="http://w3id.org/protys/ontology/iso15531#hasProcess"/>
                  </swrl:IndividualPropertyAtom>
                </rdf:first>
              </rdf:List>
            </rdf:rest>
            <rdf:first>
              <swrl:IndividualPropertyAtom>
                <swrl:argument2 rdf:resource="http://w3id.org/protys/ontology/alignment#var_lot"/>
                <swrl:argument1 rdf:resource="http://w3id.org/protys/ontology/alignment#var_order"/>
                <swrl:propertyPredicate rdf:resource="http://w3id.org/protys/ontology/iso15531#producesLot"/>
              </swrl:IndividualPropertyAtom>
            </rdf:first>
          </rdf:List>
        </rdf:rest>
        <rdf:first>
          <swrl:ClassAtom>
            <swrl:argument1 rdf:resource="http://w3id.org/protys/ontology/alignment#var_lot"/>
            <swrl:classPredicate rdf:resource="http://w3id.org/protys/ontology/iso15531#Lot"/>
          </swrl:ClassAtom>
        </rdf:first>
      </rdf:List>
    </swrl:body>
    <rdfs:label>R03: Vincular flujo emitido al lote del mismo proceso LCA</rdfs:label>
  </swrl:Imp>
  <swrl:Variable rdf:about="http://w3id.org/protys/ontology/alignment#var_t"/>
  <swrl:Imp rdf:about="http://w3id.org/protys/ontology/alignment#R14">
    <swrl:head>
      <rdf:List>
        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
