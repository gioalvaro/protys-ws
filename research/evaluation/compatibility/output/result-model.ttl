        rdfs:domain   iso15531:ProcessPlan , iso14040:LifeCycleInventory;
        rdfs:label    "includesActivity";
        rdfs:range    iso15531:ProcessOperation , iso14040:AllocationProcedure .

alignment:var_value  rdf:type  swrl:Variable .

research:materialFactorKgCO2ePerKg
        rdf:type    owl:DatatypeProperty;
