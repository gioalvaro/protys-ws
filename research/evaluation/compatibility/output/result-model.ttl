        rdfs:domain   <http://w3id.org/protys/ontology/resource#Activity>;
        rdfs:label    "consumesResource";
        rdfs:range    <http://w3id.org/protys/ontology/core#Resource> .

[ rdf:type    swrl:Imp;
  rdfs:label  "R10: Registrar estado propagable del mismo lote";
  swrl:body   [ rdf:type   swrl:AtomList;
                rdf:first  [ rdf:type             swrl:ClassAtom;
                             swrl:argument1       alignment:var_lot;
                             swrl:classPredicate  iso15531:Lot
                           ];
                rdf:rest   [ rdf:type   swrl:AtomList;
                             rdf:first  [ rdf:type                swrl:DatavaluedPropertyAtom;
                                          swrl:argument1          alignment:var_lot;
                                          swrl:argument2          alignment:var_status;
                                          swrl:propertyPredicate  iso15531:hasQualityStatus
                                        ];
                             rdf:rest   ()
                           ]
              ];
  swrl:head   [ rdf:type   swrl:AtomList;
                rdf:first  [ rdf:type                swrl:DatavaluedPropertyAtom;
                             swrl:argument1          alignment:var_lot;
                             swrl:argument2          alignment:var_status;
                             swrl:propertyPredicate  iso15531:propagatedQualityStatus
                           ];
                rdf:rest   ()
              ]
] .

alignment:var_nonconformity
        rdf:type  swrl:Variable .

<http://w3id.org/protys/ontology/resource#Role>
        rdf:type      owl:Class;
        rdfs:comment  "Rol que determina las capacidades específicas de una Person y sus permisos de acceso a las actividades del sistema (Fig. 3.11)."@es;
        rdfs:label    "Role"@en .

alignment:var_f2  rdf:type  swrl:Variable .

research:hasFormulation
        rdf:type  owl:ObjectProperty .

alignment:var_threshold
        rdf:type  swrl:Variable .

alignment:var_op  rdf:type  swrl:Variable .

<http://w3id.org/protys/ontology/paint-ext#Manufacturing_Stage>
        rdf:type         owl:Class;
        rdfs:comment     "Etapa de fabricación (dispersión, molienda, mezcla...). Subclase de process:Process_Activity: paso u operación dentro del proceso (§3.3.2)."@es;
        rdfs:label       "Manufacturing_Stage"@en;
        rdfs:subClassOf  <http://w3id.org/protys/ontology/process#Process_Activity> .

iso15531:hasActivity  rdf:type  owl:ObjectProperty;
        rdfs:comment  "Trazabilidad lote a actividades/operaciones (regla R21, Anexo C)."@es;
        rdfs:domain   iso15531:Lot;
        rdfs:label    "hasActivity";
        rdfs:range    iso15531:ProcessOperation , iso14040:AllocationProcedure .

<http://w3id.org/protys/ontology/resource#Raw_Material>
        rdf:type         owl:Class;
        rdfs:comment     "Materia prima de entrada a las actividades productivas (Fig. 3.10)."@es;
        rdfs:label       "Raw_Material"@en;
        rdfs:subClassOf  <http://w3id.org/protys/ontology/resource#Material> , <http://w3id.org/protys/ontology/core#Resource> .

<http://w3id.org/protys/ontology/product#Thing>
        rdf:type      owl:Class;
        rdfs:comment  "Generalización de Production_Item: distintos estándares (ISO 10303, ISO 15531, ISO 15926) describen Product como una cosa producida por procesos naturales o artificiales."@es;
        rdfs:label    "Thing"@en .

<http://w3id.org/protys/ontology/paint-ext#hasSkill>
        rdf:type            owl:ObjectProperty;
        rdfs:comment        "Habilidad de un recurso humano, modelada como capacidad de manufactura. Subpropiedad de iso15531:hasCapability."@es;
        rdfs:domain         iso15531:ManufacturingResource;
        rdfs:label          "hasSkill";
        rdfs:range          iso15531:ManufacturingCapability;
        rdfs:subPropertyOf  iso15531:hasCapability .

<http://w3id.org/protys/ontology/core#involve>
        rdf:type      owl:ObjectProperty;
        rdfs:comment  "Una Enterprise involucra (planifica y ejecuta) procesos productivos (Fig. 3.6; ISO 15531, ISO 18629 vinculan Process con Enterprise)."@es;
        rdfs:domain   <http://w3id.org/protys/ontology/core#Enterprise>;
        rdfs:label    "involve";
        rdfs:range    <http://w3id.org/protys/ontology/core#Process> .

alignment:var_time  rdf:type  swrl:Variable .

alignment:var_process
        rdf:type  swrl:Variable .

<http://w3id.org/protys/ontology/paint-ext#outputQuantity>
        rdf:type    owl:DatatypeProperty;
        rdfs:label  "outputQuantity";
        rdfs:range  xsd:decimal .

<http://w3id.org/protys/ontology/paint-ext#MaterialFlow>
        rdf:type         owl:Class;
        rdfs:comment     "Flujo de materiales a través de los procesos. Subclase de iso15531:ManufacturingFlow."@es;
        rdfs:label       "MaterialFlow"@en;
        rdfs:subClassOf  iso15531:ManufacturingFlow .

[ rdf:type    swrl:Imp;
  rdfs:label  "R25: Marcar factor modificado que requiere recálculo";
  swrl:body   [ rdf:type   swrl:AtomList;
                rdf:first  [ rdf:type             swrl:ClassAtom;
                             swrl:argument1       alignment:var_factor;
                             swrl:classPredicate  iso14040:CharacterizationFactor
                           ];
                rdf:rest   [ rdf:type   swrl:AtomList;
                             rdf:first  [ rdf:type                swrl:DatavaluedPropertyAtom;
                                          swrl:argument1          alignment:var_factor;
                                          swrl:argument2          alignment:var_version;
                                          swrl:propertyPredicate  <http://w3id.org/protys/ontology/core#hasVersion>
                                        ];
                             rdf:rest   [ rdf:type   swrl:AtomList;
                                          rdf:first  [ rdf:type                swrl:DatavaluedPropertyAtom;
                                                       swrl:argument1          alignment:var_factor;
                                                       swrl:argument2          alignment:var_version;
                                                       swrl:propertyPredicate  <http://w3id.org/protys/ontology/core#modifiedInVersion>
                                                     ];
                                          rdf:rest   ()
                                        ]
                           ]
              ];
  swrl:head   [ rdf:type   swrl:AtomList;
                rdf:first  [ rdf:type             swrl:ClassAtom;
                             swrl:argument1       alignment:var_factor;
                             swrl:classPredicate  <http://w3id.org/protys/ontology/core#RequiresRecomputeIndicators>
                           ];
                rdf:rest   ()
              ]
] .

iso15531:hasInput  rdf:type  owl:ObjectProperty;
        rdfs:comment  "Entrada material de una actividad (patrón de validación R16, alignment-queries.sparql)."@es;
        rdfs:domain   iso15531:ProcessOperation , iso14040:AllocationProcedure;
        rdfs:label    "hasInput";
        rdfs:range    iso15531:ManufacturingResource .

alignment:var_order  rdf:type  swrl:Variable .

<http://w3id.org/protys/ontology/paint-ext#Chemical_Compound>
        rdf:type         owl:Class;
        rdfs:comment     "Compuesto químico (resinas, aditivos, biocidas). Subclase de product:Substance: los estándares describen las sustancias como generalización de los ítems de producción (Fig. 3.8)."@es;
        rdfs:label       "Chemical_Compound"@en;
        rdfs:subClassOf  <http://w3id.org/protys/ontology/product#Thing> , <http://w3id.org/protys/ontology/product#Substance> .

<http://w3id.org/protys/ontology/enterprise#locatedAt>
        rdf:type      owl:ObjectProperty;
        rdfs:comment  "Relaciona Enterprise (y sus instalaciones) con Location para especificar la ubicación geográfica."@es;
        rdfs:label    "locatedAt";
        rdfs:range    <http://w3id.org/protys/ontology/enterprise#Location> .

<http://w3id.org/protys/ontology/enterprise#Factory>
        rdf:type         owl:Class;
        rdfs:comment     "Instalación completa que alberga múltiples áreas de producción (shops) y cuenta con la infraestructura necesaria para la manufactura integral de productos."@es;
        rdfs:label       "Factory"@en;
        rdfs:subClassOf  [ rdf:type            owl:Restriction;
                           owl:onProperty      <http://w3id.org/protys/ontology/enterprise#isPartOf>;
                           owl:someValuesFrom  <http://w3id.org/protys/ontology/core#Enterprise>
                         ] .

[ rdf:type    swrl:Imp;
  rdfs:label  "R03: Vincular flujo emitido al lote del mismo proceso LCA";
  swrl:body   [ rdf:type   swrl:AtomList;
                rdf:first  [ rdf:type             swrl:ClassAtom;
                             swrl:argument1       alignment:var_lot;
                             swrl:classPredicate  iso15531:Lot
                           ];
                rdf:rest   [ rdf:type   swrl:AtomList;
                             rdf:first  [ rdf:type                swrl:IndividualPropertyAtom;
                                          swrl:argument1          alignment:var_order;
                                          swrl:argument2          alignment:var_lot;
                                          swrl:propertyPredicate  iso15531:producesLot
                                        ];
                             rdf:rest   [ rdf:type   swrl:AtomList;
                                          rdf:first  [ rdf:type                swrl:IndividualPropertyAtom;
                                                       swrl:argument1          alignment:var_lot;
                                                       swrl:argument2          alignment:var_process;
                                                       swrl:propertyPredicate  iso15531:hasProcess
                                                     ];
                                          rdf:rest   [ rdf:type   swrl:AtomList;
                                                       rdf:first  [ rdf:type             swrl:ClassAtom;
                                                                    swrl:argument1       alignment:var_process;
                                                                    swrl:classPredicate  iso14040:UnitProcess
                                                                  ];
                                                       rdf:rest   [ rdf:type   swrl:AtomList;
                                                                    rdf:first  [ rdf:type                swrl:IndividualPropertyAtom;
                                                                                 swrl:argument1          alignment:var_process;
                                                                                 swrl:argument2          alignment:var_flow;
                                                                                 swrl:propertyPredicate  iso14040:emits
                                                                               ];
                                                                    rdf:rest   ()
                                                                  ]
                                                     ]
                                        ]
                           ]
              ];
  swrl:head   [ rdf:type   swrl:AtomList;
                rdf:first  [ rdf:type                swrl:IndividualPropertyAtom;
                             swrl:argument1          alignment:var_lot;
                             swrl:argument2          alignment:var_flow;
                             swrl:propertyPredicate  alignment:hasEmittedFlow
                           ];
                rdf:rest   ()
              ]
] .

iso15531:EquipmentResource
        rdf:type          owl:Class;
        rdfs:label        "Recurso de equipamiento"@es;
        rdfs:subClassOf   iso15531:ManufacturingResource;
        owl:disjointWith  iso15531:HumanResource .

