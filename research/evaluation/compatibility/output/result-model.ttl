        rdfs:label    "VOCContentGperLiter";
        rdfs:range    xsd:decimal .

alignment:var_efficiency
        rdf:type  swrl:Variable .

iso15531:timestamp  rdf:type  owl:DatatypeProperty;
        rdfs:comment  "Marca temporal de un evento MES (regla R13, Anexo C)."@es;
        rdfs:domain   iso15531:ManufacturingData;
        rdfs:label    "timestamp";
        rdfs:range    xsd:dateTime .

iso15531:requiresResource
        rdf:type      owl:ObjectProperty;
        rdfs:comment  "Una operación requiere un recurso de manufactura (regla R12, Listado 3.4)."@es;
        rdfs:domain   iso15531:ProcessOperation , iso14040:AllocationProcedure;
        rdfs:label    "requiresResource";
        rdfs:range    iso15531:ManufacturingResource .

<http://w3id.org/protys/ontology/resource#hasCapability>
        rdf:type      owl:ObjectProperty;
        rdfs:comment  "Un Resource se define por sus capacidades (ISO 10303-49)."@es;
        rdfs:domain   <http://w3id.org/protys/ontology/core#Resource>;
        rdfs:label    "hasCapability";
        rdfs:range    <http://w3id.org/protys/ontology/resource#Capability> .

<http://w3id.org/protys/ontology/enterprise#Shop>
        rdf:type         owl:Class;
        rdfs:comment     "Área o departamento de producción donde se coordinan múltiples células para completar una fase significativa del proceso manufacturero."@es;
        rdfs:label       "Shop"@en;
        rdfs:subClassOf  [ rdf:type            owl:Restriction;
                           owl:onProperty      <http://w3id.org/protys/ontology/enterprise#isPartOf>;
                           owl:someValuesFrom  <http://w3id.org/protys/ontology/enterprise#Factory>
                         ] .

<http://w3id.org/protys/ontology/enterprise#Location>
        rdf:type      owl:Class;
        rdfs:comment  "Ubicación geográfica de las instalaciones empresariales; una misma localización puede albergar múltiples entidades organizacionales (parques industriales o complejos compartidos)."@es;
        rdfs:label    "Location"@en .

<http://w3id.org/protys/ontology/resource#Tool>
        rdf:type         owl:Class;
        rdfs:comment     "Herramienta manual o consumible empleada en operaciones puntuales (p. ej., cepillos o raspadores). Especialización directa de Resource (Fig. 3.9; ISO 15531, ISO 18629)."@es;
        rdfs:label       "Tool"@en;
        rdfs:subClassOf  <http://w3id.org/protys/ontology/core#Resource> .

<http://w3id.org/protys/ontology/paint-ext#partOfOrganization>
        rdf:type            owl:ObjectProperty;
        rdfs:comment        "Una unidad organizacional es parte de otra. Subpropiedad de enterprise:isPartOf."@es;
        rdfs:label          "partOfOrganization";
        rdfs:subPropertyOf  <http://w3id.org/protys/ontology/enterprise#isPartOf> .

<http://w3id.org/protys/ontology/core#Product>
        rdf:type             owl:Class;
        rdfs:comment         "Cosa o sustancia producida por procesos naturales o artificiales (ISO 10303, ISO 15531, ISO 15926). Se refina en el Módulo de Producto (ProductMod)."@es;
        rdfs:label           "Producto"@es , "Product"@en;
        owl:equivalentClass  <http://w3id.org/protys/ontology/product#Product> , iso14040:ProductFlow .

[ rdf:type     owl:AllDisjointClasses;
  owl:members  ( <http://w3id.org/protys/ontology/resource#Device> <http://w3id.org/protys/ontology/resource#Equip> <http://w3id.org/protys/ontology/resource#Tool> )
] .

iso14040:indicatorValue
        rdf:type            owl:DatatypeProperty;
        rdfs:comment        "Valor numérico de un indicador de impacto (variante léxica usada por la regla R23 del Listado 3.4; equivalente a hasIndicatorValue)."@es;
        rdfs:domain         iso15531:QualityAttribute , iso14040:ImpactIndicator;
        rdfs:label          "indicatorValue";
        rdfs:range          xsd:decimal;
        rdfs:subPropertyOf  iso14040:hasIndicatorValue .

research:hasStageResource
        rdf:type  owl:ObjectProperty .

iso15531:hasMaintenance
        rdf:type      owl:ObjectProperty;
        rdfs:comment  "Un recurso tiene mantenimiento programado (regla R15, Anexo C)."@es;
        rdfs:domain   iso15531:ManufacturingResource;
        rdfs:label    "hasMaintenance" .

<http://w3id.org/protys/ontology/paint-ext#ProductionLine>
        rdf:type         owl:Class;
        rdfs:comment     "Línea de producción: agrupación de estaciones/equipos. Subclase de enterprise:Cell."@es;
        rdfs:label       "ProductionLine"@en;
        rdfs:subClassOf  <http://w3id.org/protys/ontology/enterprise#Cell>;
        rdfs:subClassOf  [ rdf:type            owl:Restriction;
                           owl:onProperty      <http://w3id.org/protys/ontology/enterprise#isPartOf>;
                           owl:someValuesFrom  <http://w3id.org/protys/ontology/enterprise#Shop>
                         ] .

iso15531:Lot  rdf:type  owl:Class;
        rdfs:label  "Lote"@es .

alignment:var_status  rdf:type  swrl:Variable .

alignment:var_kwh  rdf:type  swrl:Variable .

research:stageIndex  rdf:type  owl:DatatypeProperty;
        rdfs:range  xsd:integer .

<http://w3id.org/protys/ontology/product#Physical_Characteristics>
        rdf:type         owl:Class;
        rdfs:comment     "Características físicas del producto: propiedades tangibles como dimensiones, peso, forma, material o color."@es;
        rdfs:label       "Physical_Characteristics"@en;
        rdfs:subClassOf  <http://w3id.org/protys/ontology/product#Product_Information> .

iso15531:cycleTimeMinutes
        rdf:type      owl:DatatypeProperty;
        rdfs:comment  "Tiempo de ciclo en minutos (instancias del caso de estudio, Cap. 4)."@es;
        rdfs:label    "cycleTimeMinutes";
        rdfs:range    xsd:decimal .

alignment:var_version
        rdf:type  swrl:Variable .

<http://w3id.org/protys/ontology/paint-ext#yieldPercent>
        rdf:type    owl:DatatypeProperty;
        rdfs:label  "yieldPercent";
        rdfs:range  xsd:decimal .

alignment:var_water  rdf:type  swrl:Variable .

<http://w3id.org/protys/ontology/resource#usesResource>
        rdf:type      owl:ObjectProperty;
        rdfs:comment  "La actividad utiliza el recurso sin consumirlo (Fig. 3.11)."@es;
        rdfs:domain   <http://w3id.org/protys/ontology/resource#Activity>;
        rdfs:label    "usesResource";
        rdfs:range    <http://w3id.org/protys/ontology/core#Resource> .

[ rdf:type    swrl:Imp;
  rdfs:label  "R02: Presencia de inventario de agua del proceso";
  swrl:body   [ rdf:type   swrl:AtomList;
                rdf:first  [ rdf:type             swrl:ClassAtom;
                             swrl:argument1       alignment:var_op;
                             swrl:classPredicate  iso15531:ProcessOperation
                           ];
                rdf:rest   [ rdf:type   swrl:AtomList;
                             rdf:first  [ rdf:type                swrl:DatavaluedPropertyAtom;
                                          swrl:argument1          alignment:var_op;
                                          swrl:argument2          alignment:var_water;
                                          swrl:propertyPredicate  iso15531:consumesWaterL
                                        ];
                             rdf:rest   [ rdf:type   swrl:AtomList;
                                          rdf:first  [ rdf:type                swrl:IndividualPropertyAtom;
                                                       swrl:argument1          alignment:var_op;
                                                       swrl:argument2          alignment:var_process;
                                                       swrl:propertyPredicate  iso15531:partOfProcess
                                                     ];
                                          rdf:rest   ()
                                        ]
                           ]
              ];
  swrl:head   [ rdf:type   swrl:AtomList;
                rdf:first  [ rdf:type                swrl:IndividualPropertyAtom;
                             swrl:argument1          alignment:var_process;
                             swrl:argument2          <http://w3id.org/protys/ontology/core#WaterFlow>;
                             swrl:propertyPredicate  iso14040:hasInventoryFlow
                           ];
                rdf:rest   ()
              ]
] .

<http://w3id.org/protys/ontology/alignment>
        rdf:type         owl:Ontology;
        rdfs:comment     "Módulo del Nivel de Refinamiento que profundiza el concepto Resource del Nivel Principal (Cap. 3, §3.3.2, Figs. 3.9 a 3.12). Según ISO 10303-49 un Resource se define por sus comportamientos (Behaviour) y capacidades (Capability); integra Tool, Equip y Device (ISO 15531, ISO 18629), la especialización de Material (ISO 10303-232, ISO 10303-227, ISO 10303-1082), los recursos humanos (Person, Role) y los recursos digitales (File)."@es , "Módulo del Nivel de Refinamiento que profundiza el concepto Product del Nivel Principal (Cap. 3, §3.3.2, Fig. 3.8). Basado en ISO 10303-1, ISO 10303-41, ISO 10303-214 e ISO 10303-239. Production_Item es la abstracción que encapsula las propiedades esenciales de Product (Bruno, 2015) y se especializa en Product y Production_Component."@es , "Módulo del Nivel de Refinamiento que profundiza el concepto Process del Nivel Principal (Cap. 3, §3.3.2, Fig. 3.7). Categorías derivadas de ISO 8000, ISO 10303, ISO 13584, ISO 15531, ISO 15926 e ISO 18629. Los recursos requeridos por una Process_Activity (Process_Material) se definen en el Módulo de Recursos (Fig. 3.10) y se referencian sin redefinirse."@es , "Capa de Alineamiento de PROTYS(KB) (Cap. 3, §3.3.3.5-3.3.3.6): los siete axiomas owl:equivalentClass del Listado 3.3 y las 26 reglas de alineamiento R01-R26 (Anexo C) en el fragmento DL-safe de SWRL. R03, R12 y R23 siguen la redacción canónica del Listado 3.4. R07, R16, R19 y R26 están reformuladas como patrones de validación SPARQL ASK (ver ontologies/alignment-queries.sparql) porque requieren negación (FILTER NOT EXISTS), no expresable en SWRL."@es , "Nivel Principal de la red de ontologías PROTYS(KB) (Cap. 3, §3.3.1, Fig. 3.6).\nPor decisión arquitectónica contiene únicamente los cuatro conceptos fundamentales de la industria\nmanufacturera según Zhao et al. (1999), Lin y Harding (2007), Chungoora et al. (2013) y Usman et al. (2013):\nProcess, Product, Resource y Enterprise, junto con las relaciones producedBy, usedBy, isHeldBy e involve."@es , "Módulo del Nivel de Refinamiento que profundiza el concepto Enterprise del Nivel Principal (Cap. 3, §3.3.2, Fig. 3.13), según el modelo de manufactura jerárquico de cuatro niveles de Zhao et al. (1999): Station - Cell - Shop - Factory - Enterprise, más el concepto Location."@es , "Ontología derivada que encapsula las especializaciones del caso de estudio de fabricación de pinturas (Cap. 4, §4.4.1: \"las extensiones quedan encapsuladas como ontología derivada\"). Cada clase del caso se declara como subclase de las clases conceptuales de PROTYS(KB) (Cap. 3, §3.3.1-3.3.2), sin modificar los módulos base. Incluye además las propiedades de datos operativas del caso."@es , "Formalización OWL 2 DL del estándar ISO 15531 MANDATE (Industrial Manufacturing Management Data), Nivel de Estándares de PROTYS(KB). Corresponde al Listado 3.2 del Capítulo 3 (18 clases); validado con HermiT 1.4.3 y Pellet 2.4.0 sin contradicciones. Namespace canónico http://w3id.org/protys/ontology/iso15531#."@es , "Formalización OWL 2 DL del estándar ISO 14040 (Análisis de Ciclo de Vida), Nivel de Estándares de PROTYS(KB). Corresponde al Listado 3.1 del Capítulo 3 (15 clases); validado con HermiT 1.4.3 y Pellet 2.4.0 sin contradicciones. Namespace canónico http://w3id.org/protys/ontology/iso14040#."@es;
        rdfs:label       "PROTYS(KB) - Módulo ISO 14040 (Life Cycle Assessment)"@es , "PROTYS(KB) - Módulo de Proceso (ProcessMod)"@es , "PROTYS(KB) - Capa de Alineamiento"@es , "PROTYS(KB) - Módulo ISO 15531 (MANDATE)"@es , "PROTYS(KB) - Core Concepts Module"@en , "PROTYS(KB) - Extensión del caso de estudio (fabricación de pinturas)"@es , "PROTYS(KB) - Módulo de Recurso (ResourceMod)"@es , "PROTYS(KB) - Módulo de Producto (ProductMod)"@es , "PROTYS(KB) - Módulo Principal (CoreConcepts)"@es , "PROTYS(KB) - Módulo de Empresa (EnterpriseMod)"@es;
        owl:versionInfo  "1.0" , "2.0.0" , "2.0" .

<http://w3id.org/protys/ontology/resource#executedByResource>
        rdf:type      owl:ObjectProperty;
        rdfs:comment  "El recurso ejecuta directamente la actividad (Fig. 3.11)."@es;
        rdfs:domain   <http://w3id.org/protys/ontology/resource#Activity>;
        rdfs:label    "executedByResource";
        rdfs:range    <http://w3id.org/protys/ontology/core#Resource> .

<http://w3id.org/protys/fixture#order>
        rdf:type              iso15531:WorkOrder , owl:NamedIndividual;
        rdf:type              [ rdf:type            owl:Restriction;
                                owl:minCardinality  "1"^^xsd:nonNegativeInteger;
                                owl:onProperty      iso15531:executedBy
                              ];
        iso15531:producesLot  <http://w3id.org/protys/fixture#lot> .

iso14040:ElementaryFlow
        rdf:type             owl:Class;
        rdfs:label           "Flujo elemental"@es;
        rdfs:subClassOf      [ rdf:type            owl:Class;
                               owl:intersectionOf  ( iso15531:ManufacturingResource
                                                     [ rdf:type        owl:Restriction;
                                                       owl:hasValue    alignment:Consumed;
                                                       owl:onProperty  iso15531:resourceCurrentState
                                                     ]
                                                   )
                             ];
        owl:disjointWith     iso14040:ProductFlow;
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( iso15531:ManufacturingResource
                                                     [ rdf:type        owl:Restriction;
                                                       owl:hasValue    alignment:Consumed;
                                                       owl:onProperty  iso15531:resourceCurrentState
                                                     ]
                                                   )
                             ] .

research:belongsToProcess
        rdf:type  owl:ObjectProperty .

research:forOperation
        rdf:type  owl:ObjectProperty .

<http://w3id.org/protys/ontology/paint-ext#durationMinutes>
        rdf:type    owl:DatatypeProperty;
        rdfs:label  "durationMinutes";
        rdfs:range  xsd:decimal .

<http://w3id.org/protys/ontology/paint-ext#employedBy>
        rdf:type       owl:ObjectProperty;
        rdfs:comment   "Inversa de employs."@es;
        rdfs:label     "employedBy";
        owl:inverseOf  <http://w3id.org/protys/ontology/paint-ext#employs> .

iso15531:ManufacturingProcess
        rdf:type         owl:Class;
        rdfs:label       "Proceso de manufactura"@es;
        rdfs:subClassOf  iso14040:UnitProcess .

iso15531:CleaningOperation
        rdf:type         owl:Class;
        rdfs:comment     "Operación de limpieza entre campañas. Declarada en la capa de alineamiento para soportar el patrón de validación R26 sin alterar el conteo de 18 clases del módulo ISO 15531 (Listado 3.2)."@es;
        rdfs:label       "CleaningOperation";
        rdfs:subClassOf  iso15531:ProcessOperation , iso14040:AllocationProcedure .

iso15531:consumesWaterL
        rdf:type      owl:DatatypeProperty;
        rdfs:comment  "Consumo de agua de una actividad en litros (regla R02, Anexo C)."@es;
        rdfs:label    "consumesWaterL";
        rdfs:range    xsd:decimal .

iso14040:SystemBoundary
        rdf:type             owl:Class;
        rdfs:label           "Frontera del sistema"@es;
        rdfs:subClassOf      iso15531:ManufacturingFacility;
        owl:equivalentClass  iso15531:ManufacturingFacility .

alignment:var_operator
        rdf:type  swrl:Variable .

iso15531:processedOn  rdf:type  owl:ObjectProperty;
        rdfs:comment  "Un lote se procesa sobre un equipo (regla R17, Anexo C)."@es;
        rdfs:domain   iso15531:Lot;
        rdfs:label    "processedOn";
        rdfs:range    iso15531:ManufacturingResource , iso15531:EquipmentResource .

<http://w3id.org/protys/ontology/resource#Product_Material>
        rdf:type         owl:Class;
        rdfs:comment     "Material que forma parte del producto (Fig. 3.10)."@es;
        rdfs:label       "Product_Material"@en;
        rdfs:subClassOf  <http://w3id.org/protys/ontology/resource#Material> , <http://w3id.org/protys/ontology/core#Resource> .

iso15531:responsibleOperator
        rdf:type      owl:ObjectProperty;
        rdfs:comment  "Operador responsable de una actividad, para trazabilidad (cabeza de la regla R14, Anexo C)."@es;
        rdfs:domain   iso15531:ProcessOperation , iso14040:AllocationProcedure;
        rdfs:label    "responsibleOperator";
        rdfs:range    iso15531:ManufacturingResource , iso15531:HumanResource .

[ rdf:type    swrl:Imp;
  rdfs:label  "R08: Cantidad de unidad funcional del lote";
  swrl:body   [ rdf:type   swrl:AtomList;
                rdf:first  [ rdf:type             swrl:ClassAtom;
                             swrl:argument1       alignment:var_lot;
                             swrl:classPredicate  iso15531:Lot
                           ];
                rdf:rest   [ rdf:type   swrl:AtomList;
                             rdf:first  [ rdf:type                swrl:DatavaluedPropertyAtom;
                                          swrl:argument1          alignment:var_lot;
                                          swrl:argument2          alignment:var_unit;
                                          swrl:propertyPredicate  iso15531:functionalUnit
                                        ];
                             rdf:rest   [ rdf:type   swrl:AtomList;
                                          rdf:first  [ rdf:type                swrl:DatavaluedPropertyAtom;
                                                       swrl:argument1          alignment:var_lot;
                                                       swrl:argument2          alignment:var_qty;
                                                       swrl:propertyPredicate  iso15531:producesQuantity
                                                     ];
                                          rdf:rest   ()
                                        ]
                           ]
              ];
  swrl:head   [ rdf:type   swrl:AtomList;
                rdf:first  [ rdf:type                swrl:DatavaluedPropertyAtom;
                             swrl:argument1          alignment:var_lot;
                             swrl:argument2          alignment:var_qty;
                             swrl:propertyPredicate  iso14040:hasFunctionalUnitQuantity
                           ];
                rdf:rest   ()
              ]
] .

alignment:var_duration
        rdf:type  swrl:Variable .

<http://w3id.org/protys/ontology/resource#canBeConsultedBy>
        rdf:type      owl:ObjectProperty;
        rdfs:comment  "Una Activity puede ser consultada por un Role; establece los permisos de acceso a las actividades del sistema y a otras entidades relevantes (relación n:n, Fig. 3.11)."@es;
        rdfs:domain   <http://w3id.org/protys/ontology/resource#Activity>;
        rdfs:label    "canBeConsultedBy";
        rdfs:range    <http://w3id.org/protys/ontology/resource#Role> .

[ rdf:type    swrl:Imp;
  rdfs:label  "R21: Contribución eléctrica identificable por operación del lote";
  swrl:body   [ rdf:type   swrl:AtomList;
                rdf:first  [ rdf:type             swrl:ClassAtom;
                             swrl:argument1       alignment:var_lot;
                             swrl:classPredicate  iso15531:Lot
                           ];
                rdf:rest   [ rdf:type   swrl:AtomList;
                             rdf:first  [ rdf:type                swrl:IndividualPropertyAtom;
                                          swrl:argument1          alignment:var_lot;
                                          swrl:argument2          alignment:var_op;
                                          swrl:propertyPredicate  iso15531:hasActivity
                                        ];
                             rdf:rest   [ rdf:type   swrl:AtomList;
                                          rdf:first  [ rdf:type                swrl:IndividualPropertyAtom;
                                                       swrl:argument1          alignment:var_op;
                                                       swrl:argument2          alignment:var_process;
                                                       swrl:propertyPredicate  iso15531:partOfProcess
                                                     ];
                                          rdf:rest   [ rdf:type   swrl:AtomList;
                                                       rdf:first  [ rdf:type                swrl:IndividualPropertyAtom;
                                                                    swrl:argument1          alignment:var_lot;
                                                                    swrl:argument2          alignment:var_process;
                                                                    swrl:propertyPredicate  iso15531:hasProcess
                                                                  ];
                                                       rdf:rest   [ rdf:type   swrl:AtomList;
                                                                    rdf:first  [ rdf:type                swrl:DatavaluedPropertyAtom;
                                                                                 swrl:argument1          alignment:var_op;
                                                                                 swrl:argument2          alignment:var_ghg;
                                                                                 swrl:propertyPredicate  iso14040:hasGHGImpactKgCO2e
                                                                               ];
                                                                    rdf:rest   ()
                                                                  ]
                                                     ]
                                        ]
                           ]
              ];
  swrl:head   [ rdf:type   swrl:AtomList;
                rdf:first  [ rdf:type                swrl:IndividualPropertyAtom;
                             swrl:argument1          alignment:var_lot;
                             swrl:argument2          alignment:var_op;
                             swrl:propertyPredicate  research:hasGHGContribution
                           ];
                rdf:rest   ()
              ]
] .

iso14040:hasInventoryFlow
        rdf:type      owl:ObjectProperty;
        rdfs:comment  "Asocia un proceso con un flujo de inventario (regla R02, Anexo C)."@es;
        rdfs:label    "hasInventoryFlow";
        rdfs:range    iso15531:ManufacturingResource , iso14040:ElementaryFlow;
        rdfs:range    [ rdf:type        owl:Restriction;
                        owl:hasValue    alignment:Consumed;
                        owl:onProperty  iso15531:resourceCurrentState
                      ];
        rdfs:range    [ rdf:type            owl:Class;
                        owl:intersectionOf  ( iso15531:ManufacturingResource
                                              [ rdf:type        owl:Restriction;
                                                owl:hasValue    alignment:Consumed;
                                                owl:onProperty  iso15531:resourceCurrentState
                                              ]
                                            )
                      ] .

<http://w3id.org/protys/ontology/process#Process_Activity>
        rdf:type      owl:Class;
        rdfs:comment  "Paso u operación atómica dentro de un proceso."@es;
        rdfs:label    "Process_Activity"@en .

alignment:var_t2  rdf:type  swrl:Variable .

iso14040:factorUnit  rdf:type  owl:DatatypeProperty;
        rdfs:comment  "Unidad de un factor de emisión/caracterización."@es;
        rdfs:domain   iso14040:CharacterizationFactor;
        rdfs:label    "factorUnit";
        rdfs:range    xsd:string .

<http://w3id.org/protys/fixture#flow>
