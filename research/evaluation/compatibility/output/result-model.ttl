@prefix :          <http://w3id.org/protys/ontology/alignment#> .
@prefix alignment: <http://w3id.org/protys/ontology/alignment#> .
@prefix iso14040:  <http://w3id.org/protys/ontology/iso14040#> .
@prefix iso15531:  <http://w3id.org/protys/ontology/iso15531#> .
@prefix owl:       <http://www.w3.org/2002/07/owl#> .
@prefix rdf:       <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:      <http://www.w3.org/2000/01/rdf-schema#> .
@prefix research:  <http://w3id.org/protys/ontology/research#> .
@prefix swrl:      <http://www.w3.org/2003/11/swrl#> .
@prefix swrlb:     <http://www.w3.org/2003/11/swrlb#> .
@prefix xsd:       <http://www.w3.org/2001/XMLSchema#> .

<http://w3id.org/protys/ontology/paint-ext#throughput>
        rdf:type    owl:DatatypeProperty;
        rdfs:label  "throughput";
        rdfs:range  xsd:decimal .

iso15531:ManufacturingFacility
        rdf:type         owl:Class;
        rdfs:label       "Instalación de manufactura"@es;
        rdfs:subClassOf  iso14040:SystemBoundary .

[ rdf:type    swrl:Imp;
  rdfs:label  "R01: GHG de electricidad por operación";
  swrl:body   [ rdf:type   swrl:AtomList;
                rdf:first  [ rdf:type             swrl:ClassAtom;
                             swrl:argument1       alignment:var_op;
                             swrl:classPredicate  iso15531:ProcessOperation
                           ];
                rdf:rest   [ rdf:type   swrl:AtomList;
                             rdf:first  [ rdf:type                swrl:DatavaluedPropertyAtom;
                                          swrl:argument1          alignment:var_op;
                                          swrl:argument2          alignment:var_kwh;
                                          swrl:propertyPredicate  iso15531:consumesEnergyKWh
                                        ];
                             rdf:rest   [ rdf:type   swrl:AtomList;
                                          rdf:first  [ rdf:type                swrl:IndividualPropertyAtom;
                                                       swrl:argument1          alignment:var_op;
                                                       swrl:argument2          alignment:var_factor;
                                                       swrl:propertyPredicate  iso14040:hasEmissionFactor
                                                     ];
                                          rdf:rest   [ rdf:type   swrl:AtomList;
                                                       rdf:first  [ rdf:type                swrl:DatavaluedPropertyAtom;
                                                                    swrl:argument1          alignment:var_factor;
                                                                    swrl:argument2          alignment:var_f;
                                                                    swrl:propertyPredicate  iso14040:factorValue
                                                                  ];
                                                       rdf:rest   [ rdf:type   swrl:AtomList;
                                                                    rdf:first  [ rdf:type        swrl:BuiltinAtom;
                                                                                 swrl:arguments  [ rdf:type   rdf:List;
                                                                                                   rdf:first  alignment:var_kwh;
                                                                                                   rdf:rest   [ rdf:type   rdf:List;
                                                                                                                rdf:first  "0"^^xsd:decimal;
                                                                                                                rdf:rest   ()
                                                                                                              ]
                                                                                                 ];
                                                                                 swrl:builtin    swrlb:greaterThanOrEqual
                                                                               ];
                                                                    rdf:rest   [ rdf:type   swrl:AtomList;
                                                                                 rdf:first  [ rdf:type        swrl:BuiltinAtom;
                                                                                              swrl:arguments  [ rdf:type   rdf:List;
                                                                                                                rdf:first  alignment:var_f;
                                                                                                                rdf:rest   [ rdf:type   rdf:List;
                                                                                                                             rdf:first  "0"^^xsd:decimal;
                                                                                                                             rdf:rest   ()
                                                                                                                           ]
                                                                                                              ];
                                                                                              swrl:builtin    swrlb:greaterThanOrEqual
                                                                                            ];
                                                                                 rdf:rest   [ rdf:type   swrl:AtomList;
                                                                                              rdf:first  [ rdf:type        swrl:BuiltinAtom;
                                                                                                           swrl:arguments  ( alignment:var_ghg alignment:var_kwh alignment:var_f );
                                                                                                           swrl:builtin    swrlb:multiply
                                                                                                         ];
                                                                                              rdf:rest   ()
                                                                                            ]
                                                                               ]
                                                                  ]
                                                     ]
                                        ]
                           ]
              ];
  swrl:head   [ rdf:type   swrl:AtomList;
                rdf:first  [ rdf:type                swrl:DatavaluedPropertyAtom;
                             swrl:argument1          alignment:var_op;
                             swrl:argument2          alignment:var_ghg;
                             swrl:propertyPredicate  iso14040:hasGHGImpactKgCO2e
                           ];
                rdf:rest   ()
              ]
] .

<http://w3id.org/protys/ontology/paint-ext#Department>
        rdf:type         owl:Class;
        rdfs:comment     "Departamento funcional. Subclase de enterprise:Shop."@es;
        rdfs:label       "Department"@en;
        rdfs:subClassOf  <http://w3id.org/protys/ontology/enterprise#Shop>;
        rdfs:subClassOf  [ rdf:type            owl:Restriction;
                           owl:onProperty      <http://w3id.org/protys/ontology/enterprise#isPartOf>;
                           owl:someValuesFrom  <http://w3id.org/protys/ontology/enterprise#Factory>
                         ] .

[ rdf:type    swrl:Imp;
  rdfs:label  "R04: Indicador de alto impacto por umbral del escenario";
  swrl:body   [ rdf:type   swrl:AtomList;
                rdf:first  [ rdf:type             swrl:ClassAtom;
                             swrl:argument1       alignment:var_indicator;
                             swrl:classPredicate  iso14040:ImpactIndicator
                           ];
                rdf:rest   [ rdf:type   swrl:AtomList;
                             rdf:first  [ rdf:type                swrl:DatavaluedPropertyAtom;
                                          swrl:argument1          alignment:var_indicator;
                                          swrl:argument2          alignment:var_value;
                                          swrl:propertyPredicate  iso14040:hasIndicatorValue
                                        ];
                             rdf:rest   [ rdf:type   swrl:AtomList;
                                          rdf:first  [ rdf:type                swrl:DatavaluedPropertyAtom;
                                                       swrl:argument1          alignment:GlobalConfig;
                                                       swrl:argument2          alignment:var_threshold;
                                                       swrl:propertyPredicate  alignment:impactThreshold
                                                     ];
                                          rdf:rest   [ rdf:type   swrl:AtomList;
                                                       rdf:first  [ rdf:type        swrl:BuiltinAtom;
                                                                    swrl:arguments  ( alignment:var_value alignment:var_threshold );
                                                                    swrl:builtin    swrlb:greaterThan
                                                                  ];
                                                       rdf:rest   ()
                                                     ]
                                        ]
                           ]
              ];
  swrl:head   [ rdf:type   swrl:AtomList;
                rdf:first  [ rdf:type             swrl:ClassAtom;
                             swrl:argument1       alignment:var_indicator;
                             swrl:classPredicate  <http://w3id.org/protys/ontology/core#HighImpactIndicator>
                           ];
                rdf:rest   ()
              ]
] .

[ rdf:type    swrl:Imp;
  rdfs:label  "R06: Asociar factor al flujo del material correspondiente";
  swrl:body   [ rdf:type   swrl:AtomList;
                rdf:first  [ rdf:type             swrl:ClassAtom;
                             swrl:argument1       alignment:var_flow;
                             swrl:classPredicate  iso14040:ElementaryFlow
                           ];
                rdf:rest   [ rdf:type   swrl:AtomList;
                             rdf:first  [ rdf:type                swrl:IndividualPropertyAtom;
                                          swrl:argument1          alignment:var_flow;
                                          swrl:argument2          alignment:var_material;
                                          swrl:propertyPredicate  iso14040:refersToMaterial
                                        ];
                             rdf:rest   [ rdf:type   swrl:AtomList;
                                          rdf:first  [ rdf:type                swrl:IndividualPropertyAtom;
                                                       swrl:argument1          alignment:var_material;
                                                       swrl:argument2          alignment:var_factor;
                                                       swrl:propertyPredicate  iso14040:hasCharacterizationFactor
                                                     ];
                                          rdf:rest   ()
                                        ]
                           ]
              ];
  swrl:head   [ rdf:type   swrl:AtomList;
                rdf:first  [ rdf:type                swrl:IndividualPropertyAtom;
                             swrl:argument1          alignment:var_flow;
                             swrl:argument2          alignment:var_factor;
                             swrl:propertyPredicate  iso14040:usesCharacterizationFactor
                           ];
                rdf:rest   ()
              ]
] .

<http://w3id.org/protys/ontology/paint-ext#Inspection>
        rdf:type         owl:Class;
        rdfs:comment     "Inspección de materiales/producto. Subclase de paint:QualityControl."@es;
        rdfs:label       "Inspection"@en;
        rdfs:subClassOf  <http://w3id.org/protys/ontology/process#Process_Activity> , <http://w3id.org/protys/ontology/paint-ext#QualityControl> , iso15531:Quality_Control_Activity .

iso15531:partOfProcess
        rdf:type      owl:ObjectProperty;
        rdfs:comment  "Una operación es parte de un proceso de manufactura (regla R02, Anexo C)."@es;
        rdfs:domain   iso15531:ProcessOperation , iso14040:AllocationProcedure;
        rdfs:label    "partOfProcess";
        rdfs:range    iso15531:ManufacturingProcess , iso14040:UnitProcess .

<http://w3id.org/protys/ontology/paint-ext#capacityTonsPerMonth>
        rdf:type    owl:DatatypeProperty;
        rdfs:label  "capacityTonsPerMonth";
        rdfs:range  xsd:decimal .

iso14040:emits  rdf:type  owl:ObjectProperty;
        rdfs:comment  "Un proceso unitario emite flujos elementales (usada por la regla R03, Listado 3.4)."@es;
        rdfs:domain   iso15531:ManufacturingProcess , iso14040:UnitProcess;
        rdfs:label    "emits";
        rdfs:range    iso15531:ManufacturingResource , iso14040:ElementaryFlow;
        rdfs:range    [ rdf:type        owl:Restriction;
                        owl:hasValue    alignment:Consumed;
                        owl:onProperty  iso15531:resourceCurrentState
                      ];
        rdfs:range    [ rdf:type            owl:Class;
                        owl:intersectionOf  ( iso15531:ManufacturingResource
                                              [ rdf:type        owl:Restriction;
                                                owl:hasValue    alignment:Consumed;
                                                owl:onProperty  iso15531:resourceCurrentState
                                              ]
                                            )
                      ] .

alignment:var_lot  rdf:type  swrl:Variable .

research:forLot  rdf:type  owl:ObjectProperty .

<http://w3id.org/protys/ontology/core#Process>
        rdf:type      owl:Class;
        rdfs:comment  "Procedimiento particular para hacer algo que involucra uno o más pasos u operaciones, y que puede producir un producto, una propiedad de un producto o un aspecto de un producto (ISO 10303-49). Se refina en el Módulo de Proceso (ProcessMod)."@es;
        rdfs:label    "Process"@en , "Proceso"@es .

iso15531:duration  rdf:type  owl:DatatypeProperty;
        rdfs:comment  "Duración de una actividad (regla R11, Anexo C)."@es;
        rdfs:label    "duration";
        rdfs:range    xsd:decimal .

alignment:var_t1  rdf:type  swrl:Variable .

<http://w3id.org/protys/ontology/core#hasPriorVersion>
        rdf:type      owl:DatatypeProperty;
        rdfs:comment  "Versión anterior de un término o entidad (soporta la CQ P5 de versionado, Anexo B Q21)."@es;
        rdfs:label    "hasPriorVersion";
        rdfs:range    xsd:string .

alignment:Consumed  rdf:type  iso15531:ResourceState , owl:NamedIndividual;
        rdfs:comment  "Estado 'consumido' de un recurso (axioma A3 del Listado 3.3)."@es .

iso15531:precedesEvent
        rdf:type      owl:ObjectProperty;
        rdfs:comment  "Secuencia temporal entre eventos MES (cabeza de la regla R13, Anexo C)."@es;
        rdfs:domain   iso15531:ManufacturingData;
        rdfs:label    "precedesEvent";
        rdfs:range    iso15531:ManufacturingData .

iso14040:ImpactCategory
        rdf:type    owl:Class;
        rdfs:label  "Categoría de impacto"@es .

iso15531:resourceCurrentState
        rdf:type      owl:ObjectProperty;
        rdfs:comment  "Estado actual de un recurso (usada por el axioma A3 del Listado 3.3: ElementaryFlow equivale a ManufacturingResource en estado Consumed)."@es;
        rdfs:domain   iso15531:ManufacturingResource;
        rdfs:label    "resourceCurrentState";
        rdfs:range    iso15531:ResourceState .

<http://w3id.org/protys/ontology/product#Product>
        rdf:type         owl:Class;
        rdfs:comment     "Especialización de Production_Item (ISO 10303-214, ISO 10303-239). Equivalente al concepto Product del Nivel Principal, que este módulo refina (IRI usado por el axioma A1 del Listado 3.3)."@es;
        rdfs:label       "Product"@en;
        rdfs:subClassOf  <http://w3id.org/protys/ontology/product#Production_Item> .

<http://w3id.org/protys/ontology/product#Substance>
        rdf:type         owl:Class;
        rdfs:comment     "Generalización de Production_Item: sustancia producida por procesos naturales o artificiales (Fig. 3.8)."@es;
        rdfs:label       "Substance"@en;
        rdfs:subClassOf  <http://w3id.org/protys/ontology/product#Thing> .

iso14040:CharacterizationFactor
        rdf:type    owl:Class;
        rdfs:label  "Factor de caracterización"@es .

<http://w3id.org/protys/ontology/core#CoverageGap>
        rdf:type      owl:Class;
        rdfs:comment  "Brecha de cobertura de mapeos puente (cabeza de R24)."@es;
        rdfs:label    "CoverageGap" .

research:availabilityPercent
        rdf:type    owl:DatatypeProperty;
        rdfs:range  xsd:decimal .

<http://w3id.org/protys/ontology/process#Process_Plant>
        rdf:type      owl:Class;
        rdfs:comment  "Instalación física donde ocurre la transformación; en ella se ejecuta el Process_Plan."@es;
        rdfs:label    "Process_Plant"@en .

<http://w3id.org/protys/ontology/paint-ext#hasWaterFootprint>
        rdf:type      owl:ObjectProperty;
        rdfs:comment  "Indicador de huella hídrica asociado a un producto."@es;
        rdfs:label    "hasWaterFootprint";
        rdfs:range    iso15531:QualityAttribute , iso14040:ImpactIndicator .

iso15531:hasNonConformity
        rdf:type      owl:ObjectProperty;
        rdfs:comment  "Un lote presenta una no conformidad de calidad (regla R18, Anexo C)."@es;
        rdfs:domain   iso15531:Lot;
        rdfs:label    "hasNonConformity";
        rdfs:range    iso15531:QualityAttribute , iso14040:ImpactIndicator .

iso15531:usesResource
        rdf:type      owl:ObjectProperty;
        rdfs:comment  "Una actividad usa un recurso (cabeza de la regla R09, Anexo C)."@es;
        rdfs:domain   iso15531:ProcessOperation , iso14040:AllocationProcedure;
        rdfs:label    "usesResource";
        rdfs:range    iso15531:ManufacturingResource .

<http://w3id.org/protys/ontology/paint-ext#QualityParameter>
        rdf:type         owl:Class;
        rdfs:comment     "Característica medible de producto o proceso. Subclase de iso15531:QualityAttribute."@es;
        rdfs:label       "QualityParameter"@en;
        rdfs:subClassOf  iso15531:QualityAttribute , iso14040:ImpactIndicator .

<http://w3id.org/protys/ontology/paint-ext#glassTransitionTemp>
        rdf:type    owl:DatatypeProperty;
        rdfs:label  "glassTransitionTemp";
        rdfs:range  xsd:decimal .

research:hasPlan  rdf:type  owl:ObjectProperty .

<http://w3id.org/protys/ontology/paint-ext#yearOfExperience>
        rdf:type    owl:DatatypeProperty;
        rdfs:label  "yearOfExperience";
        rdfs:range  xsd:integer .

iso15531:assignsResource
        rdf:type      owl:ObjectProperty;
        rdfs:comment  "Un plan de proceso asigna recursos (regla R09, Anexo C)."@es;
        rdfs:domain   iso15531:ProcessPlan , iso14040:LifeCycleInventory;
        rdfs:label    "assignsResource";
        rdfs:range    iso15531:ManufacturingResource .

<http://w3id.org/protys/ontology/paint-ext#location>
        rdf:type      owl:DatatypeProperty;
        rdfs:comment  "Ubicación textual; la versión conceptual es enterprise:locatedAt hacia enterprise:Location."@es;
        rdfs:label    "location";
        rdfs:range    xsd:string .

<http://w3id.org/protys/ontology/core#HighImpactIndicator>
        rdf:type      owl:Class;
        rdfs:comment  "Indicador de alto impacto inferido por la regla R04."@es;
        rdfs:label    "HighImpactIndicator" .

<http://w3id.org/protys/ontology/enterprise#Cell>
        rdf:type         owl:Class;
        rdfs:comment     "Agrupación lógica de estaciones que realizan operaciones relacionadas dentro del flujo de producción."@es;
        rdfs:label       "Cell"@en;
        rdfs:subClassOf  [ rdf:type            owl:Restriction;
                           owl:onProperty      <http://w3id.org/protys/ontology/enterprise#isPartOf>;
                           owl:someValuesFrom  <http://w3id.org/protys/ontology/enterprise#Shop>
                         ] .

<http://w3id.org/protys/fixture#lot>
        rdf:type                     iso15531:Lot , owl:NamedIndividual;
        alignment:hasEmittedFlow     <http://w3id.org/protys/fixture#flow>;
        iso15531:hasActivity         <http://w3id.org/protys/fixture#op>;
        iso15531:hasProcess          <http://w3id.org/protys/fixture#process>;
        research:hasGHGContribution  <http://w3id.org/protys/fixture#op> .

<http://w3id.org/protys/ontology/paint-ext#hasCarbonFootprint>
        rdf:type      owl:ObjectProperty;
        rdfs:comment  "Indicador de huella de carbono asociado a un producto (individuo de iso14040:ImpactIndicator)."@es;
        rdfs:label    "hasCarbonFootprint";
        rdfs:range    iso15531:QualityAttribute , iso14040:ImpactIndicator .

<http://w3id.org/protys/fixture#ratio>
        rdf:type               research:RatioObservation , owl:NamedIndividual;
        research:forIndicator  <http://w3id.org/protys/fixture#indicator>;
        research:forOperation  <http://w3id.org/protys/fixture#op>;
        research:operationIndicatorRatio
                "2"^^xsd:decimal .

iso14040:computedForProcess
        rdf:type      owl:ObjectProperty;
        rdfs:comment  "Indicador de impacto calculado para un proceso (patrón de validación R07, alignment-queries.sparql)."@es;
        rdfs:domain   iso15531:QualityAttribute , iso14040:ImpactIndicator;
        rdfs:label    "computedForProcess" .

iso14040:UnitProcess  rdf:type  owl:Class;
        rdfs:label           "Proceso unitario LCA"@es;
        rdfs:subClassOf      iso15531:ManufacturingProcess;
        owl:equivalentClass  iso15531:ManufacturingProcess .

[ rdf:type    swrl:Imp;
  rdfs:label  "R05: Vincular al lote los indicadores de sus procesos, sin sumar";
  swrl:body   [ rdf:type   swrl:AtomList;
                rdf:first  [ rdf:type             swrl:ClassAtom;
                             swrl:argument1       alignment:var_lot;
                             swrl:classPredicate  iso15531:Lot
                           ];
                rdf:rest   [ rdf:type   swrl:AtomList;
                             rdf:first  [ rdf:type                swrl:IndividualPropertyAtom;
                                          swrl:argument1          alignment:var_lot;
                                          swrl:argument2          alignment:var_process;
                                          swrl:propertyPredicate  iso15531:hasProcess
                                        ];
                             rdf:rest   [ rdf:type   swrl:AtomList;
                                          rdf:first  [ rdf:type                swrl:IndividualPropertyAtom;
                                                       swrl:argument1          alignment:var_process;
                                                       swrl:argument2          alignment:var_indicator;
                                                       swrl:propertyPredicate  iso14040:hasImpact
                                                     ];
                                          rdf:rest   ()
                                        ]
                           ]
              ];
  swrl:head   [ rdf:type   swrl:AtomList;
                rdf:first  [ rdf:type                swrl:IndividualPropertyAtom;
                             swrl:argument1          alignment:var_lot;
                             swrl:argument2          alignment:var_indicator;
                             swrl:propertyPredicate  iso14040:hasImpact
                           ];
                rdf:rest   ()
              ]
] .

iso15531:ManufacturingCapability
        rdf:type    owl:Class;
        rdfs:label  "Capacidad de manufactura"@es .

alignment:R19_ValidationPattern
        rdf:type      alignment:SPARQLValidationPattern , owl:NamedIndividual;
        rdfs:comment  "Detectar ausencia de medición crítica para QC en etapa de control. Reformulada como consulta SPARQL ASK con FILTER NOT EXISTS (el built-in swrlb:notBound no existe en SWRL); no es una regla de inferencia. Consulta completa en ontologies/alignment-queries.sparql (R19)."@es;
        rdfs:label    "R19: patrón de validación SPARQL ASK" .

alignment:var_e1  rdf:type  swrl:Variable .

research:registeredLossKg
        rdf:type    owl:DatatypeProperty;
        rdfs:range  xsd:decimal .

research:nextLot  rdf:type  owl:ObjectProperty .

<http://w3id.org/protys/ontology/paint-ext#suppliesTo>
        rdf:type      owl:ObjectProperty;
        rdfs:comment  "Un proveedor suministra a una organización."@es;
        rdfs:domain   <http://w3id.org/protys/ontology/paint-ext#Supplier> , <http://w3id.org/protys/ontology/core#Enterprise>;
        rdfs:label    "suppliesTo" .

<http://w3id.org/protys/ontology/paint-ext#capacityUnitsPerMinute>
        rdf:type    owl:DatatypeProperty;
        rdfs:label  "capacityUnitsPerMinute";
        rdfs:range  xsd:decimal .

[ rdf:type    swrl:Imp;
  rdfs:label  "R09: Uso del recurso requerido y asignado en el mismo plan";
  swrl:body   [ rdf:type   swrl:AtomList;
                rdf:first  [ rdf:type             swrl:ClassAtom;
                             swrl:argument1       alignment:var_plan;
                             swrl:classPredicate  iso15531:ProcessPlan
                           ];
                rdf:rest   [ rdf:type   swrl:AtomList;
                             rdf:first  [ rdf:type                swrl:IndividualPropertyAtom;
                                          swrl:argument1          alignment:var_plan;
                                          swrl:argument2          alignment:var_resource;
                                          swrl:propertyPredicate  iso15531:assignsResource
                                        ];
                             rdf:rest   [ rdf:type   swrl:AtomList;
                                          rdf:first  [ rdf:type                swrl:IndividualPropertyAtom;
                                                       swrl:argument1          alignment:var_plan;
                                                       swrl:argument2          alignment:var_op;
                                                       swrl:propertyPredicate  iso15531:includesActivity
                                                     ];
                                          rdf:rest   [ rdf:type   swrl:AtomList;
                                                       rdf:first  [ rdf:type                swrl:IndividualPropertyAtom;
                                                                    swrl:argument1          alignment:var_op;
                                                                    swrl:argument2          alignment:var_resource;
                                                                    swrl:propertyPredicate  iso15531:requiresResource
                                                                  ];
                                                       rdf:rest   ()
                                                     ]
                                        ]
                           ]
              ];
  swrl:head   [ rdf:type   swrl:AtomList;
                rdf:first  [ rdf:type                swrl:IndividualPropertyAtom;
                             swrl:argument1          alignment:var_op;
                             swrl:argument2          alignment:var_resource;
                             swrl:propertyPredicate  iso15531:usesResource
                           ];
                rdf:rest   ()
              ]
] .

iso14040:hasCharacterizationFactor
        rdf:type      owl:ObjectProperty;
        rdfs:comment  "Asocia un material con su factor de caracterización (regla R06, Anexo C)."@es;
        rdfs:label    "hasCharacterizationFactor";
        rdfs:range    iso14040:CharacterizationFactor .

<http://w3id.org/protys/ontology/paint-ext#maintenanceFrequencyDays>
        rdf:type    owl:DatatypeProperty;
        rdfs:label  "maintenanceFrequencyDays";
        rdfs:range  xsd:integer .

alignment:hasEmittedFlow
        rdf:type      owl:ObjectProperty;
        rdfs:comment  "Flujo emitido asociado a un lote (cabeza de R03, Listado 3.4)."@es;
        rdfs:domain   iso15531:Lot;
        rdfs:label    "hasEmittedFlow";
        rdfs:range    iso15531:ManufacturingResource , iso14040:ElementaryFlow;
        rdfs:range    [ rdf:type        owl:Restriction;
                        owl:hasValue    alignment:Consumed;
                        owl:onProperty  iso15531:resourceCurrentState
                      ];
        rdfs:range    [ rdf:type            owl:Class;
                        owl:intersectionOf  ( iso15531:ManufacturingResource
                                              [ rdf:type        owl:Restriction;
                                                owl:hasValue    alignment:Consumed;
                                                owl:onProperty  iso15531:resourceCurrentState
                                              ]
                                            )
                      ] .

iso15531:setupTimeMinutes
        rdf:type      owl:DatatypeProperty;
        rdfs:comment  "Tiempo de preparación en minutos (instancias del caso de estudio, Cap. 4)."@es;
        rdfs:label    "setupTimeMinutes";
        rdfs:range    xsd:decimal .

<http://w3id.org/protys/ontology/resource#hasBehaviour>
        rdf:type      owl:ObjectProperty;
        rdfs:comment  "Un Resource se define por sus comportamientos (ISO 10303-49)."@es;
        rdfs:domain   <http://w3id.org/protys/ontology/core#Resource>;
        rdfs:label    "hasBehaviour";
        rdfs:range    <http://w3id.org/protys/ontology/resource#Behaviour> .

<http://w3id.org/protys/ontology/paint-ext#Packaging>
        rdf:type         owl:Class;
        rdfs:comment     "Actividad de envasado. Subclase de process:Process_Activity."@es;
        rdfs:label       "Packaging"@en;
        rdfs:subClassOf  <http://w3id.org/protys/ontology/process#Process_Activity> .

iso15531:ManufacturingData
        rdf:type      owl:Class;
        rdfs:comment  "Registro de datos de manufactura; los eventos MES (regla R13, Anexo C) se representan como individuos de esta clase."@es;
        rdfs:label    "Dato de manufactura"@es .

[ rdf:type    swrl:Imp;
  rdfs:label  "R11: Razón rendimiento sobre duración positiva de operación";
  swrl:body   [ rdf:type   swrl:AtomList;
                rdf:first  [ rdf:type             swrl:ClassAtom;
                             swrl:argument1       alignment:var_op;
                             swrl:classPredicate  iso15531:ProcessOperation
                           ];
                rdf:rest   [ rdf:type   swrl:AtomList;
                             rdf:first  [ rdf:type                swrl:DatavaluedPropertyAtom;
                                          swrl:argument1          alignment:var_op;
                                          swrl:argument2          alignment:var_yield;
                                          swrl:propertyPredicate  iso15531:yield
                                        ];
                             rdf:rest   [ rdf:type   swrl:AtomList;
                                          rdf:first  [ rdf:type                swrl:DatavaluedPropertyAtom;
                                                       swrl:argument1          alignment:var_op;
                                                       swrl:argument2          alignment:var_duration;
                                                       swrl:propertyPredicate  iso15531:duration
                                                     ];
                                          rdf:rest   [ rdf:type   swrl:AtomList;
                                                       rdf:first  [ rdf:type        swrl:BuiltinAtom;
                                                                    swrl:arguments  [ rdf:type   rdf:List;
                                                                                      rdf:first  alignment:var_duration;
                                                                                      rdf:rest   [ rdf:type   rdf:List;
                                                                                                   rdf:first  "0"^^xsd:decimal;
                                                                                                   rdf:rest   ()
                                                                                                 ]
                                                                                    ];
                                                                    swrl:builtin    swrlb:greaterThan
                                                                  ];
                                                       rdf:rest   [ rdf:type   swrl:AtomList;
                                                                    rdf:first  [ rdf:type        swrl:BuiltinAtom;
                                                                                 swrl:arguments  ( alignment:var_efficiency alignment:var_yield alignment:var_duration );
                                                                                 swrl:builtin    swrlb:divide
                                                                               ];
                                                                    rdf:rest   ()
                                                                  ]
                                                     ]
                                        ]
                           ]
              ];
  swrl:head   [ rdf:type   swrl:AtomList;
                rdf:first  [ rdf:type                swrl:DatavaluedPropertyAtom;
                             swrl:argument1          alignment:var_op;
                             swrl:argument2          alignment:var_efficiency;
                             swrl:propertyPredicate  alignment:hasEfficiency
                           ];
                rdf:rest   ()
              ]
] .

<http://w3id.org/protys/ontology/paint-ext#BatchProcess>
        rdf:type         owl:Class;
        rdfs:comment     "Proceso por lotes de la fabricación de pinturas. Subclase de process:Artificial_Process (transformación industrial planificada, §3.3.2)."@es;
