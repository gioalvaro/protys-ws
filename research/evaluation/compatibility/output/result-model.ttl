        rdfs:comment  "Certificación de un recurso humano."@es;
        rdfs:label    "hasCertification" .

research:unit  rdf:type  owl:DatatypeProperty;
        rdfs:range  xsd:string .

iso15531:ProcessOperation
        rdf:type         owl:Class;
        rdfs:comment     "Operación o actividad atómica de manufactura. En el Anexo C las reglas la referencian también como \"Activity\" (p. ej., R01, R02, R11); esta clase es su representación canónica."@es;
        rdfs:label       "Operación de proceso"@es;
        rdfs:subClassOf  iso14040:AllocationProcedure .

<http://w3id.org/protys/ontology/core#BottleneckResource>
        rdf:type      owl:Class;
        rdfs:comment  "Recurso cuello de botella (referida por R22; la variante del Anexo C de R12 la poblaba — ver comentario de R22)."@es;
        rdfs:label    "BottleneckResource" .

iso14040:ImpactIndicator
        rdf:type             owl:Class;
        rdfs:label           "Indicador de impacto"@es;
        rdfs:subClassOf      iso15531:QualityAttribute;
        owl:equivalentClass  iso15531:QualityAttribute .

iso15531:ManufacturingResource
        rdf:type    owl:Class;
        rdfs:label  "Recurso de manufactura"@es .

[ rdf:type    swrl:Imp;
  rdfs:label  "R12: Capacidad FineGrinding por operación de molienda explícita";
  swrl:body   [ rdf:type   swrl:AtomList;
                rdf:first  [ rdf:type             swrl:ClassAtom;
                             swrl:argument1       alignment:var_resource;
                             swrl:classPredicate  iso15531:EquipmentResource
                           ];
                rdf:rest   [ rdf:type   swrl:AtomList;
                             rdf:first  [ rdf:type             swrl:ClassAtom;
                                          swrl:argument1       alignment:var_op;
                                          swrl:classPredicate  research:FineGrindingOperation
                                        ];
                             rdf:rest   [ rdf:type   swrl:AtomList;
                                          rdf:first  [ rdf:type                swrl:IndividualPropertyAtom;
                                                       swrl:argument1          alignment:var_op;
                                                       swrl:argument2          alignment:var_resource;
                                                       swrl:propertyPredicate  iso15531:requiresResource
                                                     ];
                                          rdf:rest   ()
                                        ]
                           ]
              ];
  swrl:head   [ rdf:type   swrl:AtomList;
                rdf:first  [ rdf:type                swrl:IndividualPropertyAtom;
                             swrl:argument1          alignment:var_resource;
                             swrl:argument2          alignment:FineGrinding;
                             swrl:propertyPredicate  iso15531:hasCapability
                           ];
                rdf:rest   ()
              ]
] .

research:Supplier  rdf:type  owl:Class .

research:forIndicator
        rdf:type  owl:ObjectProperty .

<http://w3id.org/protys/ontology/paint-ext#volatileOrganicCompounds>
        rdf:type    owl:DatatypeProperty;
        rdfs:label  "volatileOrganicCompounds";
        rdfs:range  xsd:decimal .

<http://w3id.org/protys/ontology/resource#Activity>
        rdf:type      owl:Class;
        rdfs:comment  "Concepto genérico de actividad usado para las relaciones Activity-Resource (Figs. 3.11 y 3.12). Process_Activity del Módulo de Proceso se corresponde con esta clase."@es;
        rdfs:label    "Activity"@en .

iso14040:ProductFlow  rdf:type  owl:Class;
        rdfs:label           "Flujo de producto"@es;
        owl:equivalentClass  <http://w3id.org/protys/ontology/product#Product> .

<http://w3id.org/protys/ontology/product#Production_Component>
        rdf:type         owl:Class;
        rdfs:comment     "Especialización de Production_Item: componente que compone un Product y puede descomponerse en subcomponentes (ISO 10303-214, ISO 10303-239)."@es;
        rdfs:label       "Production_Component"@en;
        rdfs:subClassOf  <http://w3id.org/protys/ontology/product#Thing> , <http://w3id.org/protys/ontology/product#Substance> , <http://w3id.org/protys/ontology/product#Production_Item> .

alignment:hasEfficiency
        rdf:type  owl:DatatypeProperty .

<http://w3id.org/protys/ontology/paint-ext#Workshop>
        rdf:type         owl:Class;
        rdfs:comment     "Taller/área de producción. Subclase de enterprise:Shop."@es;
        rdfs:label       "Workshop"@en;
        rdfs:subClassOf  <http://w3id.org/protys/ontology/enterprise#Shop>;
        rdfs:subClassOf  [ rdf:type            owl:Restriction;
                           owl:onProperty      <http://w3id.org/protys/ontology/enterprise#isPartOf>;
                           owl:someValuesFrom  <http://w3id.org/protys/ontology/enterprise#Factory>
                         ] .

<http://w3id.org/protys/ontology/paint-ext#QualityControl>
        rdf:type         owl:Class;
        rdfs:comment     "Actividad de control de calidad. Subclase de process:Process_Activity y de iso15531:Quality_Control_Activity (clase usada por el patrón de validación R19)."@es;
        rdfs:label       "QualityControl"@en;
        rdfs:subClassOf  <http://w3id.org/protys/ontology/process#Process_Activity> , iso15531:Quality_Control_Activity .

<http://w3id.org/protys/ontology/product#Concept>
        rdf:type         owl:Class;
        rdfs:comment     "Característica funcional: noción o idea asociada al producto, como su función prevista o su papel en un sistema mayor (p. ej., \"pieza de repuesto\")."@es;
        rdfs:label       "Concept"@en;
        rdfs:subClassOf  <http://w3id.org/protys/ontology/product#Product_Information> .

<http://w3id.org/protys/ontology/core#produces>
        rdf:type      owl:ObjectProperty;
        rdfs:comment  "Inversa de producedBy: un Process produce un Product."@es;
        rdfs:domain   <http://w3id.org/protys/ontology/core#Process>;
        rdfs:label    "produces";
        rdfs:range    <http://w3id.org/protys/ontology/product#Substance> , iso14040:ProductFlow , <http://w3id.org/protys/ontology/core#Product> , <http://w3id.org/protys/ontology/product#Thing> , <http://w3id.org/protys/ontology/product#Product> , <http://w3id.org/protys/ontology/product#Production_Item> .

alignment:var_e2  rdf:type  swrl:Variable .

<http://w3id.org/protys/ontology/paint-ext#impactUnit>
