        rdf:type      owl:Class;
        rdfs:comment  "Comportamiento que define a un Resource (ISO 10303-49)."@es;
        rdfs:label    "Behaviour"@en .

iso14040:Interpretation
        rdf:type    owl:Class;
        rdfs:label  "Interpretación"@es .

research:producesProduct
        rdf:type  owl:ObjectProperty .

<http://w3id.org/protys/ontology/process#specifiedBy>
