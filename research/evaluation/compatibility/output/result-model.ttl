        rdfs:range  xsd:string .

iso15531:productFamily
        rdf:type      owl:DatatypeProperty;
        rdfs:comment  "Familia o color del producto de un lote (regla R17, Anexo C)."@es;
        rdfs:domain   iso15531:Lot;
        rdfs:label    "productFamily";
        rdfs:range    xsd:string .

<http://w3id.org/protys/ontology/core#hasVersion>
        rdf:type      owl:DatatypeProperty;
        rdfs:comment  "Versión vigente de un término o entidad (soporta la CQ P5 de versionado, Anexo B Q21 y regla R25)."@es;
        rdfs:label    "hasVersion";
        rdfs:range    xsd:string .

alignment:var_qty  rdf:type  swrl:Variable .

research:capacityUnitsPerMinute
        rdf:type    owl:DatatypeProperty;
        rdfs:range  xsd:decimal .

<http://w3id.org/protys/ontology/core#hasLotGHGImpact>
        rdf:type      owl:DatatypeProperty;
        rdfs:comment  "Impacto GHG agregado por lote (cabeza de R21)."@es;
        rdfs:label    "hasLotGHGImpact";
        rdfs:range    xsd:decimal .

research:hasMeasurement
        rdf:type  owl:ObjectProperty .

research:cleanedResource
        rdf:type  owl:ObjectProperty .

<http://w3id.org/protys/ontology/paint-ext#Supplier>
        rdf:type         owl:Class;
        rdfs:comment     "Proveedor externo de materias primas. Subclase de core:Enterprise (organización con metas de ofrecer productos/servicios, ISO 10303-239)."@es;
        rdfs:label       "Supplier"@en;
        rdfs:subClassOf  <http://w3id.org/protys/ontology/core#Enterprise> .

research:RatioObservation
        rdf:type  owl:Class .

iso14040:EnvironmentalAspect
        rdf:type    owl:Class;
        rdfs:label  "Aspecto ambiental"@es .

<http://w3id.org/protys/ontology/core#hasEfficiency>
        rdf:type      owl:DatatypeProperty;
        rdfs:comment  "Eficiencia de proceso (cabeza de R11; usada por R23 del Anexo C y Q01)."@es;
        rdfs:label    "hasEfficiency";
        rdfs:range    xsd:decimal .

<http://w3id.org/protys/ontology/core#Resource>
        rdf:type      owl:Class;
        rdfs:comment  "Entidad definida por sus comportamientos y capacidades, utilizada por los procesos productivos (ISO 10303-49, ISO 15531). Se refina en el Módulo de Recurso (ResourceMod)."@es;
        rdfs:label    "Resource"@en , "Recurso"@es .

<http://w3id.org/protys/ontology/paint-ext#organizationCode>
        rdf:type    owl:DatatypeProperty;
        rdfs:label  "organizationCode";
        rdfs:range  xsd:string .

iso15531:ProcessPlan  rdf:type  owl:Class;
        rdfs:label       "Plan de proceso"@es;
        rdfs:subClassOf  iso14040:LifeCycleInventory .

<http://w3id.org/protys/ontology/paint-ext#manages>
        rdf:type      owl:ObjectProperty;
        rdfs:comment  "Una unidad organizacional o persona gestiona otra entidad."@es;
        rdfs:label    "manages" .

<http://w3id.org/protys/ontology/paint-ext#speedRPM>
        rdf:type    owl:DatatypeProperty;
        rdfs:label  "speedRPM";
        rdfs:range  xsd:decimal .

<http://w3id.org/protys/ontology/paint-ext#Sensor>
        rdf:type         owl:Class;
        rdfs:comment     "Sensor de proceso. Subclase de resource:Device (dispositivo de medición y control, §3.3.2)."@es;
        rdfs:label       "Sensor"@en;
        rdfs:subClassOf  <http://w3id.org/protys/ontology/resource#Device> , <http://w3id.org/protys/ontology/core#Resource> .

research:hasGHGContribution
        rdf:type  owl:ObjectProperty .

iso14040:energyConsumptionMJ
        rdf:type      owl:DatatypeProperty;
        rdfs:comment  "Consumo energético en MJ (usada por las instancias del caso de estudio, Cap. 4)."@es;
        rdfs:label    "energyConsumptionMJ";
        rdfs:range    xsd:decimal .

alignment:var_material
        rdf:type  swrl:Variable .

<http://w3id.org/protys/ontology/core#bridgesFlowToActivity>
        rdf:type      owl:ObjectProperty;
        rdfs:comment  "Puente entre un flujo de inventario ISO 14040 y una actividad ISO 15531 (cabeza de R20)."@es;
        rdfs:domain   iso15531:ManufacturingResource , iso14040:ElementaryFlow;
        rdfs:domain   [ rdf:type        owl:Restriction;
                        owl:hasValue    alignment:Consumed;
                        owl:onProperty  iso15531:resourceCurrentState
                      ];
        rdfs:domain   [ rdf:type            owl:Class;
                        owl:intersectionOf  ( iso15531:ManufacturingResource
                                              [ rdf:type        owl:Restriction;
                                                owl:hasValue    alignment:Consumed;
                                                owl:onProperty  iso15531:resourceCurrentState
                                              ]
                                            )
                      ];
        rdfs:label    "bridgesFlowToActivity";
        rdfs:range    iso15531:ProcessOperation , iso14040:AllocationProcedure .

iso14040:hasSystemBoundary
        rdf:type      owl:ObjectProperty;
        rdfs:comment  "Frontera del sistema de un estudio de ACV."@es;
        rdfs:domain   iso14040:LCAStudy;
        rdfs:domain   [ rdf:type         owl:Restriction;
                        owl:cardinality  "1"^^xsd:nonNegativeInteger;
                        owl:onProperty   iso14040:hasFunctionalUnit
                      ];
        rdfs:label    "hasSystemBoundary";
        rdfs:range    iso15531:ManufacturingFacility , iso14040:SystemBoundary .

<http://w3id.org/protys/ontology/enterprise#Station>
        rdf:type         owl:Class;
        rdfs:comment     "Estación de trabajo individual donde se ejecuta una operación o tarea específica del proceso productivo (nivel más básico de la jerarquía)."@es;
        rdfs:label       "Station"@en;
        rdfs:subClassOf  [ rdf:type            owl:Restriction;
                           owl:onProperty      <http://w3id.org/protys/ontology/enterprise#isPartOf>;
                           owl:someValuesFrom  <http://w3id.org/protys/ontology/enterprise#Cell>
                         ] .

research:outputMassKg
        rdf:type    owl:DatatypeProperty;
        rdfs:range  xsd:decimal .

<http://w3id.org/protys/ontology/core#hasResource>
        rdf:type       owl:ObjectProperty;
        rdfs:comment   "Propiedad de conveniencia: un Process dispone de un Resource. Inversa de usedBy."@es;
        rdfs:label     "hasResource";
        rdfs:range     <http://w3id.org/protys/ontology/core#Resource>;
        owl:inverseOf  <http://w3id.org/protys/ontology/core#usedBy> .

<http://w3id.org/protys/ontology/resource#hasRole>
        rdf:type      owl:ObjectProperty;
        rdfs:comment  "Una Person se relaciona con Role para determinar sus capacidades específicas (agregación 1..n, Fig. 3.11)."@es;
        rdfs:domain   <http://w3id.org/protys/ontology/resource#Person> , <http://w3id.org/protys/ontology/core#Resource>;
        rdfs:label    "hasRole";
        rdfs:range    <http://w3id.org/protys/ontology/resource#Role> .

alignment:var_ratio  rdf:type  swrl:Variable .

iso15531:consumesMaterial
        rdf:type      owl:ObjectProperty;
        rdfs:comment  "Una actividad consume un material (regla R20, Anexo C)."@es;
        rdfs:domain   iso15531:ProcessOperation , iso14040:AllocationProcedure;
        rdfs:label    "consumesMaterial";
        rdfs:range    iso15531:ManufacturingResource .

<http://w3id.org/protys/ontology/resource#Material>
        rdf:type         owl:Class;
        rdfs:comment     "Recurso material gestionado según las necesidades de cada fase del ciclo de producción (Fig. 3.10; ISO 10303-232, ISO 10303-227, ISO 10303-1082)."@es;
        rdfs:label       "Material"@en;
        rdfs:subClassOf  <http://w3id.org/protys/ontology/core#Resource> .

<http://w3id.org/protys/ontology/product#Fact>
        rdf:type         owl:Class;
        rdfs:comment     "Característica funcional: dato objetivo y verificable sobre el producto (p. ej., \"peso: 2,5 kg\" o \"resistencia térmica: hasta 120 °C\")."@es;
        rdfs:label       "Fact"@en;
        rdfs:subClassOf  <http://w3id.org/protys/ontology/product#Product_Information> .

<http://w3id.org/protys/ontology/resource#producesResource>
        rdf:type      owl:ObjectProperty;
        rdfs:comment  "La actividad genera o modifica el recurso como resultado (Fig. 3.11)."@es;
        rdfs:domain   <http://w3id.org/protys/ontology/resource#Activity>;
        rdfs:label    "producesResource";
        rdfs:range    <http://w3id.org/protys/ontology/core#Resource> .

<http://w3id.org/protys/fixture#op>
        rdf:type                     research:FineGrindingOperation , iso15531:ProcessOperation , iso14040:AllocationProcedure , owl:NamedIndividual;
        alignment:hasEfficiency      "5"^^xsd:decimal;
        iso14040:hasEmissionFactor   <http://w3id.org/protys/fixture#factor>;
        iso14040:hasGHGImpactKgCO2e  5.0;
        iso15531:consumesEnergyKWh   "10"^^xsd:decimal;
        iso15531:cycleTime           "20"^^xsd:decimal;
        iso15531:duration            "20"^^xsd:decimal;
        iso15531:partOfProcess       <http://w3id.org/protys/fixture#process>;
        iso15531:requiresResource    <http://w3id.org/protys/fixture#mill>;
        iso15531:yield               "98"^^xsd:decimal .

<http://w3id.org/protys/ontology/core#producedBy>
        rdf:type       owl:ObjectProperty;
        rdfs:comment   "Un Product es producido por un Process (Fig. 3.6)."@es;
        rdfs:domain    <http://w3id.org/protys/ontology/product#Production_Item> , <http://w3id.org/protys/ontology/core#Product> , <http://w3id.org/protys/ontology/product#Product> , iso14040:ProductFlow , <http://w3id.org/protys/ontology/product#Thing> , <http://w3id.org/protys/ontology/product#Substance>;
        rdfs:label     "producedBy";
        rdfs:range     <http://w3id.org/protys/ontology/core#Process>;
        owl:inverseOf  <http://w3id.org/protys/ontology/core#produces> .

iso14040:LifeCycleInventory
        rdf:type             owl:Class;
        rdfs:label           "Inventario de ciclo de vida"@es;
        rdfs:subClassOf      iso15531:ProcessPlan;
        owl:equivalentClass  iso15531:ProcessPlan .

iso15531:requiresCleaningBetween
        rdf:type      owl:ObjectProperty;
        rdfs:comment  "Se requiere limpieza entre dos lotes de familias incompatibles procesados en el mismo equipo (cabeza de la regla R17, Anexo C)."@es;
        rdfs:domain   iso15531:Lot;
        rdfs:label    "requiresCleaningBetween";
        rdfs:range    iso15531:Lot .

<http://w3id.org/protys/ontology/paint-ext#Standard>
        rdf:type         owl:Class;
        rdfs:comment     "Documento normativo utilizado en manufactura. Subclase de resource:File: se gestiona como recurso documental/digital (Fig. 3.12)."@es;
        rdfs:label       "Standard"@en;
        rdfs:subClassOf  <http://w3id.org/protys/ontology/resource#File> , <http://w3id.org/protys/ontology/core#Resource> .

<http://w3id.org/protys/fixture#mill>
        rdf:type                iso15531:ManufacturingResource , iso15531:EquipmentResource , owl:NamedIndividual;
        iso15531:hasCapability  alignment:FineGrinding .

<http://w3id.org/protys/ontology/process#Natural_Process>
        rdf:type         owl:Class;
        rdfs:comment     "Proceso natural, derivado de la definición de Process en ISO 8000, ISO 10303, ISO 13584, ISO 15531, ISO 15926 e ISO 18629."@es;
        rdfs:label       "Natural_Process"@en;
        rdfs:subClassOf  <http://w3id.org/protys/ontology/core#Process> .

<http://w3id.org/protys/ontology/paint-ext#hasVOCContent>
        rdf:type      owl:ObjectProperty;
        rdfs:comment  "Indicador de contenido de VOC asociado a un producto."@es;
        rdfs:label    "hasVOCContent";
        rdfs:range    iso15531:QualityAttribute , iso14040:ImpactIndicator .

alignment:var_l2  rdf:type  swrl:Variable .

research:Measurement  rdf:type  owl:Class .

[ rdf:type    swrl:Imp;
  rdfs:label  "R20: Puente flujo y operación de consumo del mismo proceso";
  swrl:body   [ rdf:type   swrl:AtomList;
                rdf:first  [ rdf:type             swrl:ClassAtom;
                             swrl:argument1       alignment:var_op;
                             swrl:classPredicate  iso15531:ProcessOperation
                           ];
                rdf:rest   [ rdf:type   swrl:AtomList;
                             rdf:first  [ rdf:type                swrl:IndividualPropertyAtom;
                                          swrl:argument1          alignment:var_op;
                                          swrl:argument2          alignment:var_material;
                                          swrl:propertyPredicate  iso15531:consumesMaterial
                                        ];
                             rdf:rest   [ rdf:type   swrl:AtomList;
                                          rdf:first  [ rdf:type                swrl:IndividualPropertyAtom;
                                                       swrl:argument1          alignment:var_op;
                                                       swrl:argument2          alignment:var_process;
                                                       swrl:propertyPredicate  iso15531:partOfProcess
                                                     ];
                                          rdf:rest   [ rdf:type   swrl:AtomList;
                                                       rdf:first  [ rdf:type             swrl:ClassAtom;
                                                                    swrl:argument1       alignment:var_flow;
                                                                    swrl:classPredicate  iso14040:ElementaryFlow
                                                                  ];
                                                       rdf:rest   [ rdf:type   swrl:AtomList;
                                                                    rdf:first  [ rdf:type                swrl:IndividualPropertyAtom;
                                                                                 swrl:argument1          alignment:var_flow;
                                                                                 swrl:argument2          alignment:var_material;
                                                                                 swrl:propertyPredicate  iso14040:refersToMaterial
                                                                               ];
                                                                    rdf:rest   [ rdf:type   swrl:AtomList;
                                                                                 rdf:first  [ rdf:type                swrl:IndividualPropertyAtom;
                                                                                              swrl:argument1          alignment:var_flow;
                                                                                              swrl:argument2          alignment:var_process;
                                                                                              swrl:propertyPredicate  research:belongsToProcess
                                                                                            ];
                                                                                 rdf:rest   ()
                                                                               ]
                                                                  ]
                                                     ]
                                        ]
                           ]
              ];
  swrl:head   [ rdf:type   swrl:AtomList;
                rdf:first  [ rdf:type                swrl:IndividualPropertyAtom;
                             swrl:argument1          alignment:var_flow;
                             swrl:argument2          alignment:var_op;
                             swrl:propertyPredicate  <http://w3id.org/protys/ontology/core#bridgesFlowToActivity>
                           ];
                rdf:rest   ()
              ]
] .

alignment:var_indicator
        rdf:type  swrl:Variable .

alignment:SPARQLValidationPattern
        rdf:type      owl:Class;
        rdfs:comment  "Clase de anotación para los patrones de validación SPARQL ASK (R07, R16, R19, R26) documentados en ontologies/alignment-queries.sparql."@es;
        rdfs:label    "SPARQLValidationPattern" .

iso15531:ResourceState
        rdf:type    owl:Class;
        rdfs:label  "Estado de recurso"@es .

<http://w3id.org/protys/ontology/process#Procedure>
        rdf:type         owl:Class;
        rdfs:comment     "Método o protocolo específico para ejecutar un proceso; se asocia con Process según ISO 10303."@es;
        rdfs:label       "Procedure"@en;
        rdfs:subClassOf  [ rdf:type     owl:Class;
                           owl:unionOf  ( <http://w3id.org/protys/ontology/process#Procedure> <http://w3id.org/protys/ontology/process#Procedure_Activity> )
                         ] .

alignment:var_f  rdf:type  swrl:Variable .

<http://w3id.org/protys/ontology/product#Product_Information>
        rdf:type      owl:Class;
        rdfs:comment  "Información del producto (ISO 10303-1): captura la dimensión física (Physical_Characteristics) y funcional (Instruction, Fact, Concept) de los productos."@es;
        rdfs:label    "Product_Information"@en .

<http://w3id.org/protys/ontology/core#Enterprise>
        rdf:type      owl:Class;
        rdfs:comment  "Una o más organizaciones con un conjunto de metas y objetivos para ofrecer productos y/o servicios (ISO 10303-239). Se refina en el Módulo de Empresa (EnterpriseMod)."@es;
        rdfs:label    "Enterprise"@en , "Empresa"@es .

<http://w3id.org/protys/ontology/paint-ext#hasProcessPlan>
        rdf:type      owl:ObjectProperty;
        rdfs:comment  "Vincula un producto con el proceso/plan que lo fabrica."@es;
        rdfs:label    "hasProcessPlan" .

research:yieldPercent
        rdf:type    owl:DatatypeProperty;
        rdfs:range  xsd:decimal .

[ rdf:type    swrl:Imp;
  rdfs:label  "R22: Hotspot vinculado al mismo proceso y recurso cuello de botella";
  swrl:body   [ rdf:type   swrl:AtomList;
                rdf:first  [ rdf:type             swrl:ClassAtom;
                             swrl:argument1       alignment:var_indicator;
                             swrl:classPredicate  <http://w3id.org/protys/ontology/core#HighImpactIndicator>
                           ];
                rdf:rest   [ rdf:type   swrl:AtomList;
                             rdf:first  [ rdf:type                swrl:IndividualPropertyAtom;
                                          swrl:argument1          alignment:var_indicator;
                                          swrl:argument2          alignment:var_process;
                                          swrl:propertyPredicate  iso14040:computedForProcess
                                        ];
                             rdf:rest   [ rdf:type   swrl:AtomList;
                                          rdf:first  [ rdf:type                swrl:IndividualPropertyAtom;
                                                       swrl:argument1          alignment:var_op;
                                                       swrl:argument2          alignment:var_process;
                                                       swrl:propertyPredicate  iso15531:partOfProcess
                                                     ];
                                          rdf:rest   [ rdf:type   swrl:AtomList;
                                                       rdf:first  [ rdf:type                swrl:IndividualPropertyAtom;
                                                                    swrl:argument1          alignment:var_op;
                                                                    swrl:argument2          alignment:var_resource;
                                                                    swrl:propertyPredicate  iso15531:requiresResource
                                                                  ];
                                                       rdf:rest   [ rdf:type   swrl:AtomList;
                                                                    rdf:first  [ rdf:type             swrl:ClassAtom;
                                                                                 swrl:argument1       alignment:var_resource;
                                                                                 swrl:classPredicate  <http://w3id.org/protys/ontology/core#BottleneckResource>
                                                                               ];
                                                                    rdf:rest   ()
                                                                  ]
                                                     ]
                                        ]
                           ]
              ];
  swrl:head   [ rdf:type   swrl:AtomList;
                rdf:first  [ rdf:type             swrl:ClassAtom;
                             swrl:argument1       alignment:var_resource;
                             swrl:classPredicate  <http://w3id.org/protys/ontology/core#Hotspot>
                           ];
                rdf:rest   ()
              ]
] .

research:eventTimeSeconds
        rdf:type    owl:DatatypeProperty;
        rdfs:range  xsd:decimal .

<http://w3id.org/protys/ontology/core#hasName>
        rdf:type      owl:DatatypeProperty;
        rdfs:comment  "Nombre o identificador textual de una entidad."@es;
        rdfs:label    "hasName";
        rdfs:range    xsd:string .

iso15531:Quality_Control_Activity
        rdf:type         owl:Class;
        rdfs:comment     "Actividad de control de calidad. Declarada en la capa de alineamiento para soportar el patrón de validación R19 sin alterar el conteo de 18 clases del módulo ISO 15531 (Listado 3.2)."@es;
        rdfs:label       "Quality_Control_Activity";
        rdfs:subClassOf  iso15531:ProcessOperation , iso14040:AllocationProcedure .

<http://w3id.org/protys/ontology/core#Hotspot>
        rdf:type      owl:Class;
        rdfs:comment  "Hotspot: combinación de alto impacto ambiental y baja eficiencia (cabeza de R22)."@es;
        rdfs:label    "Hotspot" .

<http://w3id.org/protys/ontology/paint-ext#capacityLitersPerHour>
        rdf:type    owl:DatatypeProperty;
        rdfs:label  "capacityLitersPerHour";
        rdfs:range  xsd:decimal .

<http://w3id.org/protys/ontology/process#Artificial_Process>
        rdf:type          owl:Class;
        rdfs:comment      "Proceso artificial (industrial), derivado de la definición de Process en los estándares ISO TC184/SC4."@es;
        rdfs:label        "Artificial_Process"@en;
        rdfs:subClassOf   <http://w3id.org/protys/ontology/core#Process>;
        owl:disjointWith  <http://w3id.org/protys/ontology/process#Natural_Process> .

[ rdf:type    swrl:Imp;
  rdfs:label  "R18: Marcar lote candidato a reproceso por no conformidad";
  swrl:body   [ rdf:type   swrl:AtomList;
                rdf:first  [ rdf:type             swrl:ClassAtom;
                             swrl:argument1       alignment:var_lot;
                             swrl:classPredicate  iso15531:Lot
                           ];
                rdf:rest   [ rdf:type   swrl:AtomList;
                             rdf:first  [ rdf:type                swrl:IndividualPropertyAtom;
                                          swrl:argument1          alignment:var_lot;
                                          swrl:argument2          alignment:var_nonconformity;
                                          swrl:propertyPredicate  iso15531:hasNonConformity
                                        ];
                             rdf:rest   ()
                           ]
              ];
  swrl:head   [ rdf:type   swrl:AtomList;
                rdf:first  [ rdf:type             swrl:ClassAtom;
                             swrl:argument1       alignment:var_lot;
                             swrl:classPredicate  iso15531:requiresReprocess
                           ];
                rdf:rest   ()
              ]
] .

<http://w3id.org/protys/ontology/process#composedBy>
        rdf:type      owl:ObjectProperty;
        rdfs:comment  "Un Process está compuesto por sus Process_Activities (agregación 1..n, Fig. 3.7)."@es;
        rdfs:domain   <http://w3id.org/protys/ontology/core#Process>;
        rdfs:label    "composedBy";
        rdfs:range    <http://w3id.org/protys/ontology/process#Process_Activity> .

iso14040:hasImpact  rdf:type  owl:ObjectProperty;
        rdfs:comment  "Asocia un proceso o lote con un impacto/indicador de impacto (regla R05, Anexo C: agregación de impactos por etapa hacia el lote)."@es;
        rdfs:label    "hasImpact" .

alignment:var_flow  rdf:type  swrl:Variable .

iso15531:operationSequence
        rdf:type      owl:DatatypeProperty;
        rdfs:comment  "Secuencia de una operación dentro del plan (instancias del caso de estudio, Cap. 4)."@es;
        rdfs:label    "operationSequence";
        rdfs:range    xsd:integer .

iso15531:hasProcess  rdf:type  owl:ObjectProperty;
        rdfs:comment  "Un lote se asocia a los procesos por los que transita (regla R05, Anexo C)."@es;
        rdfs:domain   iso15531:Lot;
        rdfs:label    "hasProcess";
        rdfs:range    iso15531:ManufacturingProcess , iso14040:UnitProcess .

<http://w3id.org/protys/ontology/process#Parameters>
        rdf:type      owl:Class;
        rdfs:comment  "Valores concretos de configuración (temperatura, presión, tiempo) necesarios para la correcta ejecución de actividades y procedimientos."@es;
        rdfs:label    "Parameters"@en .

[ rdf:type    swrl:Imp;
  rdfs:label  "R14: Operador responsable de la operación de su orden";
  swrl:body   [ rdf:type   swrl:AtomList;
                rdf:first  [ rdf:type             swrl:ClassAtom;
                             swrl:argument1       alignment:var_order;
                             swrl:classPredicate  iso15531:WorkOrder
                           ];
                rdf:rest   [ rdf:type   swrl:AtomList;
                             rdf:first  [ rdf:type                swrl:IndividualPropertyAtom;
                                          swrl:argument1          alignment:var_order;
                                          swrl:argument2          alignment:var_operator;
                                          swrl:propertyPredicate  iso15531:executedBy
                                        ];
                             rdf:rest   [ rdf:type   swrl:AtomList;
                                          rdf:first  [ rdf:type             swrl:ClassAtom;
                                                       swrl:argument1       alignment:var_operator;
                                                       swrl:classPredicate  iso15531:HumanResource
                                                     ];
                                          rdf:rest   [ rdf:type   swrl:AtomList;
                                                       rdf:first  [ rdf:type                swrl:IndividualPropertyAtom;
                                                                    swrl:argument1          alignment:var_order;
                                                                    swrl:argument2          alignment:var_op;
                                                                    swrl:propertyPredicate  iso15531:executesActivity
                                                                  ];
                                                       rdf:rest   ()
                                                     ]
                                        ]
                           ]
              ];
  swrl:head   [ rdf:type   swrl:AtomList;
                rdf:first  [ rdf:type                swrl:IndividualPropertyAtom;
                             swrl:argument1          alignment:var_op;
                             swrl:argument2          alignment:var_operator;
                             swrl:propertyPredicate  iso15531:responsibleOperator
                           ];
                rdf:rest   ()
              ]
] .

iso14040:usesCharacterizationFactor
        rdf:type      owl:ObjectProperty;
        rdfs:comment  "Un flujo de inventario usa un factor de caracterización (cabeza de la regla R06, Anexo C)."@es;
        rdfs:domain   iso15531:ManufacturingResource , iso14040:ElementaryFlow;
        rdfs:domain   [ rdf:type        owl:Restriction;
                        owl:hasValue    alignment:Consumed;
                        owl:onProperty  iso15531:resourceCurrentState
                      ];
        rdfs:domain   [ rdf:type            owl:Class;
                        owl:intersectionOf  ( iso15531:ManufacturingResource
                                              [ rdf:type        owl:Restriction;
                                                owl:hasValue    alignment:Consumed;
                                                owl:onProperty  iso15531:resourceCurrentState
                                              ]
                                            )
                      ];
        rdfs:label    "usesCharacterizationFactor";
        rdfs:range    iso14040:CharacterizationFactor .

<http://w3id.org/protys/ontology/paint-ext#certificationLevel>
        rdf:type    owl:DatatypeProperty;
        rdfs:label  "certificationLevel";
        rdfs:range  xsd:string .

<http://w3id.org/protys/ontology/product#Instruction>
        rdf:type         owl:Class;
        rdfs:comment     "Característica funcional: información sobre cómo fabricar, ensamblar o utilizar el producto (p. ej., un manual de montaje o una guía de usuario)."@es;
        rdfs:label       "Instruction"@en;
        rdfs:subClassOf  <http://w3id.org/protys/ontology/product#Product_Information> .

<http://w3id.org/protys/ontology/paint-ext#EnvironmentalIndicator>
        rdf:type         owl:Class;
        rdfs:comment     "Aspecto medible de desempeño ambiental. Subclase de iso14040:ImpactIndicator."@es;
        rdfs:label       "EnvironmentalIndicator"@en;
        rdfs:subClassOf  iso15531:QualityAttribute , iso14040:ImpactIndicator .

<http://w3id.org/protys/ontology/paint-ext#Setup_Activity>
        rdf:type         owl:Class;
        rdfs:comment     "Actividad de preparación/cambio de formato. Subclase de process:Process_Activity."@es;
        rdfs:label       "Setup_Activity"@en;
        rdfs:subClassOf  <http://w3id.org/protys/ontology/process#Process_Activity> .

<http://w3id.org/protys/ontology/core#MissingEnvironmentalData>
        rdf:type      owl:Class;
        rdfs:comment  "Proceso con datos ambientales faltantes; se asserta a partir del resultado del patrón de validación R07 (alignment-queries.sparql)."@es;
        rdfs:label    "MissingEnvironmentalData" .

iso15531:producesQuantity
        rdf:type      owl:DatatypeProperty;
        rdfs:comment  "Cantidad producida por un lote (regla R08, Anexo C)."@es;
        rdfs:domain   iso15531:Lot;
        rdfs:label    "producesQuantity";
        rdfs:range    xsd:decimal .

research:materialQuantityKg
        rdf:type    owl:DatatypeProperty;
        rdfs:range  xsd:decimal .

research:waterFootprintLPerKg
        rdf:type    owl:DatatypeProperty;
        rdfs:range  xsd:decimal .

<http://w3id.org/protys/ontology/paint-ext#purityPercent>
        rdf:type    owl:DatatypeProperty;
        rdfs:label  "purityPercent";
        rdfs:range  xsd:decimal .

iso15531:hasMeasurement
        rdf:type      owl:ObjectProperty;
        rdfs:comment  "Medición asociada a una actividad de control de calidad (patrón de validación R19). Declarada en la capa de alineamiento para no alterar el módulo ISO 15531."@es;
        rdfs:domain   iso15531:Quality_Control_Activity , iso15531:ProcessOperation , iso14040:AllocationProcedure;
        rdfs:label    "hasMeasurement" .

<http://w3id.org/protys/ontology/paint-ext#hasFunction>
        rdf:type    owl:DatatypeProperty;
        rdfs:label  "hasFunction";
        rdfs:range  xsd:string .

<http://w3id.org/protys/fixture#factor>
        rdf:type              iso14040:CharacterizationFactor , owl:NamedIndividual;
        iso14040:factorUnit   "kg CO2e/kWh";
        iso14040:factorValue  0.5 .

<http://w3id.org/protys/ontology/paint-ext#OEEPercent>
        rdf:type    owl:DatatypeProperty;
        rdfs:label  "OEEPercent";
        rdfs:range  xsd:decimal .

<http://w3id.org/protys/fixture#process>
        rdf:type        iso15531:ManufacturingProcess , iso14040:UnitProcess , owl:NamedIndividual;
        iso14040:emits  <http://w3id.org/protys/fixture#flow> .

<http://w3id.org/protys/ontology/process#Procedure_Activity>
        rdf:type         owl:Class;
        rdfs:comment     "Instanciación o ejecución concreta de una Process_Activity; permite diferenciar entre la definición abstracta de una actividad y su realización específica."@es;
        rdfs:label       "Procedure_Activity"@en;
        rdfs:subClassOf  <http://w3id.org/protys/ontology/process#Process_Activity>;
        rdfs:subClassOf  [ rdf:type     owl:Class;
                           owl:unionOf  ( <http://w3id.org/protys/ontology/process#Procedure> <http://w3id.org/protys/ontology/process#Procedure_Activity> )
                         ] .

<http://w3id.org/protys/ontology/enterprise#isPartOf>
        rdf:type      owl:TransitiveProperty , owl:ObjectProperty;
        rdfs:comment  "Agregación jerárquica entre niveles organizacionales (Station en Cell, Cell en Shop, Shop en Factory, Factory en Enterprise)."@es;
        rdfs:label    "isPartOf" .

<http://w3id.org/protys/ontology/resource#Resource_Related_File>
        rdf:type         owl:Class;
        rdfs:comment     "Archivo asociado a recursos específicos (Fig. 3.12)."@es;
        rdfs:label       "Resource_Related_File"@en;
        rdfs:subClassOf  <http://w3id.org/protys/ontology/resource#File> , <http://w3id.org/protys/ontology/core#Resource> .

<http://w3id.org/protys/ontology/resource#Process_Material>
        rdf:type         owl:Class;
        rdfs:comment     "Material requerido para llevar a cabo una Process_Activity; vincula el Módulo de Proceso con el Módulo de Recursos (definición canónica en ResourceMod, Fig. 3.10)."@es;
        rdfs:label       "Process_Material"@en;
        rdfs:subClassOf  <http://w3id.org/protys/ontology/resource#Material> , <http://w3id.org/protys/ontology/core#Resource> .

<http://w3id.org/protys/ontology/product#Production_Item>
        rdf:type         owl:Class;
        rdfs:comment     "Abstracción que representa la forma general del producto (ISO 10303-1, ISO 10303-41); se especializa en Product y Production_Component."@es;
        rdfs:label       "Production_Item"@en;
        rdfs:subClassOf  <http://w3id.org/protys/ontology/product#Thing> , <http://w3id.org/protys/ontology/product#Substance> .

[ rdf:type    swrl:Imp;
  rdfs:label  "R17: Requerir limpieza entre lotes consecutivos de familia distinta";
  swrl:body   [ rdf:type   swrl:AtomList;
                rdf:first  [ rdf:type             swrl:ClassAtom;
                             swrl:argument1       alignment:var_l1;
                             swrl:classPredicate  iso15531:Lot
                           ];
                rdf:rest   [ rdf:type   swrl:AtomList;
                             rdf:first  [ rdf:type             swrl:ClassAtom;
                                          swrl:argument1       alignment:var_l2;
                                          swrl:classPredicate  iso15531:Lot
                                        ];
                             rdf:rest   [ rdf:type   swrl:AtomList;
                                          rdf:first  [ rdf:type                swrl:IndividualPropertyAtom;
                                                       swrl:argument1          alignment:var_l1;
                                                       swrl:argument2          alignment:var_equipment;
                                                       swrl:propertyPredicate  iso15531:processedOn
                                                     ];
                                          rdf:rest   [ rdf:type   swrl:AtomList;
                                                       rdf:first  [ rdf:type                swrl:IndividualPropertyAtom;
                                                                    swrl:argument1          alignment:var_l2;
                                                                    swrl:argument2          alignment:var_equipment;
                                                                    swrl:propertyPredicate  iso15531:processedOn
                                                                  ];
                                                       rdf:rest   [ rdf:type   swrl:AtomList;
                                                                    rdf:first  [ rdf:type                swrl:IndividualPropertyAtom;
                                                                                 swrl:argument1          alignment:var_l1;
                                                                                 swrl:argument2          alignment:var_l2;
                                                                                 swrl:propertyPredicate  research:nextLot
                                                                               ];
                                                                    rdf:rest   [ rdf:type   swrl:AtomList;
                                                                                 rdf:first  [ rdf:type                swrl:DatavaluedPropertyAtom;
                                                                                              swrl:argument1          alignment:var_l1;
                                                                                              swrl:argument2          alignment:var_f1;
                                                                                              swrl:propertyPredicate  iso15531:productFamily
                                                                                            ];
                                                                                 rdf:rest   [ rdf:type   swrl:AtomList;
                                                                                              rdf:first  [ rdf:type                swrl:DatavaluedPropertyAtom;
                                                                                                           swrl:argument1          alignment:var_l2;
                                                                                                           swrl:argument2          alignment:var_f2;
                                                                                                           swrl:propertyPredicate  iso15531:productFamily
                                                                                                         ];
                                                                                              rdf:rest   [ rdf:type   swrl:AtomList;
                                                                                                           rdf:first  [ rdf:type        swrl:BuiltinAtom;
                                                                                                                        swrl:arguments  ( alignment:var_f1 alignment:var_f2 );
                                                                                                                        swrl:builtin    swrlb:notEqual
                                                                                                                      ];
                                                                                                           rdf:rest   ()
                                                                                                         ]
                                                                                            ]
                                                                               ]
                                                                  ]
                                                     ]
                                        ]
                           ]
              ];
  swrl:head   [ rdf:type   swrl:AtomList;
                rdf:first  [ rdf:type                swrl:IndividualPropertyAtom;
                             swrl:argument1          alignment:var_l1;
                             swrl:argument2          alignment:var_l2;
                             swrl:propertyPredicate  iso15531:requiresCleaningBetween
                           ];
                rdf:rest   ()
              ]
] .

research:lifecycleStage
        rdf:type    owl:DatatypeProperty;
        rdfs:range  xsd:string .

<http://w3id.org/protys/ontology/product#isComposedOF>
        rdf:type      owl:ObjectProperty;
        rdfs:comment  "Un Product puede estar compuesto por múltiples Production_Components (ISO 10303-214, ISO 10303-239). Inversa de composes."@es;
        rdfs:domain   <http://w3id.org/protys/ontology/core#Product> , <http://w3id.org/protys/ontology/product#Thing> , iso14040:ProductFlow , <http://w3id.org/protys/ontology/product#Production_Item> , <http://w3id.org/protys/ontology/product#Product> , <http://w3id.org/protys/ontology/product#Substance>;
        rdfs:label    "isComposedOF";
        rdfs:range    <http://w3id.org/protys/ontology/product#Production_Component> , <http://w3id.org/protys/ontology/product#Thing> , <http://w3id.org/protys/ontology/product#Production_Item> , <http://w3id.org/protys/ontology/product#Substance> .

iso14040:hasEmissionFactor
        rdf:type      owl:ObjectProperty;
        rdfs:comment  "Vincula una actividad/proceso con su factor de emisión, modelado como CharacterizationFactor (reglas R01 y R21, Anexo C)."@es;
        rdfs:label    "hasEmissionFactor";
        rdfs:range    iso14040:CharacterizationFactor .

<http://w3id.org/protys/ontology/resource#Person>
        rdf:type         owl:Class;
        rdfs:comment     "Recurso humano dentro de la industria; especialización de Resource. Los individuos de Person se relacionan con Role para determinar sus capacidades específicas (Fig. 3.11)."@es;
        rdfs:label       "Person"@en;
        rdfs:subClassOf  <http://w3id.org/protys/ontology/core#Resource> .

iso14040:appliesTo  rdf:type  owl:ObjectProperty;
        rdfs:comment  "Un impacto o aspecto ambiental aplica a un componente o proceso (ejemplo ilustrativo §3.3.3.4)."@es;
        rdfs:label    "appliesTo" .

iso14040:hasFunctionalUnitQuantity
        rdf:type      owl:DatatypeProperty;
        rdfs:comment  "Cantidad expresada en la unidad funcional, para comparación entre lotes (cabeza de la regla R08, Anexo C)."@es;
        rdfs:label    "hasFunctionalUnitQuantity";
        rdfs:range    xsd:decimal .

<http://w3id.org/protys/ontology/paint-ext#hasURI>
        rdf:type    owl:DatatypeProperty;
        rdfs:label  "hasURI";
        rdfs:range  xsd:anyURI .

iso15531:cycleTime  rdf:type  owl:DatatypeProperty;
        rdfs:comment  "Tiempo de ciclo de una operación (reglas R12 y R23, Listado 3.4)."@es;
        rdfs:label    "cycleTime";
        rdfs:range    xsd:decimal .

<http://w3id.org/protys/ontology/paint-ext#hasValue>
        rdf:type      owl:DatatypeProperty;
        rdfs:comment  "Valor numérico de un indicador o especificación del caso."@es;
        rdfs:label    "hasValue";
        rdfs:range    xsd:decimal .

research:oeePercent  rdf:type  owl:DatatypeProperty;
        rdfs:range  xsd:decimal .

alignment:R07_ValidationPattern
        rdf:type      alignment:SPARQLValidationPattern , owl:NamedIndividual;
        rdfs:comment  "Detectar faltantes de datos ambientales requeridos (completitud). Reformulada como consulta SPARQL ASK con FILTER NOT EXISTS (el built-in swrlb:notBound no existe en SWRL); no es una regla de inferencia. Consulta completa en ontologies/alignment-queries.sparql (R07)."@es;
        rdfs:label    "R07: patrón de validación SPARQL ASK" .

<http://w3id.org/protys/ontology/resource#File>
        rdf:type         owl:Class;
        rdfs:comment     "Archivo digital general, gestionado como un tipo particular de recurso (Fig. 3.12)."@es;
        rdfs:label       "File"@en;
        rdfs:subClassOf  <http://w3id.org/protys/ontology/core#Resource> .

alignment:var_ghg  rdf:type  swrl:Variable .

<http://w3id.org/protys/ontology/resource#isOutputOfActivity>
        rdf:type      owl:ObjectProperty;
        rdfs:comment  "Un File es salida de una Activity (Fig. 3.12)."@es;
        rdfs:domain   <http://w3id.org/protys/ontology/resource#File> , <http://w3id.org/protys/ontology/core#Resource>;
        rdfs:label    "isOutputOfActivity";
        rdfs:range    <http://w3id.org/protys/ontology/resource#Activity> .

<http://w3id.org/protys/ontology/paint-ext#CleaningOperation>
        rdf:type         owl:Class;
        rdfs:comment     "Operación de limpieza entre campañas de color/familia. Subclase de process:Process_Activity y de iso15531:CleaningOperation (patrón de validación R26)."@es;
        rdfs:label       "CleaningOperation"@en;
        rdfs:subClassOf  <http://w3id.org/protys/ontology/process#Process_Activity> , iso15531:CleaningOperation .

<http://w3id.org/protys/ontology/product#Customer>
        rdf:type      owl:Class;
        rdfs:comment  "Cliente que adquiere productos. La asociación Product-Customer se modela como relación binaria muchos-a-muchos (simplificación de ISO 10303-41; no se importan Product_relationship ni Person_organization)."@es;
        rdfs:label    "Customer"@en .

iso15531:precedes  rdf:type  owl:ObjectProperty;
        rdfs:comment  "Precedencia entre lotes u operaciones en la campaña de producción (reglas R17 y patrón R26)."@es;
        rdfs:label    "precedes" .

iso15531:ManufacturingFlow
        rdf:type    owl:Class;
        rdfs:label  "Flujo de manufactura"@es .

<http://w3id.org/protys/ontology/paint-ext#hasCategory>
        rdf:type      owl:ObjectProperty;
        rdfs:comment  "Categoría de impacto de un indicador ambiental."@es;
        rdfs:label    "hasCategory";
        rdfs:range    iso14040:ImpactCategory .

<http://w3id.org/protys/ontology/product#composes>
        rdf:type       owl:ObjectProperty;
        rdfs:comment   "Un Production_Component compone un Product (relación n:n, Fig. 3.8)."@es;
        rdfs:domain    <http://w3id.org/protys/ontology/product#Production_Item> , <http://w3id.org/protys/ontology/product#Thing> , <http://w3id.org/protys/ontology/product#Substance> , <http://w3id.org/protys/ontology/product#Production_Component>;
        rdfs:label     "composes";
        rdfs:range     <http://w3id.org/protys/ontology/product#Product> , <http://w3id.org/protys/ontology/product#Thing> , <http://w3id.org/protys/ontology/product#Production_Item> , iso14040:ProductFlow , <http://w3id.org/protys/ontology/core#Product> , <http://w3id.org/protys/ontology/product#Substance>;
        owl:inverseOf  <http://w3id.org/protys/ontology/product#isComposedOF> .

<http://w3id.org/protys/ontology/core#isHeldBy>
        rdf:type      owl:ObjectProperty;
        rdfs:comment  "Vincula una entidad (típicamente un Resource) con la Enterprise o instalación que la posee o alberga (Figs. 3.6 y 3.7)."@es;
        rdfs:label    "isHeldBy" .

research:FineGrindingOperation
        rdf:type         owl:Class;
        rdfs:subClassOf  iso15531:ProcessOperation , iso14040:AllocationProcedure .

iso15531:CostAttribute
        rdf:type    owl:Class;
        rdfs:label  "Atributo de costo"@es .

alignment:R16_ValidationPattern
        rdf:type      alignment:SPARQLValidationPattern , owl:NamedIndividual;
        rdfs:comment  "Validar consistencia: toda actividad debe consumir al menos un input material. Reformulada como consulta SPARQL ASK con FILTER NOT EXISTS (el built-in swrlb:notBound no existe en SWRL); no es una regla de inferencia. Consulta completa en ontologies/alignment-queries.sparql (R16)."@es;
        rdfs:label    "R16: patrón de validación SPARQL ASK" .

<http://w3id.org/protys/ontology/resource#Equip>
        rdf:type         owl:Class;
        rdfs:comment     "Equipo industrial fijo que ejecuta operaciones de transformación (molinos, reactores, dosificadores). Especialización directa de Resource (Fig. 3.9). Relevante para el caso de estudio del Capítulo 4, donde los equipos de molienda son instancias de Equip."@es;
        rdfs:label       "Equip"@en;
        rdfs:subClassOf  <http://w3id.org/protys/ontology/core#Resource> .

<http://w3id.org/protys/ontology/paint-ext#particleSize>
        rdf:type    owl:DatatypeProperty;
        rdfs:label  "particleSize";
        rdfs:range  xsd:decimal .

<http://w3id.org/protys/ontology/paint-ext#viscosity>
        rdf:type    owl:DatatypeProperty;
        rdfs:label  "viscosity";
        rdfs:range  xsd:decimal .

research:ghgKgCO2e  rdf:type  owl:DatatypeProperty;
        rdfs:range  xsd:decimal .

iso15531:executedBy  rdf:type  owl:ObjectProperty;
        rdfs:comment  "Una WorkOrder es ejecutada por al menos un recurso (restricción del Listado 3.2; también usada por R14 para el operador responsable)."@es;
        rdfs:domain   iso15531:WorkOrder;
        rdfs:domain   [ rdf:type            owl:Restriction;
                        owl:minCardinality  "1"^^xsd:nonNegativeInteger;
                        owl:onProperty      iso15531:executedBy
                      ];
        rdfs:label    "executedBy";
        rdfs:range    iso15531:ManufacturingResource .

iso15531:consumesEnergyKWh
        rdf:type      owl:DatatypeProperty;
