        rdfs:domain   iso15531:Lot;
        rdfs:label    "functionalUnit";
        rdfs:range    xsd:string .

research:providedBy  rdf:type  owl:ObjectProperty .

alignment:R26_ValidationPattern
        rdf:type      alignment:SPARQLValidationPattern , owl:NamedIndividual;
        rdfs:comment  "Detectar riesgo de contaminación cruzada / mapeos puente faltantes cuando no existe operación de limpieza entre campañas incompatibles. Nota: en el Anexo C este patrón aparece bajo el encabezado de R24; reconciliar la numeración R24/R26 en el Anexo C. Reformulada como consulta SPARQL ASK con FILTER NOT EXISTS (el built-in swrlb:notBound no existe en SWRL); no es una regla de inferencia. Consulta completa en ontologies/alignment-queries.sparql (R26)."@es;
        rdfs:label    "R26: patrón de validación SPARQL ASK" .

research:planProduces
        rdf:type  owl:ObjectProperty .

iso15531:ProcessState
        rdf:type    owl:Class;
        rdfs:label  "Estado de proceso"@es .

<http://w3id.org/protys/ontology/resource#Capability>
        rdf:type      owl:Class;
        rdfs:comment  "Capacidad que define a un Resource (ISO 10303-49)."@es;
        rdfs:label    "Capability"@en .

iso15531:TimeAttribute
        rdf:type    owl:Class;
        rdfs:label  "Atributo temporal"@es .

<http://w3id.org/protys/ontology/paint-ext#Consumable>
        rdf:type         owl:Class;
        rdfs:comment     "Material consumible auxiliar. Subclase de resource:Material."@es;
        rdfs:label       "Consumable"@en;
        rdfs:subClassOf  <http://w3id.org/protys/ontology/resource#Material> , <http://w3id.org/protys/ontology/core#Resource> .

iso14040:hasGHGImpactKgCO2e
