        rdf:type      owl:ObjectProperty;
        rdfs:comment  "Especificación de vida útil asociada a un producto."@es;
        rdfs:label    "hasShelfLife" .

research:eventForProcess
        rdf:type  owl:ObjectProperty .

<http://w3id.org/protys/ontology/paint-ext#temperatureCelsius>
        rdf:type    owl:DatatypeProperty;
        rdfs:label  "temperatureCelsius";
        rdfs:range  xsd:decimal .

alignment:var_maintenance
        rdf:type  swrl:Variable .

<http://w3id.org/protys/ontology/paint-ext#solidContent>
        rdf:type    owl:DatatypeProperty;
        rdfs:label  "solidContent";
