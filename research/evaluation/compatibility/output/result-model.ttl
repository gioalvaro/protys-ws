<http://w3id.org/protys/ontology/core#hasProcess>
        rdf:type            owl:ObjectProperty;
        rdfs:comment        "Propiedad de conveniencia: relaciona una entidad con un proceso que contiene o realiza. Subpropiedad de involve para el caso Enterprise-Process."@es;
        rdfs:domain         <http://w3id.org/protys/ontology/core#Enterprise>;
        rdfs:label          "hasProcess";
        rdfs:range          <http://w3id.org/protys/ontology/core#Process>;
        rdfs:subPropertyOf  <http://w3id.org/protys/ontology/core#involve> .

<http://w3id.org/protys/ontology/paint-ext#hasCertification>
