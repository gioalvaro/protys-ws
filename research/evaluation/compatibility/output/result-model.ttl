alignment:var_f1  rdf:type  swrl:Variable .

<http://w3id.org/protys/ontology/core#RequiresRecomputeIndicators>
        rdf:type      owl:Class;
        rdfs:comment  "Factor de caracterización cuyos indicadores dependientes deben recomputarse (cabeza de R25)."@es;
        rdfs:label    "RequiresRecomputeIndicators" .

<http://w3id.org/protys/ontology/process#Process_Plan>
        rdf:type         owl:Class;
        rdfs:comment     "Conjunto ordenado de procesos requeridos para fabricar un producto."@es;
        rdfs:label       "Process_Plan"@en;
        rdfs:subClassOf  [ rdf:type            owl:Restriction;
                           owl:onProperty      <http://w3id.org/protys/ontology/core#isHeldBy>;
                           owl:someValuesFrom  <http://w3id.org/protys/ontology/process#Process_Plant>
                         ] .

alignment:var_unit  rdf:type  swrl:Variable .

iso14040:carbonFootprintKgCO2eq
        rdf:type      owl:DatatypeProperty;
        rdfs:comment  "Huella de carbono en kg CO2-eq por kg de material (usada por las instancias del caso de estudio, Cap. 4)."@es;
        rdfs:label    "carbonFootprintKgCO2eq";
        rdfs:range    xsd:decimal .

iso14040:hasIndicatorValue
        rdf:type                owl:DatatypeProperty;
        rdfs:comment            "Valor numérico de un indicador de impacto (regla R04, Anexo C)."@es;
        rdfs:domain             iso15531:QualityAttribute , iso14040:ImpactIndicator;
        rdfs:label              "hasIndicatorValue";
        rdfs:range              xsd:decimal;
        rdfs:subPropertyOf      iso14040:indicatorValue;
        owl:equivalentProperty  iso14040:indicatorValue .

iso14040:factorValue  rdf:type  owl:DatatypeProperty;
        rdfs:comment  "Valor numérico de un factor de emisión/caracterización (reglas R01 y R21, Anexo C)."@es;
        rdfs:domain   iso14040:CharacterizationFactor;
        rdfs:label    "factorValue";
        rdfs:range    xsd:decimal .

<http://w3id.org/protys/ontology/paint-ext#Warehouse>
        rdf:type         owl:Class;
        rdfs:comment     "Almacén de materias primas/producto terminado. Subclase de enterprise:Shop (área funcional dentro de la fábrica)."@es;
        rdfs:label       "Warehouse"@en;
        rdfs:subClassOf  <http://w3id.org/protys/ontology/enterprise#Shop>;
        rdfs:subClassOf  [ rdf:type            owl:Restriction;
                           owl:onProperty      <http://w3id.org/protys/ontology/enterprise#isPartOf>;
                           owl:someValuesFrom  <http://w3id.org/protys/ontology/enterprise#Factory>
                         ] .

<http://w3id.org/protys/ontology/paint-ext#Formulation>
        rdf:type         owl:Class;
        rdfs:comment     "Fórmula/receta de una pintura. Subclase de product:Instruction: es información funcional sobre cómo fabricar el producto (§3.3.2)."@es;
        rdfs:label       "Formulation"@en;
        rdfs:subClassOf  <http://w3id.org/protys/ontology/product#Product_Information> , <http://w3id.org/protys/ontology/product#Instruction> .

<http://w3id.org/protys/ontology/paint-ext#availabilityPercent>
        rdf:type    owl:DatatypeProperty;
        rdfs:label  "availabilityPercent";
        rdfs:range  xsd:decimal .

[ rdf:type    swrl:Imp;
  rdfs:label  "R23: Razón por operación e indicador vinculados, sin normalización";
  swrl:body   [ rdf:type   swrl:AtomList;
                rdf:first  [ rdf:type             swrl:ClassAtom;
                             swrl:argument1       alignment:var_lot;
                             swrl:classPredicate  iso15531:Lot
                           ];
                rdf:rest   [ rdf:type   swrl:AtomList;
                             rdf:first  [ rdf:type             swrl:ClassAtom;
                                          swrl:argument1       alignment:var_order;
                                          swrl:classPredicate  iso15531:WorkOrder
                                        ];
                             rdf:rest   [ rdf:type   swrl:AtomList;
                                          rdf:first  [ rdf:type                swrl:IndividualPropertyAtom;
                                                       swrl:argument1          alignment:var_order;
                                                       swrl:argument2          alignment:var_lot;
                                                       swrl:propertyPredicate  iso15531:producesLot
                                                     ];
                                          rdf:rest   [ rdf:type   swrl:AtomList;
                                                       rdf:first  [ rdf:type                swrl:IndividualPropertyAtom;
                                                                    swrl:argument1          alignment:var_lot;
                                                                    swrl:argument2          alignment:var_op;
                                                                    swrl:propertyPredicate  iso15531:hasActivity
                                                                  ];
                                                       rdf:rest   [ rdf:type   swrl:AtomList;
                                                                    rdf:first  [ rdf:type                swrl:IndividualPropertyAtom;
                                                                                 swrl:argument1          alignment:var_lot;
                                                                                 swrl:argument2          alignment:var_process;
                                                                                 swrl:propertyPredicate  iso15531:hasProcess
                                                                               ];
                                                                    rdf:rest   [ rdf:type   swrl:AtomList;
                                                                                 rdf:first  [ rdf:type                swrl:IndividualPropertyAtom;
                                                                                              swrl:argument1          alignment:var_op;
                                                                                              swrl:argument2          alignment:var_process;
                                                                                              swrl:propertyPredicate  iso15531:partOfProcess
                                                                                            ];
                                                                                 rdf:rest   [ rdf:type   swrl:AtomList;
                                                                                              rdf:first  [ rdf:type                swrl:DatavaluedPropertyAtom;
                                                                                                           swrl:argument1          alignment:var_op;
                                                                                                           swrl:argument2          alignment:var_time;
                                                                                                           swrl:propertyPredicate  iso15531:cycleTime
                                                                                                         ];
                                                                                              rdf:rest   [ rdf:type   swrl:AtomList;
                                                                                                           rdf:first  [ rdf:type                swrl:IndividualPropertyAtom;
                                                                                                                        swrl:argument1          alignment:var_indicator;
                                                                                                                        swrl:argument2          alignment:var_process;
                                                                                                                        swrl:propertyPredicate  iso14040:computedForProcess
                                                                                                                      ];
                                                                                                           rdf:rest   [ rdf:type   swrl:AtomList;
                                                                                                                        rdf:first  [ rdf:type                swrl:DatavaluedPropertyAtom;
                                                                                                                                     swrl:argument1          alignment:var_indicator;
                                                                                                                                     swrl:argument2          alignment:var_value;
                                                                                                                                     swrl:propertyPredicate  iso14040:indicatorValue
                                                                                                                                   ];
                                                                                                                        rdf:rest   [ rdf:type   swrl:AtomList;
                                                                                                                                     rdf:first  [ rdf:type                swrl:IndividualPropertyAtom;
                                                                                                                                                  swrl:argument1          alignment:var_ratio;
                                                                                                                                                  swrl:argument2          alignment:var_op;
                                                                                                                                                  swrl:propertyPredicate  research:forOperation
                                                                                                                                                ];
                                                                                                                                     rdf:rest   [ rdf:type   swrl:AtomList;
                                                                                                                                                  rdf:first  [ rdf:type                swrl:IndividualPropertyAtom;
                                                                                                                                                               swrl:argument1          alignment:var_ratio;
                                                                                                                                                               swrl:argument2          alignment:var_indicator;
                                                                                                                                                               swrl:propertyPredicate  research:forIndicator
                                                                                                                                                             ];
                                                                                                                                                  rdf:rest   [ rdf:type   swrl:AtomList;
                                                                                                                                                               rdf:first  [ rdf:type        swrl:BuiltinAtom;
                                                                                                                                                                            swrl:arguments  [ rdf:type   rdf:List;
                                                                                                                                                                                              rdf:first  alignment:var_value;
                                                                                                                                                                                              rdf:rest   [ rdf:type   rdf:List;
                                                                                                                                                                                                           rdf:first  "0"^^xsd:decimal;
                                                                                                                                                                                                           rdf:rest   ()
                                                                                                                                                                                                         ]
                                                                                                                                                                                            ];
                                                                                                                                                                            swrl:builtin    swrlb:greaterThan
                                                                                                                                                                          ];
                                                                                                                                                               rdf:rest   [ rdf:type   swrl:AtomList;
                                                                                                                                                                            rdf:first  [ rdf:type        swrl:BuiltinAtom;
                                                                                                                                                                                         swrl:arguments  ( alignment:var_result alignment:var_time alignment:var_value );
                                                                                                                                                                                         swrl:builtin    swrlb:divide
                                                                                                                                                                                       ];
                                                                                                                                                                            rdf:rest   ()
                                                                                                                                                                          ]
                                                                                                                                                             ]
                                                                                                                                                ]
                                                                                                                                   ]
                                                                                                                      ]
                                                                                                         ]
                                                                                            ]
                                                                               ]
                                                                  ]
                                                     ]
                                        ]
                           ]
              ];
  swrl:head   [ rdf:type   swrl:AtomList;
                rdf:first  [ rdf:type                swrl:DatavaluedPropertyAtom;
                             swrl:argument1          alignment:var_ratio;
                             swrl:argument2          alignment:var_result;
                             swrl:propertyPredicate  research:operationIndicatorRatio
                           ];
                rdf:rest   ()
              ]
] .

<http://w3id.org/protys/ontology/core#WaterFlow>
        rdf:type                       iso15531:ManufacturingResource , iso14040:ElementaryFlow , owl:NamedIndividual;
        rdf:type                       [ rdf:type        owl:Restriction;
                                         owl:hasValue    alignment:Consumed;
                                         owl:onProperty  iso15531:resourceCurrentState
                                       ];
        rdf:type                       [ rdf:type            owl:Class;
                                         owl:intersectionOf  ( iso15531:ManufacturingResource
                                                               [ rdf:type        owl:Restriction;
                                                                 owl:hasValue    alignment:Consumed;
                                                                 owl:onProperty  iso15531:resourceCurrentState
                                                               ]
                                                             )
                                       ];
        rdfs:comment                   "Flujo elemental de agua (cabeza de R02; IRI protys:WaterFlow tal como figura en el Anexo C)."@es;
        iso15531:resourceCurrentState  alignment:Consumed .

<http://w3id.org/protys/ontology/paint-ext#numberOfEmployees>
        rdf:type    owl:DatatypeProperty;
        rdfs:label  "numberOfEmployees";
        rdfs:range  xsd:integer .

<http://w3id.org/protys/ontology/core#precedes>
        rdf:type      owl:ObjectProperty;
        rdfs:comment  "Orden entre procesos: un Process precede a otro Process en el plan de proceso."@es;
        rdfs:domain   <http://w3id.org/protys/ontology/core#Process>;
        rdfs:label    "precedes";
        rdfs:range    <http://w3id.org/protys/ontology/core#Process> .

iso15531:skillCode  rdf:type  owl:DatatypeProperty;
        rdfs:comment  "Código de habilidad de un recurso humano (instancias del caso de estudio, Cap. 4)."@es;
        rdfs:domain   iso15531:ManufacturingResource , iso15531:HumanResource;
        rdfs:label    "skillCode";
        rdfs:range    xsd:string .

<http://w3id.org/protys/ontology/product#definedBy>
        rdf:type      owl:ObjectProperty;
        rdfs:comment  "Un Production_Item está definido por su Product_Information (agregación 1..n, Fig. 3.8)."@es;
        rdfs:domain   <http://w3id.org/protys/ontology/product#Thing> , <http://w3id.org/protys/ontology/product#Substance> , <http://w3id.org/protys/ontology/product#Production_Item>;
        rdfs:label    "definedBy";
        rdfs:range    <http://w3id.org/protys/ontology/product#Product_Information> .

alignment:hasEcoScore
        rdf:type      owl:DatatypeProperty;
        rdfs:comment  "EcoScore normalizado por lote (cabeza de R23, Listado 3.4)."@es;
        rdfs:label    "hasEcoScore";
        rdfs:range    xsd:decimal .

<http://w3id.org/protys/ontology/core#modifiedInVersion>
        rdf:type      owl:DatatypeProperty;
        rdfs:comment  "Versión en la que un término fue modificado (usada por R25, versionado P5)."@es;
        rdfs:label    "modifiedInVersion";
        rdfs:range    xsd:string .

[ rdf:type    swrl:Imp;
  rdfs:label  "R13: Precedencia de eventos MES del mismo lote y proceso";
  swrl:body   [ rdf:type   swrl:AtomList;
                rdf:first  [ rdf:type             swrl:ClassAtom;
                             swrl:argument1       alignment:var_e1;
                             swrl:classPredicate  iso15531:ManufacturingData
                           ];
                rdf:rest   [ rdf:type   swrl:AtomList;
                             rdf:first  [ rdf:type             swrl:ClassAtom;
                                          swrl:argument1       alignment:var_e2;
                                          swrl:classPredicate  iso15531:ManufacturingData
                                        ];
                             rdf:rest   [ rdf:type   swrl:AtomList;
                                          rdf:first  [ rdf:type                swrl:IndividualPropertyAtom;
                                                       swrl:argument1          alignment:var_e1;
                                                       swrl:argument2          alignment:var_lot;
                                                       swrl:propertyPredicate  research:forLot
                                                     ];
                                          rdf:rest   [ rdf:type   swrl:AtomList;
                                                       rdf:first  [ rdf:type                swrl:IndividualPropertyAtom;
                                                                    swrl:argument1          alignment:var_e2;
                                                                    swrl:argument2          alignment:var_lot;
                                                                    swrl:propertyPredicate  research:forLot
                                                                  ];
                                                       rdf:rest   [ rdf:type   swrl:AtomList;
                                                                    rdf:first  [ rdf:type                swrl:IndividualPropertyAtom;
                                                                                 swrl:argument1          alignment:var_e1;
                                                                                 swrl:argument2          alignment:var_process;
                                                                                 swrl:propertyPredicate  research:eventForProcess
                                                                               ];
                                                                    rdf:rest   [ rdf:type   swrl:AtomList;
                                                                                 rdf:first  [ rdf:type                swrl:IndividualPropertyAtom;
                                                                                              swrl:argument1          alignment:var_e2;
                                                                                              swrl:argument2          alignment:var_process;
                                                                                              swrl:propertyPredicate  research:eventForProcess
                                                                                            ];
                                                                                 rdf:rest   [ rdf:type   swrl:AtomList;
                                                                                              rdf:first  [ rdf:type                swrl:DatavaluedPropertyAtom;
                                                                                                           swrl:argument1          alignment:var_e1;
                                                                                                           swrl:argument2          alignment:var_t1;
                                                                                                           swrl:propertyPredicate  research:eventTimeSeconds
                                                                                                         ];
                                                                                              rdf:rest   [ rdf:type   swrl:AtomList;
                                                                                                           rdf:first  [ rdf:type                swrl:DatavaluedPropertyAtom;
                                                                                                                        swrl:argument1          alignment:var_e2;
                                                                                                                        swrl:argument2          alignment:var_t2;
                                                                                                                        swrl:propertyPredicate  research:eventTimeSeconds
                                                                                                                      ];
                                                                                                           rdf:rest   [ rdf:type   swrl:AtomList;
                                                                                                                        rdf:first  [ rdf:type        swrl:BuiltinAtom;
                                                                                                                                     swrl:arguments  ( alignment:var_t1 alignment:var_t2 );
                                                                                                                                     swrl:builtin    swrlb:lessThan
                                                                                                                                   ];
                                                                                                                        rdf:rest   ()
                                                                                                                      ]
                                                                                                         ]
                                                                                            ]
                                                                               ]
                                                                  ]
                                                     ]
                                        ]
                           ]
              ];
  swrl:head   [ rdf:type   swrl:AtomList;
                rdf:first  [ rdf:type                swrl:IndividualPropertyAtom;
                             swrl:argument1          alignment:var_e1;
                             swrl:argument2          alignment:var_e2;
                             swrl:propertyPredicate  iso15531:precedesEvent
                           ];
                rdf:rest   ()
              ]
] .

iso15531:yield  rdf:type  owl:DatatypeProperty;
        rdfs:comment  "Rendimiento de una actividad (regla R11, Anexo C)."@es;
        rdfs:label    "yield";
        rdfs:range    xsd:decimal .

<http://w3id.org/protys/ontology/resource#requiresResource>
        rdf:type      owl:ObjectProperty;
        rdfs:comment  "La actividad requiere el recurso pero no necesariamente lo ejecuta (Fig. 3.11)."@es;
        rdfs:domain   <http://w3id.org/protys/ontology/resource#Activity>;
        rdfs:label    "requiresResource";
        rdfs:range    <http://w3id.org/protys/ontology/core#Resource> .

alignment:var_plan  rdf:type  swrl:Variable .

<http://w3id.org/protys/ontology/paint-ext#Intermediate_Product>
        rdf:type         owl:Class;
        rdfs:comment     "Producto intermedio (p. ej., pasta de pigmento). Subclase de core:Product: es un producto en un estadio intermedio del plan de proceso."@es;
        rdfs:label       "Intermediate_Product"@en;
        rdfs:subClassOf  <http://w3id.org/protys/ontology/core#Product> .

research:waterL  rdf:type  owl:DatatypeProperty;
        rdfs:range  xsd:decimal .

alignment:impactThreshold
        rdf:type      owl:DatatypeProperty;
        rdfs:comment  "Umbral configurable de impacto (usado por R04 sobre el individuo align:GlobalConfig)."@es;
        rdfs:label    "impactThreshold";
        rdfs:range    xsd:decimal .

iso15531:producesLot  rdf:type  owl:ObjectProperty;
        rdfs:comment  "Una WorkOrder produce un Lot (reglas R03 y R23, Listado 3.4)."@es;
        rdfs:domain   iso15531:WorkOrder;
        rdfs:domain   [ rdf:type            owl:Restriction;
                        owl:minCardinality  "1"^^xsd:nonNegativeInteger;
                        owl:onProperty      iso15531:executedBy
                      ];
        rdfs:label    "producesLot";
        rdfs:range    iso15531:Lot .

research:energyKWh  rdf:type  owl:DatatypeProperty;
        rdfs:range  xsd:decimal .

iso14040:AllocationProcedure
        rdf:type             owl:Class;
        rdfs:label           "Procedimiento de asignación"@es;
        rdfs:subClassOf      iso15531:ProcessOperation;
        owl:equivalentClass  iso15531:ProcessOperation .

iso15531:ProductionOrder
        rdf:type    owl:Class;
        rdfs:label  "Orden de producción"@es .

research:operationIndicatorRatio
        rdf:type    owl:DatatypeProperty;
        rdfs:range  xsd:decimal .

[ rdf:type    swrl:Imp;
  rdfs:label  "R15: Marcar indisponibilidad temporal con mantenimiento registrado";
  swrl:body   [ rdf:type   swrl:AtomList;
                rdf:first  [ rdf:type             swrl:ClassAtom;
                             swrl:argument1       alignment:var_resource;
                             swrl:classPredicate  iso15531:ManufacturingResource
                           ];
                rdf:rest   [ rdf:type   swrl:AtomList;
                             rdf:first  [ rdf:type                swrl:IndividualPropertyAtom;
                                          swrl:argument1          alignment:var_resource;
                                          swrl:argument2          alignment:var_maintenance;
                                          swrl:propertyPredicate  iso15531:hasMaintenance
                                        ];
                             rdf:rest   ()
                           ]
              ];
  swrl:head   [ rdf:type   swrl:AtomList;
                rdf:first  [ rdf:type             swrl:ClassAtom;
                             swrl:argument1       alignment:var_resource;
                             swrl:classPredicate  iso15531:temporarilyUnavailable
                           ];
                rdf:rest   ()
              ]
] .

alignment:FineGrinding
        rdf:type      iso15531:ManufacturingCapability , owl:NamedIndividual;
        rdfs:comment  "Capacidad de molienda fina (cabeza de R12, Listado 3.4)."@es .

iso15531:temporarilyUnavailable
        rdf:type         owl:Class;
        rdfs:comment     "Recurso temporalmente no disponible (cabeza de R15; IRI tal como figura en el Anexo C)."@es;
        rdfs:label       "temporarilyUnavailable";
        rdfs:subClassOf  iso15531:ManufacturingResource .

<http://w3id.org/protys/ontology/process#hasParameter>
        rdf:type      owl:ObjectProperty;
        rdfs:comment  "Procedure y Procedure_Activity están vinculados a Parameters (agregación, Fig. 3.7)."@es;
        rdfs:domain   [ rdf:type     owl:Class;
                        owl:unionOf  ( <http://w3id.org/protys/ontology/process#Procedure> <http://w3id.org/protys/ontology/process#Procedure_Activity> )
                      ];
        rdfs:label    "hasParameter";
        rdfs:range    <http://w3id.org/protys/ontology/process#Parameters> .

<http://w3id.org/protys/ontology/paint-ext#belongsTo>
        rdf:type            owl:ObjectProperty;
        rdfs:comment        "Pertenencia de un recurso/actividad a una unidad organizacional. Subpropiedad de core:isHeldBy."@es;
        rdfs:label          "belongsTo";
        rdfs:subPropertyOf  <http://w3id.org/protys/ontology/core#isHeldBy> .

iso15531:executesActivity
        rdf:type      owl:ObjectProperty;
        rdfs:comment  "Una orden de trabajo (ejecución de actividad) ejecuta una operación (regla R14, Anexo C)."@es;
        rdfs:domain   iso15531:WorkOrder;
        rdfs:domain   [ rdf:type            owl:Restriction;
                        owl:minCardinality  "1"^^xsd:nonNegativeInteger;
                        owl:onProperty      iso15531:executedBy
                      ];
        rdfs:label    "executesActivity";
        rdfs:range    iso15531:ProcessOperation , iso14040:AllocationProcedure .

iso15531:experienceYears
        rdf:type      owl:DatatypeProperty;
        rdfs:comment  "Años de experiencia de un recurso humano (instancias del caso de estudio, Cap. 4)."@es;
        rdfs:domain   iso15531:ManufacturingResource , iso15531:HumanResource;
        rdfs:label    "experienceYears";
        rdfs:range    xsd:integer .

<http://w3id.org/protys/ontology/paint-ext#ProductionCell>
        rdf:type         owl:Class;
        rdfs:comment     "Célula de producción. Subclase de enterprise:Cell."@es;
        rdfs:label       "ProductionCell"@en;
        rdfs:subClassOf  <http://w3id.org/protys/ontology/enterprise#Cell>;
        rdfs:subClassOf  [ rdf:type            owl:Restriction;
                           owl:onProperty      <http://w3id.org/protys/ontology/enterprise#isPartOf>;
                           owl:someValuesFrom  <http://w3id.org/protys/ontology/enterprise#Shop>
                         ] .

iso14040:waterFootprintLiters
        rdf:type      owl:DatatypeProperty;
        rdfs:comment  "Huella hídrica en litros (usada por las instancias del caso de estudio, Cap. 4)."@es;
        rdfs:label    "waterFootprintLiters";
        rdfs:range    xsd:decimal .

research:scenarioRole
        rdf:type    owl:DatatypeProperty;
        rdfs:range  xsd:string .

iso14040:LCAStudy  rdf:type  owl:Class;
        rdfs:label       "Estudio de ACV"@es;
        rdfs:subClassOf  [ rdf:type         owl:Restriction;
                           owl:cardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onProperty   iso14040:hasFunctionalUnit
                         ] .

iso15531:hasQualityStatus
        rdf:type      owl:DatatypeProperty;
        rdfs:comment  "Estado de calidad de un lote (regla R10, Anexo C)."@es;
        rdfs:domain   iso15531:Lot;
        rdfs:label    "hasQualityStatus";
        rdfs:range    xsd:string .

<http://w3id.org/protys/ontology/paint-ext#establishedDate>
        rdf:type    owl:DatatypeProperty;
        rdfs:label  "establishedDate";
        rdfs:range  xsd:dateTime .

<http://w3id.org/protys/ontology/product#acquiredBy>
        rdf:type      owl:ObjectProperty;
        rdfs:comment  "Un producto puede ser adquirido por múltiples clientes y un cliente puede adquirir varios productos (relación n:n)."@es;
        rdfs:domain   <http://w3id.org/protys/ontology/product#Production_Item> , <http://w3id.org/protys/ontology/core#Product> , <http://w3id.org/protys/ontology/product#Substance> , <http://w3id.org/protys/ontology/product#Thing> , iso14040:ProductFlow , <http://w3id.org/protys/ontology/product#Product>;
        rdfs:label    "acquiredBy";
        rdfs:range    <http://w3id.org/protys/ontology/product#Customer> .

<http://w3id.org/protys/ontology/paint-ext#employs>
        rdf:type      owl:ObjectProperty;
        rdfs:comment  "Una organización emplea personas."@es;
        rdfs:label    "employs";
        rdfs:range    <http://w3id.org/protys/ontology/resource#Person> , <http://w3id.org/protys/ontology/core#Resource> .

alignment:var_result  rdf:type  swrl:Variable .

iso15531:HumanResource
        rdf:type         owl:Class;
        rdfs:label       "Recurso humano"@es;
        rdfs:subClassOf  iso15531:ManufacturingResource .

iso15531:requiresReprocess
        rdf:type         owl:Class;
        rdfs:comment     "Lote que requiere reproceso (cabeza de R18; IRI tal como figura en el Anexo C)."@es;
        rdfs:label       "requiresReprocess";
        rdfs:subClassOf  iso15531:Lot .

<http://w3id.org/protys/ontology/paint-ext#Organization>
        rdf:type         owl:Class;
        rdfs:comment     "Organización empresarial (mapeada desde AD_Org de ADempiere / res.company de Odoo). Subclase de core:Enterprise."@es;
        rdfs:label       "Organization"@en;
        rdfs:subClassOf  <http://w3id.org/protys/ontology/core#Enterprise> .

<http://w3id.org/protys/ontology/paint-ext#ProductBatch>
        rdf:type         owl:Class;
        rdfs:comment     "Lote de producto fabricado. Subclase de iso15531:Lot: el lote es el concepto MANDATE canónico de agrupación de producción."@es;
        rdfs:label       "ProductBatch"@en;
        rdfs:subClassOf  iso15531:Lot .

[ rdf:type    swrl:Imp;
  rdfs:label  "R24: Marcar brecha de cobertura desde faltante ambiental detectado";
  swrl:body   [ rdf:type   swrl:AtomList;
                rdf:first  [ rdf:type             swrl:ClassAtom;
                             swrl:argument1       alignment:var_process;
                             swrl:classPredicate  <http://w3id.org/protys/ontology/core#MissingEnvironmentalData>
                           ];
                rdf:rest   ()
              ];
  swrl:head   [ rdf:type   swrl:AtomList;
                rdf:first  [ rdf:type             swrl:ClassAtom;
                             swrl:argument1       alignment:var_process;
                             swrl:classPredicate  <http://w3id.org/protys/ontology/core#CoverageGap>
                           ];
                rdf:rest   ()
              ]
] .

[ rdf:type            owl:Class;
  rdfs:subClassOf     iso14040:ElementaryFlow;
  owl:intersectionOf  ( iso15531:ManufacturingResource
                        [ rdf:type        owl:Restriction;
                          owl:hasValue    alignment:Consumed;
                          owl:onProperty  iso15531:resourceCurrentState
                        ]
                      )
] .

iso15531:WorkOrder  rdf:type  owl:Class;
        rdfs:label       "Orden de trabajo"@es;
        rdfs:subClassOf  [ rdf:type            owl:Restriction;
                           owl:minCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onProperty      iso15531:executedBy
                         ] .

iso14040:hasFunctionalUnit
        rdf:type      owl:FunctionalProperty , owl:ObjectProperty;
        rdfs:comment  "Todo estudio de ACV tiene exactamente una unidad funcional (Listado 3.1)."@es;
        rdfs:domain   iso14040:LCAStudy;
        rdfs:domain   [ rdf:type         owl:Restriction;
                        owl:cardinality  "1"^^xsd:nonNegativeInteger;
                        owl:onProperty   iso14040:hasFunctionalUnit
                      ];
        rdfs:label    "hasFunctionalUnit";
        rdfs:range    iso14040:FunctionalUnit .

iso15531:propagatedQualityStatus
        rdf:type      owl:DatatypeProperty;
        rdfs:comment  "Estado de calidad propagado desde el lote hacia el producto final (cabeza de la regla R10, Anexo C)."@es;
        rdfs:label    "propagatedQualityStatus";
        rdfs:range    xsd:string .

<http://w3id.org/protys/ontology/paint-ext#EnergyResource>
        rdf:type         owl:Class;
        rdfs:comment     "Recurso energético consumido por las actividades. Subclase directa de core:Resource (no es Tool/Equip/Device ni Material sólido)."@es;
        rdfs:label       "EnergyResource"@en;
        rdfs:subClassOf  <http://w3id.org/protys/ontology/core#Resource> .

research:startTimeSeconds
        rdf:type    owl:DatatypeProperty;
        rdfs:range  xsd:decimal .

iso14040:refersToMaterial
        rdf:type      owl:ObjectProperty;
        rdfs:comment  "Un flujo de inventario refiere a un material concreto (reglas R06 y R20, Anexo C)."@es;
        rdfs:domain   iso15531:ManufacturingResource , iso14040:ElementaryFlow;
        rdfs:domain   [ rdf:type        owl:Restriction;
                        owl:hasValue    alignment:Consumed;
                        owl:onProperty  iso15531:resourceCurrentState
                      ];
        rdfs:domain   [ rdf:type            owl:Class;
                        owl:intersectionOf  ( iso15531:ManufacturingResource
                                              [ rdf:type        owl:Restriction;
                                                owl:hasValue    alignment:Consumed;
                                                owl:onProperty  iso15531:resourceCurrentState
                                              ]
                                            )
                      ];
        rdfs:label    "refersToMaterial" .

<http://w3id.org/protys/ontology/resource#Product_Related_File>
        rdf:type         owl:Class;
        rdfs:comment     "Archivo relacionado con productos, p. ej. diseños CAD (Fig. 3.12)."@es;
        rdfs:label       "Product_Related_File"@en;
        rdfs:subClassOf  <http://w3id.org/protys/ontology/resource#File> , <http://w3id.org/protys/ontology/core#Resource> .

iso14040:GoalAndScopeDefinition
        rdf:type    owl:Class;
        rdfs:label  "Definición de objetivo y alcance"@es .

alignment:var_equipment
        rdf:type  swrl:Variable .

iso15531:QualityAttribute
        rdf:type         owl:Class;
        rdfs:label       "Atributo de calidad"@es;
        rdfs:subClassOf  iso14040:ImpactIndicator .

<http://w3id.org/protys/ontology/paint-ext#batchQuantity>
        rdf:type    owl:DatatypeProperty;
        rdfs:label  "batchQuantity";
        rdfs:range  xsd:decimal .
