    <!-- http://w3id.org/protys/ontology/alignment#hasEmittedFlow -->

    <owl:ObjectProperty rdf:about="http://w3id.org/protys/ontology/alignment#hasEmittedFlow">
        <rdfs:range rdf:resource="http://w3id.org/protys/ontology/iso15531#ManufacturingResource"/>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://w3id.org/protys/ontology/iso15531#ManufacturingResource"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://w3id.org/protys/ontology/iso15531#resourceCurrentState"/>
                        <owl:hasValue rdf:resource="http://w3id.org/protys/ontology/alignment#Consumed"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:range>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/protys/ontology/iso15531#resourceCurrentState"/>
                <owl:hasValue rdf:resource="http://w3id.org/protys/ontology/alignment#Consumed"/>
            </owl:Restriction>
        </rdfs:range>
    </owl:ObjectProperty>
    


