    <!-- http://w3id.org/protys/fixture#flow -->

    <owl:NamedIndividual rdf:about="http://w3id.org/protys/fixture#flow">
        <rdf:type rdf:resource="http://w3id.org/protys/ontology/iso15531#ManufacturingResource"/>
        <rdf:type>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://w3id.org/protys/ontology/iso15531#ManufacturingResource"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://w3id.org/protys/ontology/iso15531#resourceCurrentState"/>
                        <owl:hasValue rdf:resource="http://w3id.org/protys/ontology/alignment#Consumed"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdf:type>
        <rdf:type>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/protys/ontology/iso15531#resourceCurrentState"/>
                <owl:hasValue rdf:resource="http://w3id.org/protys/ontology/alignment#Consumed"/>
            </owl:Restriction>
        </rdf:type>
        <iso15531:resourceCurrentState rdf:resource="http://w3id.org/protys/ontology/alignment#Consumed"/>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/protys/fixture#indicator -->

    <owl:NamedIndividual rdf:about="http://w3id.org/protys/fixture#indicator">
        <rdf:type rdf:resource="http://w3id.org/protys/ontology/core#HighImpactIndicator"/>
        <rdf:type rdf:resource="http://w3id.org/protys/ontology/iso15531#QualityAttribute"/>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/protys/fixture#lot -->

    <owl:NamedIndividual rdf:about="http://w3id.org/protys/fixture#lot">
        <alignment:hasEmittedFlow rdf:resource="http://w3id.org/protys/fixture#flow"/>
        <research:hasGHGContribution rdf:resource="http://w3id.org/protys/fixture#op"/>
