# QC17 (consulta complementaria, fuera del catálogo Q01-Q21)
# Pregunta: ¿Qué procesos presentan una brecha de cobertura ambiental?
# R24: Marcar brecha de cobertura desde faltante ambiental detectado. Clase brecha de cobertura desde core:MissingEnvironmentalData
PREFIX i: <http://w3id.org/protys/ontology/iso15531#>
PREFIX e: <http://w3id.org/protys/ontology/iso14040#>
PREFIX c: <http://w3id.org/protys/ontology/core#>
PREFIX a: <http://w3id.org/protys/ontology/alignment#>
PREFIX t: <http://w3id.org/protys/ontology/research#>
SELECT DISTINCT ?process WHERE { ?process a c:CoverageGap . } ORDER BY ?process
