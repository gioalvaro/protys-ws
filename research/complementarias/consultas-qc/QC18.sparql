# QC18 (consulta complementaria, fuera del catálogo Q01-Q21)
# Pregunta: ¿Qué factores de emisión modificados requieren recalcular los indicadores?
# R25: Marcar factor modificado que requiere recálculo. Clase requiere recálculo; sin recalcular el valor
PREFIX i: <http://w3id.org/protys/ontology/iso15531#>
PREFIX e: <http://w3id.org/protys/ontology/iso14040#>
PREFIX c: <http://w3id.org/protys/ontology/core#>
PREFIX a: <http://w3id.org/protys/ontology/alignment#>
PREFIX t: <http://w3id.org/protys/ontology/research#>
SELECT DISTINCT ?factor WHERE { ?factor a c:RequiresRecomputeIndicators . } ORDER BY ?factor
