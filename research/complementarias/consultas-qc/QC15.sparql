# QC15 (consulta complementaria, fuera del catálogo Q01-Q21)
# Pregunta: ¿Qué recursos cuello de botella son puntos críticos por un indicador alto de su proceso?
# R22: Hotspot vinculado al mismo proceso y recurso cuello de botella. Clase hotspot; cuello de botella declarado como entrada
PREFIX i: <http://w3id.org/protys/ontology/iso15531#>
PREFIX e: <http://w3id.org/protys/ontology/iso14040#>
PREFIX c: <http://w3id.org/protys/ontology/core#>
PREFIX a: <http://w3id.org/protys/ontology/alignment#>
PREFIX t: <http://w3id.org/protys/ontology/research#>
SELECT DISTINCT ?resource WHERE { ?resource a c:Hotspot . } ORDER BY ?resource
