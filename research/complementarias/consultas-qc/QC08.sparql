# QC08 (consulta complementaria, fuera del catálogo Q01-Q21)
# Pregunta: ¿Qué eficiencia (rendimiento sobre duración) tiene cada operación con duración positiva?
# R11: Razón rendimiento sobre duración positiva de operación. %/min; razón de rendimiento másico sobre duración
PREFIX i: <http://w3id.org/protys/ontology/iso15531#>
PREFIX e: <http://w3id.org/protys/ontology/iso14040#>
PREFIX c: <http://w3id.org/protys/ontology/core#>
PREFIX a: <http://w3id.org/protys/ontology/alignment#>
PREFIX t: <http://w3id.org/protys/ontology/research#>
SELECT DISTINCT ?operation ?efficiency WHERE { ?operation a:hasEfficiency ?efficiency . } ORDER BY ?operation ?efficiency
