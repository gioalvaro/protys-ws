# QC10 (consulta complementaria, fuera del catálogo Q01-Q21)
# Pregunta: ¿Qué eventos de fabricación preceden a otro del mismo lote y proceso?
# R13: Precedencia de eventos MES del mismo lote y proceso. Segundos desde origen común, mismo lote/proceso
PREFIX i: <http://w3id.org/protys/ontology/iso15531#>
PREFIX e: <http://w3id.org/protys/ontology/iso14040#>
PREFIX c: <http://w3id.org/protys/ontology/core#>
PREFIX a: <http://w3id.org/protys/ontology/alignment#>
PREFIX t: <http://w3id.org/protys/ontology/research#>
SELECT DISTINCT ?earlier ?later WHERE { ?earlier i:precedesEvent ?later . } ORDER BY ?earlier ?later
