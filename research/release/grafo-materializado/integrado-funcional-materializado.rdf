    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://w3id.org/protys/ontology/alignment#SPARQLValidationPattern"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/protys/ontology/core#Resource">
