        rdf:type         owl:Class;
        rdfs:comment     "Organización empresarial (mapeada desde AD_Org de ADempiere / res.company de Odoo). Subclase de core:Enterprise."@es;
        rdfs:label       "Organization"@en;
        rdfs:subClassOf  core:Enterprise .

paint-ext:ProductBatch
        rdf:type         owl:Class;
        rdfs:comment     "Lote de producto fabricado. Subclase de iso15531:Lot: el lote es el concepto MANDATE canónico de agrupación de producción."@es;
        rdfs:label       "ProductBatch"@en;
        rdfs:subClassOf  iso15531:Lot .

<http://w3id.org/protys/fixture#BatchZero_Op2_Ratio>
        rdf:type               research:RatioObservation , owl:NamedIndividual , owl:Thing;
        research:forIndicator  <http://w3id.org/protys/fixture#BatchZero_Indicator>;
        research:forOperation  <http://w3id.org/protys/fixture#BatchZero_Op2> .

<http://w3id.org/protys/fixture#BatchB_Op2_Subload2>
        rdf:type                     research:Subload , owl:NamedIndividual , owl:Thing;
        research:endTimeSeconds      "22400"^^xsd:decimal;
        research:startTimeSeconds    "21800"^^xsd:decimal;
        research:subloadDurationMinutes
                "10"^^xsd:decimal;
        research:subloadOfOperation  <http://w3id.org/protys/fixture#BatchB_Op2>;
        research:subloadVolumeL      "50"^^xsd:decimal .

iso15531:WorkOrder  rdf:type  owl:Class;
        rdfs:label       "Orden de trabajo"@es;
        rdfs:subClassOf  owl:Thing;
        rdfs:subClassOf  [ rdf:type            owl:Restriction;
                           owl:minCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onProperty      iso15531:executedBy
                         ] .

iso15531:propagatedQualityStatus
        rdf:type      owl:DatatypeProperty;
        rdfs:comment  "Estado de calidad registrado como propagable sobre el mismo lote (R10); no crea ni modifica el producto final."@es;
        rdfs:label    "propagatedQualityStatus";
        rdfs:range    xsd:string .

iso14040:hasFunctionalUnit
        rdf:type      owl:FunctionalProperty , owl:ObjectProperty;
        rdfs:comment  "Propiedad funcional: como máximo una unidad funcional por sujeto. La clase LCAStudy incorpora además una cardinalidad exacta1; bajo mundo abierto eso no prueba que exista un registro nombrado completo en la instantánea."@es;
        rdfs:domain   iso14040:LCAStudy;
        rdfs:domain   [ rdf:type         owl:Restriction;
                        owl:cardinality  "1"^^xsd:nonNegativeInteger;
                        owl:onProperty   iso14040:hasFunctionalUnit
                      ];
        rdfs:label    "hasFunctionalUnit";
        rdfs:range    iso14040:FunctionalUnit .

<http://w3id.org/protys/fixture#BatchC_Indicator>
        rdf:type                     owl:Thing , owl:NamedIndividual , iso14040:ImpactIndicator , core:HighImpactIndicator;
        alignment:indicatorForLot    <http://w3id.org/protys/fixture#BatchC>;
        iso14040:computedForProcess  <http://w3id.org/protys/fixture#BatchC_LCIProcess>;
        iso14040:hasIndicatorValue   57.6666665;
        iso14040:indicatorValue      57.6666665;
        research:hasThreshold        <http://w3id.org/protys/fixture#ElectricityGHGThreshold>;
        research:indicatorCategory   "GHG_ELECTRICITY_PRODUCTION";
        research:indicatorForLot     <http://w3id.org/protys/fixture#BatchC>;
        research:scenarioRole        "Valor fuente calculado por generador como suma eléctrica de operaciones; cotejado con agregaciónSPARQL de contribucionesSWRL, no suma inferida porSWRL";
        research:unit                "kg CO2e";
        research:usesEmissionFactor  <http://w3id.org/protys/fixture#GridFactor>;
        owl:differentFrom            <http://w3id.org/protys/fixture#BatchC_QualityRecord> .

paint-ext:EnergyResource
        rdf:type         owl:Class;
        rdfs:comment     "Recurso energético consumido por las actividades. Subclase directa de core:Resource (no es Tool/Equip/Device ni Material sólido)."@es;
        rdfs:label       "EnergyResource"@en;
        rdfs:subClassOf  core:Resource .

alignment:indicatorForLot
        rdf:type      owl:ObjectProperty;
        rdfs:comment  "Environmental indicator and quality record independently refer to the same lot via indicatorForLot and qualityForLot. Their values and types remain distinct.";
        rdfs:domain   iso14040:ImpactIndicator;
        rdfs:range    iso15531:Lot .

research:startTimeSeconds
        rdf:type    owl:DatatypeProperty;
        rdfs:range  xsd:decimal .

<http://w3id.org/protys/fixture#BatchC_Flow_AcrylicResin>
        rdf:type                        owl:Thing , iso14040:ProductFlow , owl:NamedIndividual;
        rdf:type                        [ rdf:type     owl:Class;
                                          owl:unionOf  ( iso14040:ElementaryFlow iso14040:ProductFlow )
                                        ];
        alignment:flowRefersToProduct   <http://w3id.org/protys/fixture#AcrylicResin>;
        alignment:inputFlowForResource  <http://w3id.org/protys/fixture#AcrylicResin>;
        core:bridgesFlowToActivity      <http://w3id.org/protys/fixture#BatchC_Op7> , <http://w3id.org/protys/fixture#BatchC_Op2> , <http://w3id.org/protys/fixture#BatchC_Op4> , <http://w3id.org/protys/fixture#BatchC_Op6> , <http://w3id.org/protys/fixture#BatchC_Op1> , <http://w3id.org/protys/fixture#BatchC_Op3> , <http://w3id.org/protys/fixture#BatchC_Op5>;
        iso14040:refersToMaterial       <http://w3id.org/protys/fixture#AcrylicResin>;
        research:belongsToProcess       <http://w3id.org/protys/fixture#BatchC_Process>;
        research:flowRefersToProduct    <http://w3id.org/protys/fixture#AcrylicResin>;
        research:inputFlowForResource   <http://w3id.org/protys/fixture#AcrylicResin>;
        research:materialQuantityKg     37.5;
        research:unit                   "kg";
        research:usesEmissionFactor     <http://w3id.org/protys/fixture#AcrylicResin_Factor> .

iso14040:refersToMaterial
        rdf:type      owl:ObjectProperty;
        rdfs:comment  "Un flujo de inventario refiere a un material concreto (reglas R06 y R20)."@es;
        rdfs:domain   [ rdf:type     owl:Class;
                        owl:unionOf  ( iso14040:ElementaryFlow iso14040:ProductFlow )
                      ];
        rdfs:label    "refersToMaterial" .

<http://w3id.org/protys/ontology/resource#Product_Related_File>
        rdf:type         owl:Class;
        rdfs:comment     "Archivo relacionado con productos, p. ej. diseños CAD."@es;
        rdfs:label       "Product_Related_File"@en;
        rdfs:subClassOf  <http://w3id.org/protys/ontology/resource#File> , core:Resource .

research:indicatorForLot
        rdf:type            owl:ObjectProperty;
        rdfs:domain         iso14040:ImpactIndicator;
        rdfs:range          iso15531:Lot;
        rdfs:subPropertyOf  alignment:indicatorForLot .

research:thresholdCategory
        rdf:type     owl:FunctionalProperty , owl:DatatypeProperty;
        rdfs:domain  research:ThresholdRecord;
        rdfs:range   xsd:string .

iso14040:GoalAndScopeDefinition
        rdf:type         owl:Class;
        rdfs:label       "Definición de objetivo y alcance"@es;
        rdfs:subClassOf  owl:Thing .

alignment:var_equipment
        rdf:type  swrl:Variable .

iso15531:QualityAttribute
        rdf:type         owl:Class;
        rdfs:label       "Atributo de calidad"@es;
        rdfs:subClassOf  owl:Thing .

paint-ext:batchQuantity
        rdf:type    owl:DatatypeProperty;
        rdfs:label  "batchQuantity";
        rdfs:range  xsd:decimal .
