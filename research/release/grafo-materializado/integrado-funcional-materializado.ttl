        research:inputMassKg          "250"^^xsd:decimal;
        research:outputMassKg         "250"^^xsd:decimal;
        research:outputVolumeL        "200"^^xsd:decimal;
        research:registeredLossKg     "0"^^xsd:decimal;
        research:stageIndex           3;
        research:yieldPercent         "100"^^xsd:decimal .

<http://w3id.org/protys/ontology/resource#Raw_Material>
        rdf:type         owl:Class;
        rdfs:comment     "Materia prima de entrada a las actividades productivas."@es;
        rdfs:label       "Raw_Material"@en;
        rdfs:subClassOf  <http://w3id.org/protys/ontology/resource#Material> , core:Resource .

<http://w3id.org/protys/ontology/product#Thing>
        rdf:type         owl:Class;
        rdfs:comment     "Categoría general propia del Módulo de Producto de PROTYS(KB). No es una definición universal de los estándares ISO ni un concepto atribuido a Bruno (2015). Su IRI es product:Thing y es distinto de owl:Thing."@es;
        rdfs:label       "Thing"@en;
        rdfs:subClassOf  owl:Thing .

iso15531:hasActivity  rdf:type  owl:ObjectProperty;
        rdfs:comment  "Trazabilidad lote a actividades/operaciones (regla R21)."@es;
        rdfs:domain   iso15531:Lot;
        rdfs:label    "hasActivity";
        rdfs:range    iso15531:ProcessOperation .

paint-ext:hasSkill  rdf:type  owl:ObjectProperty;
        rdfs:comment        "Habilidad de un recurso humano, modelada como capacidad de manufactura. Subpropiedad de iso15531:hasCapability."@es;
        rdfs:domain         iso15531:ManufacturingResource;
        rdfs:label          "hasSkill";
        rdfs:range          iso15531:ManufacturingCapability;
        rdfs:subPropertyOf  iso15531:hasCapability .

core:involve  rdf:type  owl:ObjectProperty;
        rdfs:comment  "Asociación local entre Enterprise y Process, declarados como dominio y rango de involve. Representa la vinculación de una empresa con sus procesos; no se presenta como reproducción literal de una relación de ISO 15531 o ISO 18629 ni impone una cantidad mínima de procesos."@es;
        rdfs:domain   core:Enterprise;
        rdfs:label    "involve";
        rdfs:range    core:Process .

alignment:var_time  rdf:type  swrl:Variable .

alignment:var_process
        rdf:type  swrl:Variable .

research:ThresholdRecord
        rdf:type         owl:Class;
        rdfs:subClassOf  owl:Thing .

paint-ext:outputQuantity
        rdf:type    owl:DatatypeProperty;
        rdfs:label  "outputQuantity";
        rdfs:range  xsd:decimal .

[ rdf:type    swrl:Imp;
  rdfs:label  "R15: Marcar indisponibilidad temporal por mantenimiento ACTIVE en la instantánea";
  swrl:body   [ rdf:type   swrl:AtomList;
                rdf:first  [ rdf:type             swrl:ClassAtom;
                             swrl:argument1       alignment:var_resource;
                             swrl:classPredicate  iso15531:ManufacturingResource
                           ];
                rdf:rest   [ rdf:type   swrl:AtomList;
                             rdf:first  [ rdf:type                swrl:IndividualPropertyAtom;
                                          swrl:argument1          alignment:var_resource;
                                          swrl:argument2          alignment:var_maintenance;
                                          swrl:propertyPredicate  iso15531:hasMaintenance
                                        ];
                             rdf:rest   [ rdf:type   swrl:AtomList;
                                          rdf:first  [ rdf:type                swrl:DatavaluedPropertyAtom;
                                                       swrl:argument1          alignment:var_maintenance;
                                                       swrl:argument2          "ACTIVE";
                                                       swrl:propertyPredicate  research:maintenanceStatus
                                                     ];
                                          rdf:rest   ()
                                        ]
                           ]
              ];
  swrl:head   [ rdf:type   swrl:AtomList;
                rdf:first  [ rdf:type             swrl:ClassAtom;
                             swrl:argument1       alignment:var_resource;
                             swrl:classPredicate  iso15531:temporarilyUnavailable
                           ];
                rdf:rest   ()
              ]
] .

paint-ext:MaterialFlow
        rdf:type         owl:Class;
        rdfs:comment     "Flujo de materiales a través de los procesos. Subclase de iso15531:ManufacturingFlow."@es;
        rdfs:label       "MaterialFlow"@en;
        rdfs:subClassOf  iso15531:ManufacturingFlow .

[ rdf:type    swrl:Imp;
  rdfs:label  "R02: Presencia de inventario de agua del proceso";
  swrl:body   [ rdf:type   swrl:AtomList;
                rdf:first  [ rdf:type             swrl:ClassAtom;
                             swrl:argument1       alignment:var_op;
                             swrl:classPredicate  iso15531:ProcessOperation
                           ];
                rdf:rest   [ rdf:type   swrl:AtomList;
                             rdf:first  [ rdf:type                swrl:DatavaluedPropertyAtom;
                                          swrl:argument1          alignment:var_op;
                                          swrl:argument2          alignment:var_water;
                                          swrl:propertyPredicate  iso15531:consumesWaterL
                                        ];
                             rdf:rest   [ rdf:type   swrl:AtomList;
                                          rdf:first  [ rdf:type                swrl:IndividualPropertyAtom;
                                                       swrl:argument1          alignment:var_op;
                                                       swrl:argument2          alignment:var_process;
                                                       swrl:propertyPredicate  iso15531:partOfProcess
                                                     ];
                                          rdf:rest   [ rdf:type   swrl:AtomList;
                                                       rdf:first  [ rdf:type                swrl:IndividualPropertyAtom;
                                                                    swrl:argument1          alignment:var_process;
                                                                    swrl:argument2          alignment:var_lci;
                                                                    swrl:propertyPredicate  alignment:hasInventoryRepresentation
                                                                  ];
                                                       rdf:rest   ()
                                                     ]
                                        ]
                           ]
              ];
  swrl:head   [ rdf:type   swrl:AtomList;
                rdf:first  [ rdf:type                swrl:IndividualPropertyAtom;
                             swrl:argument1          alignment:var_lci;
                             swrl:argument2          core:WaterFlow;
                             swrl:propertyPredicate  iso14040:hasInventoryFlow
                           ];
                rdf:rest   ()
              ]
] .

<http://w3id.org/protys/fixture#BatchA_Inventory>
        rdf:type                      iso14040:LifeCycleInventory , owl:NamedIndividual , owl:Thing;
        alignment:inventoryForPlan    <http://w3id.org/protys/fixture#BatchA_Plan>;
