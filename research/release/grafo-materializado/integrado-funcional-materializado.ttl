[ rdf:type    swrl:Imp;
  rdfs:label  "R04: Indicador por umbral explícito de la misma unidad y categoría";
  swrl:body   [ rdf:type   swrl:AtomList;
                rdf:first  [ rdf:type             swrl:ClassAtom;
                             swrl:argument1       alignment:var_indicator;
                             swrl:classPredicate  iso14040:ImpactIndicator
                           ];
                rdf:rest   [ rdf:type   swrl:AtomList;
                             rdf:first  [ rdf:type                swrl:IndividualPropertyAtom;
                                          swrl:argument1          alignment:var_indicator;
                                          swrl:argument2          alignment:var_record;
                                          swrl:propertyPredicate  research:hasThreshold
                                        ];
                             rdf:rest   [ rdf:type   swrl:AtomList;
                                          rdf:first  [ rdf:type             swrl:ClassAtom;
                                                       swrl:argument1       alignment:var_record;
                                                       swrl:classPredicate  research:ThresholdRecord
                                                     ];
                                          rdf:rest   [ rdf:type   swrl:AtomList;
                                                       rdf:first  [ rdf:type                swrl:DatavaluedPropertyAtom;
                                                                    swrl:argument1          alignment:var_indicator;
                                                                    swrl:argument2          alignment:var_value;
                                                                    swrl:propertyPredicate  iso14040:hasIndicatorValue
                                                                  ];
                                                       rdf:rest   [ rdf:type   swrl:AtomList;
                                                                    rdf:first  [ rdf:type                swrl:DatavaluedPropertyAtom;
                                                                                 swrl:argument1          alignment:var_indicator;
                                                                                 swrl:argument2          alignment:var_unit;
                                                                                 swrl:propertyPredicate  research:unit
                                                                               ];
                                                                    rdf:rest   [ rdf:type   swrl:AtomList;
                                                                                 rdf:first  [ rdf:type                swrl:DatavaluedPropertyAtom;
                                                                                              swrl:argument1          alignment:var_indicator;
                                                                                              swrl:argument2          alignment:var_category;
                                                                                              swrl:propertyPredicate  research:indicatorCategory
                                                                                            ];
                                                                                 rdf:rest   [ rdf:type   swrl:AtomList;
                                                                                              rdf:first  [ rdf:type                swrl:DatavaluedPropertyAtom;
                                                                                                           swrl:argument1          alignment:var_record;
                                                                                                           swrl:argument2          alignment:var_threshold;
                                                                                                           swrl:propertyPredicate  research:thresholdValue
                                                                                                         ];
                                                                                              rdf:rest   [ rdf:type   swrl:AtomList;
                                                                                                           rdf:first  [ rdf:type                swrl:DatavaluedPropertyAtom;
                                                                                                                        swrl:argument1          alignment:var_record;
                                                                                                                        swrl:argument2          alignment:var_unit;
                                                                                                                        swrl:propertyPredicate  research:thresholdUnit
                                                                                                                      ];
                                                                                                           rdf:rest   [ rdf:type   swrl:AtomList;
                                                                                                                        rdf:first  [ rdf:type                swrl:DatavaluedPropertyAtom;
                                                                                                                                     swrl:argument1          alignment:var_record;
                                                                                                                                     swrl:argument2          alignment:var_category;
                                                                                                                                     swrl:propertyPredicate  research:thresholdCategory
                                                                                                                                   ];
                                                                                                                        rdf:rest   [ rdf:type   swrl:AtomList;
                                                                                                                                     rdf:first  [ rdf:type        swrl:BuiltinAtom;
                                                                                                                                                  swrl:arguments  ( alignment:var_value alignment:var_threshold );
                                                                                                                                                  swrl:builtin    swrlb:greaterThan
                                                                                                                                                ];
                                                                                                                                     rdf:rest   ()
                                                                                                                                   ]
                                                                                                                      ]
                                                                                                         ]
                                                                                            ]
                                                                               ]
                                                                  ]
                                                     ]
                                        ]
                           ]
              ];
  swrl:head   [ rdf:type   swrl:AtomList;
                rdf:first  [ rdf:type             swrl:ClassAtom;
                             swrl:argument1       alignment:var_indicator;
                             swrl:classPredicate  core:HighImpactIndicator
                           ];
                rdf:rest   ()
              ]
] .

