        iso14040:hasGHGImpactKgCO2e   75.0;
        iso15531:consumesEnergyKWh    "150"^^xsd:decimal;
        iso15531:consumesMaterial     <http://w3id.org/protys/fixture#AcrylicResin> , <http://w3id.org/protys/fixture#Biocide> , <http://w3id.org/protys/fixture#Water> , <http://w3id.org/protys/fixture#TitaniumDioxide>;
