alignment:flowRefersToProduct
        rdf:type      owl:ObjectProperty;
        rdfs:comment  "Flow record refers to a distinct product/material entity; a purchased commodity flow is not the commodity itself.";
        rdfs:domain   iso14040:ProductFlow;
        rdfs:domain   [ rdf:type     owl:Class;
                        owl:unionOf  ( iso14040:ElementaryFlow iso14040:ProductFlow )
                      ];
        rdfs:range    <http://w3id.org/protys/ontology/product#Thing> , <http://w3id.org/protys/ontology/product#Substance> , <http://w3id.org/protys/ontology/product#Production_Item> , <http://w3id.org/protys/ontology/product#Product> , core:Product .

iso15531:duration  rdf:type  owl:DatatypeProperty;
        rdfs:comment  "Duración de una actividad (regla R11)."@es;
        rdfs:label    "duration";
        rdfs:range    xsd:decimal .

core:Process  rdf:type   owl:Class;
        rdfs:comment     "Concepto local para un procedimiento con pasos u operaciones que puede producir un producto o modificar sus características. ISO 10303-49 es una referencia normativa de contexto; esta descripción propuesta no se presenta como una definición literal de una cláusula identificada. Se refina en el Módulo de Proceso."@es;
        rdfs:label       "Process"@en , "Proceso"@es;
        rdfs:subClassOf  owl:Thing .

