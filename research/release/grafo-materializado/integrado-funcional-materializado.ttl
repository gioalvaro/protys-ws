iso14040:emits  rdf:type  owl:ObjectProperty;
        rdfs:comment  "Salida elemental de un proceso unitario hacia la naturaleza; no se utiliza para representar compras de materias primas del escenario."@es;
        rdfs:domain   iso14040:UnitProcess;
        rdfs:label    "emits";
        rdfs:range    iso14040:ElementaryFlow;
        rdfs:range    [ rdf:type     owl:Class;
                        owl:unionOf  ( iso14040:ElementaryFlow iso14040:ProductFlow )
                      ] .

[ rdf:type    swrl:Imp;
  rdfs:label  "R03: Vincular insumo comprado al lote mediante su representación LCI";
  swrl:body   [ rdf:type   swrl:AtomList;
                rdf:first  [ rdf:type             swrl:ClassAtom;
                             swrl:argument1       alignment:var_lot;
                             swrl:classPredicate  iso15531:Lot
                           ];
                rdf:rest   [ rdf:type   swrl:AtomList;
                             rdf:first  [ rdf:type                swrl:IndividualPropertyAtom;
                                          swrl:argument1          alignment:var_order;
                                          swrl:argument2          alignment:var_lot;
                                          swrl:propertyPredicate  iso15531:producesLot
                                        ];
                             rdf:rest   [ rdf:type   swrl:AtomList;
                                          rdf:first  [ rdf:type                swrl:IndividualPropertyAtom;
                                                       swrl:argument1          alignment:var_lot;
                                                       swrl:argument2          alignment:var_process;
                                                       swrl:propertyPredicate  iso15531:hasProcess
                                                     ];
                                          rdf:rest   [ rdf:type   swrl:AtomList;
                                                       rdf:first  [ rdf:type                swrl:IndividualPropertyAtom;
                                                                    swrl:argument1          alignment:var_process;
                                                                    swrl:argument2          alignment:var_lci;
                                                                    swrl:propertyPredicate  alignment:hasInventoryRepresentation
                                                                  ];
                                                       rdf:rest   [ rdf:type   swrl:AtomList;
                                                                    rdf:first  [ rdf:type             swrl:ClassAtom;
                                                                                 swrl:argument1       alignment:var_lci;
                                                                                 swrl:classPredicate  iso14040:UnitProcess
                                                                               ];
                                                                    rdf:rest   [ rdf:type   swrl:AtomList;
                                                                                 rdf:first  [ rdf:type                swrl:IndividualPropertyAtom;
                                                                                              swrl:argument1          alignment:var_lci;
                                                                                              swrl:argument2          alignment:var_flow;
                                                                                              swrl:propertyPredicate  iso14040:hasInventoryFlow
                                                                                            ];
                                                                                 rdf:rest   [ rdf:type   swrl:AtomList;
                                                                                              rdf:first  [ rdf:type             swrl:ClassAtom;
                                                                                                           swrl:argument1       alignment:var_flow;
                                                                                                           swrl:classPredicate  iso14040:ProductFlow
                                                                                                         ];
                                                                                              rdf:rest   ()
                                                                                            ]
                                                                               ]
                                                                  ]
                                                     ]
                                        ]
                           ]
              ];
  swrl:head   [ rdf:type   swrl:AtomList;
                rdf:first  [ rdf:type                swrl:IndividualPropertyAtom;
                             swrl:argument1          alignment:var_lot;
                             swrl:argument2          alignment:var_flow;
                             swrl:propertyPredicate  alignment:hasRecordedInputFlowForLot
                           ];
                rdf:rest   ()
              ]
] .

alignment:var_lot  rdf:type  swrl:Variable .

