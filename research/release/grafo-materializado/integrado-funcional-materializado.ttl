<http://w3id.org/protys/ontology/product#Production_Component>
        rdf:type         owl:Class;
        rdfs:comment     "Componente de producto de la conceptualización local. Bruno (2015), sección III.A, respalda la distinción entre producto y componente y describe la composición y descomposición de componentes. Este módulo declara la asociación composes con Product; no impone una descomposición recursiva ni nuevas cardinalidades."@es;
        rdfs:label       "Production_Component"@en;
        rdfs:subClassOf  <http://w3id.org/protys/ontology/product#Thing> , <http://w3id.org/protys/ontology/product#Substance> , <http://w3id.org/protys/ontology/product#Production_Item> .

alignment:hasEfficiency
        rdf:type      owl:DatatypeProperty;
