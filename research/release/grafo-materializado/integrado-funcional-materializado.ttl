core:Enterprise  rdf:type  owl:Class;
        rdfs:comment     "Concepto local para una organización o agrupación de organizaciones con objetivos de ofrecer productos o servicios. ISO 10303-239 se conserva como referencia normativa de contexto, sin presentar esta descripción como una definición literal del estándar. Se refina en el Módulo de Empresa."@es;
        rdfs:label       "Enterprise"@en , "Empresa"@es;
        rdfs:subClassOf  owl:Thing .

paint-ext:hasProcessPlan
        rdf:type      owl:ObjectProperty;
        rdfs:comment  "Vincula un producto con el proceso/plan que lo fabrica."@es;
        rdfs:label    "hasProcessPlan" .

research:yieldPercent
        rdf:type    owl:DatatypeProperty;
        rdfs:range  xsd:decimal .

research:eventTimeSeconds
        rdf:type    owl:DatatypeProperty;
        rdfs:range  xsd:decimal .

<http://w3id.org/protys/fixture#GridFactor>
        rdf:type                owl:NamedIndividual , core:RequiresRecomputeIndicators , research:ElectricityEmissionFactor , owl:Thing , research:EmissionFactor;
        core:hasPriorVersion    "1";
        core:hasVersion         "2";
        core:modifiedInVersion  "2";
        research:factorUnit     "kg CO2e/kWh";
        research:factorValue    0.5;
        research:scenarioRole   "Factor declarado del escenario, no factor medido de planta" .

core:hasName  rdf:type  owl:DatatypeProperty;
        rdfs:comment  "Nombre o identificador textual de una entidad."@es;
        rdfs:label    "hasName";
        rdfs:range    xsd:string .

iso15531:Quality_Control_Activity
        rdf:type         owl:Class;
        rdfs:comment     "Actividad de control de calidad. Declarada en la capa de alineamiento para soportar el patrón de validación R19 como concepto auxiliar del perfil de manufactura."@es;
        rdfs:label       "Quality_Control_Activity";
        rdfs:subClassOf  iso15531:ProcessOperation .

research:maintenanceStatus
        rdf:type    owl:DatatypeProperty;
        rdfs:range  xsd:string .

core:Hotspot  rdf:type   owl:Class;
        rdfs:comment     "Recurso declarado cuello de botella y vinculado al mismo proceso que un indicador por encima del umbral del escenario (R22). No prueba baja eficiencia, contaminación, causalidad o superioridad industrial."@es;
        rdfs:label       "Hotspot";
        rdfs:subClassOf  owl:Thing .

alignment:allocationForOperation
        rdf:type      owl:ObjectProperty;
        rdfs:comment  "Optional relation for an explicitly supplied allocation procedure. Painting scenario performs no allocation among coproducts; only a separate illustrative fixture exercises the relation.";
        rdfs:domain   iso14040:AllocationProcedure;
        rdfs:range    iso15531:ProcessOperation .

[ rdf:type    swrl:Imp;
  rdfs:label  "R06: Asociar factor al flujo del material correspondiente";
  swrl:body   [ rdf:type   swrl:AtomList;
                rdf:first  [ rdf:type             swrl:ClassAtom;
                             swrl:argument1       alignment:var_flow;
                             swrl:classPredicate  iso14040:ProductFlow
                           ];
                rdf:rest   [ rdf:type   swrl:AtomList;
                             rdf:first  [ rdf:type                swrl:IndividualPropertyAtom;
                                          swrl:argument1          alignment:var_flow;
                                          swrl:argument2          alignment:var_material;
                                          swrl:propertyPredicate  iso14040:refersToMaterial
                                        ];
                             rdf:rest   [ rdf:type   swrl:AtomList;
                                          rdf:first  [ rdf:type                swrl:IndividualPropertyAtom;
                                                       swrl:argument1          alignment:var_material;
                                                       swrl:argument2          alignment:var_factor;
                                                       swrl:propertyPredicate  research:hasEmissionFactor
                                                     ];
                                          rdf:rest   ()
                                        ]
                           ]
              ];
  swrl:head   [ rdf:type   swrl:AtomList;
                rdf:first  [ rdf:type                swrl:IndividualPropertyAtom;
                             swrl:argument1          alignment:var_flow;
                             swrl:argument2          alignment:var_factor;
                             swrl:propertyPredicate  research:usesEmissionFactor
                           ];
                rdf:rest   ()
              ]
] .

