        iso15531:cycleTime            "60"^^xsd:decimal;
        iso15531:duration             "60"^^xsd:decimal;
        iso15531:hasInput             <http://w3id.org/protys/fixture#Biocide> , <http://w3id.org/protys/fixture#Water> , <http://w3id.org/protys/fixture#TitaniumDioxide> , <http://w3id.org/protys/fixture#AcrylicResin>;
        iso15531:partOfProcess        <http://w3id.org/protys/fixture#BatchB_Process>;
        iso15531:requiresResource     <http://w3id.org/protys/fixture#MixingReactor_02> , <http://w3id.org/protys/fixture#Operator_01>;
        iso15531:responsibleOperator  <http://w3id.org/protys/fixture#Operator_01>;
        iso15531:usesResource         <http://w3id.org/protys/fixture#Operator_01> , <http://w3id.org/protys/fixture#MixingReactor_02>;
        iso15531:yield                "100"^^xsd:decimal;
