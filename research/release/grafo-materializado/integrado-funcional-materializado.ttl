        rdf:type                        iso14040:ProductFlow , owl:NamedIndividual , owl:Thing;
        rdf:type                        [ rdf:type     owl:Class;
                                          owl:unionOf  ( iso14040:ElementaryFlow iso14040:ProductFlow )
                                        ];
