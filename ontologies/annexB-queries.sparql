# --- Q01. Ranking de procesos por electricidad y emisiones acumuladas
PREFIX i: <http://w3id.org/protys/ontology/iso15531#>
PREFIX e: <http://w3id.org/protys/ontology/iso14040#>
PREFIX c: <http://w3id.org/protys/ontology/core#>
PREFIX a: <http://w3id.org/protys/ontology/alignment#>
PREFIX t: <http://w3id.org/protys/ontology/research#>
PREFIX p: <http://w3id.org/protys/ontology/paint-ext#>
PREFIX r: <http://w3id.org/protys/ontology/resource#>
PREFIX f: <http://w3id.org/protys/fixture#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?process (SUM(?energy) AS ?energyKWh)
(SUM(?ghg) AS ?ghgKgCO2e) WHERE {
{ SELECT DISTINCT ?process ?op ?energy ?ghg WHERE {
{ SELECT ?lot ?process ?op (MIN(?inputEnergy) AS ?energy)
(MIN(?inputGHG) AS ?ghg) WHERE {
?lot a i:Lot ; i:hasProcess ?process ; i:hasActivity ?op .
?op a i:ProcessOperation ; i:partOfProcess ?process .

?op i:consumesEnergyKWh ?inputEnergy .
FILTER(isNumeric(?inputEnergy) && ?inputEnergy >= 0)
FILTER NOT EXISTS { ?op i:consumesEnergyKWh ?rowEnergyOther .
FILTER(!isNumeric(?rowEnergyOther) || ?rowEnergyOther != ?inputEnergy) }
?op t:hasEmissionFactor ?rowFactor .
FILTER(isIRI(?rowFactor))
FILTER NOT EXISTS { ?op t:hasEmissionFactor ?rowOtherFactor .
FILTER(!sameTerm(?rowOtherFactor,?rowFactor)) }
?rowFactor a t:ElectricityEmissionFactor ; t:factorUnit "kg CO2e/kWh" .
FILTER NOT EXISTS { ?rowFactor t:factorUnit ?rowOtherUnit .
FILTER(STR(?rowOtherUnit) != "kg CO2e/kWh") }
?rowFactor t:factorValue ?rowFactorValue .
FILTER(isNumeric(?rowFactorValue) && ?rowFactorValue >= 0)
FILTER NOT EXISTS { ?rowFactor t:factorValue ?rowFactorOther .
FILTER(!isNumeric(?rowFactorOther) || ?rowFactorOther != ?rowFactorValue) }
?op e:hasGHGImpactKgCO2e ?inputGHG .
FILTER(isNumeric(?inputGHG) && ?inputGHG >= 0)
FILTER NOT EXISTS { ?op e:hasGHGImpactKgCO2e ?rowGHGOther .
FILTER(!isNumeric(?rowGHGOther) || ?rowGHGOther != ?inputGHG) }
FILTER(ABS(?inputGHG - ?inputEnergy * ?rowFactorValue) <= 0.000000001)
FILTER NOT EXISTS { ?lot a i:Lot ; i:hasProcess ?allProcess ; i:hasActivity ?allOperation .
?allOperation a i:ProcessOperation ; i:partOfProcess ?allProcess .
FILTER NOT EXISTS { ?allOperation i:consumesEnergyKWh ?allEnergy .
FILTER(isNumeric(?allEnergy) && ?allEnergy >= 0)
FILTER NOT EXISTS { ?allOperation i:consumesEnergyKWh ?allCheckEnergyOther .
FILTER(!isNumeric(?allCheckEnergyOther) || ?allCheckEnergyOther != ?allEnergy) }
?allOperation t:hasEmissionFactor ?allCheckFactor .
FILTER(isIRI(?allCheckFactor))
FILTER NOT EXISTS { ?allOperation t:hasEmissionFactor ?allCheckOtherFactor .
FILTER(!sameTerm(?allCheckOtherFactor,?allCheckFactor)) }
?allCheckFactor a t:ElectricityEmissionFactor ; t:factorUnit "kg CO2e/kWh" .
FILTER NOT EXISTS { ?allCheckFactor t:factorUnit ?allCheckOtherUnit .
FILTER(STR(?allCheckOtherUnit) != "kg CO2e/kWh") }
?allCheckFactor t:factorValue ?allCheckFactorValue .
FILTER(isNumeric(?allCheckFactorValue) && ?allCheckFactorValue >= 0)
FILTER NOT EXISTS { ?allCheckFactor t:factorValue ?allCheckFactorOther .
FILTER(!isNumeric(?allCheckFactorOther) || ?allCheckFactorOther != ?allCheckFactorValue) }
?allOperation e:hasGHGImpactKgCO2e ?allGHG .
FILTER(isNumeric(?allGHG) && ?allGHG >= 0)
FILTER NOT EXISTS { ?allOperation e:hasGHGImpactKgCO2e ?allCheckGHGOther .
FILTER(!isNumeric(?allCheckGHGOther) || ?allCheckGHGOther != ?allGHG) }
FILTER(ABS(?allGHG - ?allEnergy * ?allCheckFactorValue) <= 0.000000001) } }
}
GROUP BY ?lot ?process ?op } } }
FILTER NOT EXISTS { ?badLot a i:Lot ; i:hasProcess ?process ; i:hasActivity ?badOp .
?badOp a i:ProcessOperation ; i:partOfProcess ?process .
FILTER NOT EXISTS { ?badOp i:consumesEnergyKWh ?badEnergy .
FILTER(isNumeric(?badEnergy) && ?badEnergy >= 0)
FILTER NOT EXISTS { ?badOp i:consumesEnergyKWh ?processCheckEnergyOther .
FILTER(!isNumeric(?processCheckEnergyOther) || ?processCheckEnergyOther != ?badEnergy) }
?badOp t:hasEmissionFactor ?processCheckFactor .
FILTER(isIRI(?processCheckFactor))
FILTER NOT EXISTS { ?badOp t:hasEmissionFactor ?processCheckOtherFactor .
FILTER(!sameTerm(?processCheckOtherFactor,?processCheckFactor)) }
?processCheckFactor a t:ElectricityEmissionFactor ; t:factorUnit "kg CO2e/kWh" .
FILTER NOT EXISTS { ?processCheckFactor t:factorUnit ?processCheckOtherUnit .
FILTER(STR(?processCheckOtherUnit) != "kg CO2e/kWh") }
?processCheckFactor t:factorValue ?processCheckFactorValue .
FILTER(isNumeric(?processCheckFactorValue) && ?processCheckFactorValue >= 0)
FILTER NOT EXISTS { ?processCheckFactor t:factorValue ?processCheckFactorOther .
FILTER(!isNumeric(?processCheckFactorOther) || ?processCheckFactorOther != ?processCheckFactorValue) }
?badOp e:hasGHGImpactKgCO2e ?badGHG .
FILTER(isNumeric(?badGHG) && ?badGHG >= 0)
FILTER NOT EXISTS { ?badOp e:hasGHGImpactKgCO2e ?processCheckGHGOther .
FILTER(!isNumeric(?processCheckGHGOther) || ?processCheckGHGOther != ?badGHG) }
FILTER(ABS(?badGHG - ?badEnergy * ?processCheckFactorValue) <= 0.000000001) } }
} GROUP BY ?process ORDER BY DESC(?ghgKgCO2e)

# --- Q02. Trazabilidad lote, plan, producto, recursos requeridos e insumos
PREFIX i: <http://w3id.org/protys/ontology/iso15531#>
PREFIX e: <http://w3id.org/protys/ontology/iso14040#>
PREFIX c: <http://w3id.org/protys/ontology/core#>
PREFIX a: <http://w3id.org/protys/ontology/alignment#>
PREFIX t: <http://w3id.org/protys/ontology/research#>
PREFIX p: <http://w3id.org/protys/ontology/paint-ext#>
PREFIX r: <http://w3id.org/protys/ontology/resource#>
PREFIX f: <http://w3id.org/protys/fixture#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT ?lot ?plan ?product ?resource
WHERE { ?lot a i:Lot ; t:hasPlan ?plan ; t:producesProduct ?product .
?lot i:hasProcess ?process . ?plan t:planProduces ?product ; i:includesActivity ?op .
?op i:partOfProcess ?process . { ?op i:requiresResource ?resource } UNION { ?op i:hasInput ?resource } }
ORDER BY ?lot ?resource

# --- Q03. Electricidad y emisiones por lote, sin fuentes de materias primas
PREFIX i: <http://w3id.org/protys/ontology/iso15531#>
PREFIX e: <http://w3id.org/protys/ontology/iso14040#>
PREFIX c: <http://w3id.org/protys/ontology/core#>
PREFIX a: <http://w3id.org/protys/ontology/alignment#>
PREFIX t: <http://w3id.org/protys/ontology/research#>
PREFIX p: <http://w3id.org/protys/ontology/paint-ext#>
PREFIX r: <http://w3id.org/protys/ontology/resource#>
PREFIX f: <http://w3id.org/protys/fixture#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?lot (SUM(?energy) AS ?energyKWh)
(SUM(?ghg) AS ?ghgKgCO2e) WHERE { { SELECT ?lot ?op (MIN(?inputEnergy) AS ?energy)
(MIN(?inputGHG) AS ?ghg) WHERE {
?lot a i:Lot ; i:hasProcess ?process ; i:hasActivity ?op .
?op a i:ProcessOperation ; i:partOfProcess ?process .

?op i:consumesEnergyKWh ?inputEnergy .
FILTER(isNumeric(?inputEnergy) && ?inputEnergy >= 0)
FILTER NOT EXISTS { ?op i:consumesEnergyKWh ?rowEnergyOther .
FILTER(!isNumeric(?rowEnergyOther) || ?rowEnergyOther != ?inputEnergy) }
?op t:hasEmissionFactor ?rowFactor .
FILTER(isIRI(?rowFactor))
FILTER NOT EXISTS { ?op t:hasEmissionFactor ?rowOtherFactor .
FILTER(!sameTerm(?rowOtherFactor,?rowFactor)) }
?rowFactor a t:ElectricityEmissionFactor ; t:factorUnit "kg CO2e/kWh" .
FILTER NOT EXISTS { ?rowFactor t:factorUnit ?rowOtherUnit .
FILTER(STR(?rowOtherUnit) != "kg CO2e/kWh") }
?rowFactor t:factorValue ?rowFactorValue .
FILTER(isNumeric(?rowFactorValue) && ?rowFactorValue >= 0)
FILTER NOT EXISTS { ?rowFactor t:factorValue ?rowFactorOther .
FILTER(!isNumeric(?rowFactorOther) || ?rowFactorOther != ?rowFactorValue) }
?op e:hasGHGImpactKgCO2e ?inputGHG .
FILTER(isNumeric(?inputGHG) && ?inputGHG >= 0)
FILTER NOT EXISTS { ?op e:hasGHGImpactKgCO2e ?rowGHGOther .
FILTER(!isNumeric(?rowGHGOther) || ?rowGHGOther != ?inputGHG) }
FILTER(ABS(?inputGHG - ?inputEnergy * ?rowFactorValue) <= 0.000000001)
FILTER NOT EXISTS { ?lot a i:Lot ; i:hasProcess ?allProcess ; i:hasActivity ?allOperation .
?allOperation a i:ProcessOperation ; i:partOfProcess ?allProcess .
FILTER NOT EXISTS { ?allOperation i:consumesEnergyKWh ?allEnergy .
FILTER(isNumeric(?allEnergy) && ?allEnergy >= 0)
FILTER NOT EXISTS { ?allOperation i:consumesEnergyKWh ?allCheckEnergyOther .
FILTER(!isNumeric(?allCheckEnergyOther) || ?allCheckEnergyOther != ?allEnergy) }
?allOperation t:hasEmissionFactor ?allCheckFactor .
FILTER(isIRI(?allCheckFactor))
FILTER NOT EXISTS { ?allOperation t:hasEmissionFactor ?allCheckOtherFactor .
FILTER(!sameTerm(?allCheckOtherFactor,?allCheckFactor)) }
?allCheckFactor a t:ElectricityEmissionFactor ; t:factorUnit "kg CO2e/kWh" .
FILTER NOT EXISTS { ?allCheckFactor t:factorUnit ?allCheckOtherUnit .
FILTER(STR(?allCheckOtherUnit) != "kg CO2e/kWh") }
?allCheckFactor t:factorValue ?allCheckFactorValue .
FILTER(isNumeric(?allCheckFactorValue) && ?allCheckFactorValue >= 0)
FILTER NOT EXISTS { ?allCheckFactor t:factorValue ?allCheckFactorOther .
FILTER(!isNumeric(?allCheckFactorOther) || ?allCheckFactorOther != ?allCheckFactorValue) }
?allOperation e:hasGHGImpactKgCO2e ?allGHG .
FILTER(isNumeric(?allGHG) && ?allGHG >= 0)
FILTER NOT EXISTS { ?allOperation e:hasGHGImpactKgCO2e ?allCheckGHGOther .
FILTER(!isNumeric(?allCheckGHGOther) || ?allCheckGHGOther != ?allGHG) }
FILTER(ABS(?allGHG - ?allEnergy * ?allCheckFactorValue) <= 0.000000001) } }
}
GROUP BY ?lot ?op }
} GROUP BY ?lot ORDER BY ?lot

# --- Q04. Recursos requeridos e insumos materiales por proceso
PREFIX i: <http://w3id.org/protys/ontology/iso15531#>
PREFIX e: <http://w3id.org/protys/ontology/iso14040#>
PREFIX c: <http://w3id.org/protys/ontology/core#>
PREFIX a: <http://w3id.org/protys/ontology/alignment#>
PREFIX t: <http://w3id.org/protys/ontology/research#>
PREFIX p: <http://w3id.org/protys/ontology/paint-ext#>
PREFIX r: <http://w3id.org/protys/ontology/resource#>
PREFIX f: <http://w3id.org/protys/fixture#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT ?process ?resource
WHERE { ?op a i:ProcessOperation ; i:partOfProcess ?process . { ?op i:requiresResource ?resource } UNION { ?op i:hasInput ?resource } }
ORDER BY ?process ?resource

# --- Q05. Materiales según factores hipotéticos del escenario, excluidos de Q06
PREFIX i: <http://w3id.org/protys/ontology/iso15531#>
PREFIX e: <http://w3id.org/protys/ontology/iso14040#>
PREFIX c: <http://w3id.org/protys/ontology/core#>
PREFIX a: <http://w3id.org/protys/ontology/alignment#>
PREFIX t: <http://w3id.org/protys/ontology/research#>
PREFIX p: <http://w3id.org/protys/ontology/paint-ext#>
PREFIX r: <http://w3id.org/protys/ontology/resource#>
PREFIX f: <http://w3id.org/protys/fixture#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?material ?carbonFactor ?waterFactor ?exceedsDeclaredCarbonThreshold
WHERE { ?material a r:Raw_Material ; t:materialFactorKgCO2ePerKg ?carbonFactor ; t:waterFootprintLPerKg ?waterFactor .
BIND((?carbonFactor > 5.0) AS ?exceedsDeclaredCarbonThreshold)
FILTER(?carbonFactor > 3.0 || ?waterFactor > 100) } ORDER BY DESC(?carbonFactor)

# --- Q06. Intensidad de emisiones eléctricas del proceso productivo en kg CO2e/L
PREFIX i: <http://w3id.org/protys/ontology/iso15531#>
PREFIX e: <http://w3id.org/protys/ontology/iso14040#>
PREFIX c: <http://w3id.org/protys/ontology/core#>
PREFIX a: <http://w3id.org/protys/ontology/alignment#>
PREFIX t: <http://w3id.org/protys/ontology/research#>
PREFIX p: <http://w3id.org/protys/ontology/paint-ext#>
PREFIX r: <http://w3id.org/protys/ontology/resource#>
PREFIX f: <http://w3id.org/protys/fixture#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?product ?lot ?liters (SUM(?ghg) AS ?ghgKgCO2e)
((SUM(?ghg) / ?liters) AS ?kgCO2ePerL) WHERE {
{ SELECT ?lot ?op (MIN(?inputEnergy) AS ?energy)
(MIN(?inputGHG) AS ?ghg) WHERE {
?lot a i:Lot ; i:hasProcess ?process ; i:hasActivity ?op .
?op a i:ProcessOperation ; i:partOfProcess ?process .
?lot t:hasGHGContribution ?op .
?op i:consumesEnergyKWh ?inputEnergy .
FILTER(isNumeric(?inputEnergy) && ?inputEnergy >= 0)
FILTER NOT EXISTS { ?op i:consumesEnergyKWh ?rowEnergyOther .
FILTER(!isNumeric(?rowEnergyOther) || ?rowEnergyOther != ?inputEnergy) }
?op t:hasEmissionFactor ?rowFactor .
FILTER(isIRI(?rowFactor))
FILTER NOT EXISTS { ?op t:hasEmissionFactor ?rowOtherFactor .
FILTER(!sameTerm(?rowOtherFactor,?rowFactor)) }
?rowFactor a t:ElectricityEmissionFactor ; t:factorUnit "kg CO2e/kWh" .
FILTER NOT EXISTS { ?rowFactor t:factorUnit ?rowOtherUnit .
FILTER(STR(?rowOtherUnit) != "kg CO2e/kWh") }
?rowFactor t:factorValue ?rowFactorValue .
FILTER(isNumeric(?rowFactorValue) && ?rowFactorValue >= 0)
FILTER NOT EXISTS { ?rowFactor t:factorValue ?rowFactorOther .
FILTER(!isNumeric(?rowFactorOther) || ?rowFactorOther != ?rowFactorValue) }
?op e:hasGHGImpactKgCO2e ?inputGHG .
FILTER(isNumeric(?inputGHG) && ?inputGHG >= 0)
FILTER NOT EXISTS { ?op e:hasGHGImpactKgCO2e ?rowGHGOther .
FILTER(!isNumeric(?rowGHGOther) || ?rowGHGOther != ?inputGHG) }
FILTER(ABS(?inputGHG - ?inputEnergy * ?rowFactorValue) <= 0.000000001)
FILTER NOT EXISTS { ?lot a i:Lot ; i:hasProcess ?allProcess ; i:hasActivity ?allOperation .
?allOperation a i:ProcessOperation ; i:partOfProcess ?allProcess .
FILTER NOT EXISTS { ?allOperation i:consumesEnergyKWh ?allEnergy .
FILTER(isNumeric(?allEnergy) && ?allEnergy >= 0)
FILTER NOT EXISTS { ?allOperation i:consumesEnergyKWh ?allCheckEnergyOther .
FILTER(!isNumeric(?allCheckEnergyOther) || ?allCheckEnergyOther != ?allEnergy) }
?allOperation t:hasEmissionFactor ?allCheckFactor .
FILTER(isIRI(?allCheckFactor))
FILTER NOT EXISTS { ?allOperation t:hasEmissionFactor ?allCheckOtherFactor .
FILTER(!sameTerm(?allCheckOtherFactor,?allCheckFactor)) }
?allCheckFactor a t:ElectricityEmissionFactor ; t:factorUnit "kg CO2e/kWh" .
FILTER NOT EXISTS { ?allCheckFactor t:factorUnit ?allCheckOtherUnit .
FILTER(STR(?allCheckOtherUnit) != "kg CO2e/kWh") }
?allCheckFactor t:factorValue ?allCheckFactorValue .
FILTER(isNumeric(?allCheckFactorValue) && ?allCheckFactorValue >= 0)
FILTER NOT EXISTS { ?allCheckFactor t:factorValue ?allCheckFactorOther .
FILTER(!isNumeric(?allCheckFactorOther) || ?allCheckFactorOther != ?allCheckFactorValue) }
?allOperation e:hasGHGImpactKgCO2e ?allGHG .
FILTER(isNumeric(?allGHG) && ?allGHG >= 0)
FILTER NOT EXISTS { ?allOperation e:hasGHGImpactKgCO2e ?allCheckGHGOther .
FILTER(!isNumeric(?allCheckGHGOther) || ?allCheckGHGOther != ?allGHG) }
FILTER(ABS(?allGHG - ?allEnergy * ?allCheckFactorValue) <= 0.000000001) } }
}
GROUP BY ?lot ?op }
?lot t:producesProduct ?product ; i:functionalUnit "L" .
{ SELECT ?lot (MIN(?rawLiters) AS ?liters) WHERE { ?lot i:producesQuantity ?rawLiters .
FILTER(isNumeric(?rawLiters) && ?rawLiters > 0)
FILTER NOT EXISTS { ?lot i:producesQuantity ?volumeOther .
FILTER(!isNumeric(?volumeOther) || ?volumeOther != ?rawLiters) } } GROUP BY ?lot }
FILTER NOT EXISTS { ?lot i:functionalUnit ?otherUnit . FILTER(STR(?otherUnit)!="L") }
} GROUP BY ?product ?lot ?liters ORDER BY ?lot

# --- Q07. Residuo de balance después de pérdidas registradas, tolerancia máxima 1%
PREFIX i: <http://w3id.org/protys/ontology/iso15531#>
PREFIX e: <http://w3id.org/protys/ontology/iso14040#>
PREFIX c: <http://w3id.org/protys/ontology/core#>
PREFIX a: <http://w3id.org/protys/ontology/alignment#>
PREFIX t: <http://w3id.org/protys/ontology/research#>
PREFIX p: <http://w3id.org/protys/ontology/paint-ext#>
PREFIX r: <http://w3id.org/protys/ontology/resource#>
PREFIX f: <http://w3id.org/protys/fixture#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?operation ?inputMassKg ?outputMassKg ?registeredLossKg ?residueKg ?status
WHERE { ?operation a i:ProcessOperation ; t:inputMassKg ?inputMassKg ; t:outputMassKg ?outputMassKg ; t:registeredLossKg ?registeredLossKg .
BIND(ABS(?inputMassKg - ?outputMassKg - ?registeredLossKg) AS ?residueKg)
BIND(IF(?inputMassKg <= 0 || ?outputMassKg < 0 || ?registeredLossKg < 0, "INVALID_INPUT",
IF(?residueKg <= 0.01 * ?inputMassKg, "OK", "REVISAR")) AS ?status) } ORDER BY ?operation

# --- Q08. Rendimiento másico, electricidad e intensidad de emisiones por operación
PREFIX i: <http://w3id.org/protys/ontology/iso15531#>
PREFIX e: <http://w3id.org/protys/ontology/iso14040#>
PREFIX c: <http://w3id.org/protys/ontology/core#>
PREFIX a: <http://w3id.org/protys/ontology/alignment#>
PREFIX t: <http://w3id.org/protys/ontology/research#>
PREFIX p: <http://w3id.org/protys/ontology/paint-ext#>
PREFIX r: <http://w3id.org/protys/ontology/resource#>
PREFIX f: <http://w3id.org/protys/fixture#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?operation ?stageName ?yieldPercent ?energyKWh
?ghgKgCO2e ?outputVolumeL (?ghgKgCO2e/?outputVolumeL AS ?kgCO2ePerL)
WHERE {
?operation a p:Manufacturing_Stage ; c:hasName ?stageName ;
t:yieldPercent ?yieldPercent .
{ SELECT ?operation (MIN(?rawEnergy) AS ?energyKWh)
(MIN(?rawGHG) AS ?ghgKgCO2e) (MIN(?rawVolume) AS ?outputVolumeL)
WHERE {
?operation i:consumesEnergyKWh ?rawEnergy .
FILTER(isNumeric(?rawEnergy) && ?rawEnergy >= 0)
FILTER NOT EXISTS { ?operation i:consumesEnergyKWh ?stageEnergyOther .
FILTER(!isNumeric(?stageEnergyOther) || ?stageEnergyOther != ?rawEnergy) }
?operation t:hasEmissionFactor ?stageFactor .
FILTER(isIRI(?stageFactor))
FILTER NOT EXISTS { ?operation t:hasEmissionFactor ?stageOtherFactor .
FILTER(!sameTerm(?stageOtherFactor,?stageFactor)) }
?stageFactor a t:ElectricityEmissionFactor ; t:factorUnit "kg CO2e/kWh" .
FILTER NOT EXISTS { ?stageFactor t:factorUnit ?stageOtherUnit .
FILTER(STR(?stageOtherUnit) != "kg CO2e/kWh") }
?stageFactor t:factorValue ?stageFactorValue .
FILTER(isNumeric(?stageFactorValue) && ?stageFactorValue >= 0)
FILTER NOT EXISTS { ?stageFactor t:factorValue ?stageFactorOther .
FILTER(!isNumeric(?stageFactorOther) || ?stageFactorOther != ?stageFactorValue) }
?operation e:hasGHGImpactKgCO2e ?rawGHG .
FILTER(isNumeric(?rawGHG) && ?rawGHG >= 0)
FILTER NOT EXISTS { ?operation e:hasGHGImpactKgCO2e ?stageGHGOther .
FILTER(!isNumeric(?stageGHGOther) || ?stageGHGOther != ?rawGHG) }
FILTER(ABS(?rawGHG - ?rawEnergy * ?stageFactorValue) <= 0.000000001)
?operation t:outputVolumeL ?rawVolume .
FILTER(isNumeric(?rawVolume) && ?rawVolume > 0)
FILTER NOT EXISTS { ?operation t:outputVolumeL ?stageVolumeOther .
FILTER(!isNumeric(?stageVolumeOther) || ?stageVolumeOther != ?rawVolume) }
} GROUP BY ?operation }
} ORDER BY ?operation

# --- Q09. Dependencias de indicadores respecto de factores y versiones
PREFIX i: <http://w3id.org/protys/ontology/iso15531#>
PREFIX e: <http://w3id.org/protys/ontology/iso14040#>
PREFIX c: <http://w3id.org/protys/ontology/core#>
PREFIX a: <http://w3id.org/protys/ontology/alignment#>
PREFIX t: <http://w3id.org/protys/ontology/research#>
PREFIX p: <http://w3id.org/protys/ontology/paint-ext#>
PREFIX r: <http://w3id.org/protys/ontology/resource#>
PREFIX f: <http://w3id.org/protys/fixture#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?factor ?version ?process ?indicator ?value
WHERE { ?factor a t:EmissionFactor ; c:hasVersion ?version .
?indicator a e:ImpactIndicator ; t:usesEmissionFactor ?factor ; e:hasIndicatorValue ?value ; e:computedForProcess ?lci . ?process a:hasInventoryRepresentation ?lci . }
ORDER BY ?process

# --- Q10. Proveedores y factores hipotéticos de materiales, separados del inventario eléctrico
PREFIX i: <http://w3id.org/protys/ontology/iso15531#>
PREFIX e: <http://w3id.org/protys/ontology/iso14040#>
PREFIX c: <http://w3id.org/protys/ontology/core#>
PREFIX a: <http://w3id.org/protys/ontology/alignment#>
PREFIX t: <http://w3id.org/protys/ontology/research#>
PREFIX p: <http://w3id.org/protys/ontology/paint-ext#>
PREFIX r: <http://w3id.org/protys/ontology/resource#>
PREFIX f: <http://w3id.org/protys/fixture#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?supplier ?material ?factor ?value
WHERE { ?material a r:Raw_Material ; t:providedBy ?supplier ; t:hasEmissionFactor ?factor . ?factor t:factorValue ?value . }
ORDER BY ?material

# --- Q11. Emisiones eléctricas y cantidad de no conformidades por lote
PREFIX i: <http://w3id.org/protys/ontology/iso15531#>
PREFIX e: <http://w3id.org/protys/ontology/iso14040#>
PREFIX c: <http://w3id.org/protys/ontology/core#>
PREFIX a: <http://w3id.org/protys/ontology/alignment#>
PREFIX t: <http://w3id.org/protys/ontology/research#>
PREFIX p: <http://w3id.org/protys/ontology/paint-ext#>
PREFIX r: <http://w3id.org/protys/ontology/resource#>
PREFIX f: <http://w3id.org/protys/fixture#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?lot ?ghgKgCO2e ?numNC WHERE {
{ SELECT ?lot (SUM(?ghg) AS ?ghgKgCO2e) WHERE {
{ SELECT ?lot ?op (MIN(?inputEnergy) AS ?energy)
(MIN(?inputGHG) AS ?ghg) WHERE {
?lot a i:Lot ; i:hasProcess ?process ; i:hasActivity ?op .
?op a i:ProcessOperation ; i:partOfProcess ?process .
?lot t:hasGHGContribution ?op .
?op i:consumesEnergyKWh ?inputEnergy .
FILTER(isNumeric(?inputEnergy) && ?inputEnergy >= 0)
FILTER NOT EXISTS { ?op i:consumesEnergyKWh ?rowEnergyOther .
FILTER(!isNumeric(?rowEnergyOther) || ?rowEnergyOther != ?inputEnergy) }
?op t:hasEmissionFactor ?rowFactor .
FILTER(isIRI(?rowFactor))
FILTER NOT EXISTS { ?op t:hasEmissionFactor ?rowOtherFactor .
FILTER(!sameTerm(?rowOtherFactor,?rowFactor)) }
?rowFactor a t:ElectricityEmissionFactor ; t:factorUnit "kg CO2e/kWh" .
FILTER NOT EXISTS { ?rowFactor t:factorUnit ?rowOtherUnit .
FILTER(STR(?rowOtherUnit) != "kg CO2e/kWh") }
?rowFactor t:factorValue ?rowFactorValue .
FILTER(isNumeric(?rowFactorValue) && ?rowFactorValue >= 0)
FILTER NOT EXISTS { ?rowFactor t:factorValue ?rowFactorOther .
FILTER(!isNumeric(?rowFactorOther) || ?rowFactorOther != ?rowFactorValue) }
?op e:hasGHGImpactKgCO2e ?inputGHG .
FILTER(isNumeric(?inputGHG) && ?inputGHG >= 0)
FILTER NOT EXISTS { ?op e:hasGHGImpactKgCO2e ?rowGHGOther .
FILTER(!isNumeric(?rowGHGOther) || ?rowGHGOther != ?inputGHG) }
FILTER(ABS(?inputGHG - ?inputEnergy * ?rowFactorValue) <= 0.000000001)
FILTER NOT EXISTS { ?lot a i:Lot ; i:hasProcess ?allProcess ; i:hasActivity ?allOperation .
?allOperation a i:ProcessOperation ; i:partOfProcess ?allProcess .
FILTER NOT EXISTS { ?allOperation i:consumesEnergyKWh ?allEnergy .
FILTER(isNumeric(?allEnergy) && ?allEnergy >= 0)
FILTER NOT EXISTS { ?allOperation i:consumesEnergyKWh ?allCheckEnergyOther .
FILTER(!isNumeric(?allCheckEnergyOther) || ?allCheckEnergyOther != ?allEnergy) }
?allOperation t:hasEmissionFactor ?allCheckFactor .
FILTER(isIRI(?allCheckFactor))
FILTER NOT EXISTS { ?allOperation t:hasEmissionFactor ?allCheckOtherFactor .
FILTER(!sameTerm(?allCheckOtherFactor,?allCheckFactor)) }
?allCheckFactor a t:ElectricityEmissionFactor ; t:factorUnit "kg CO2e/kWh" .
FILTER NOT EXISTS { ?allCheckFactor t:factorUnit ?allCheckOtherUnit .
FILTER(STR(?allCheckOtherUnit) != "kg CO2e/kWh") }
?allCheckFactor t:factorValue ?allCheckFactorValue .
FILTER(isNumeric(?allCheckFactorValue) && ?allCheckFactorValue >= 0)
FILTER NOT EXISTS { ?allCheckFactor t:factorValue ?allCheckFactorOther .
FILTER(!isNumeric(?allCheckFactorOther) || ?allCheckFactorOther != ?allCheckFactorValue) }
?allOperation e:hasGHGImpactKgCO2e ?allGHG .
FILTER(isNumeric(?allGHG) && ?allGHG >= 0)
FILTER NOT EXISTS { ?allOperation e:hasGHGImpactKgCO2e ?allCheckGHGOther .
FILTER(!isNumeric(?allCheckGHGOther) || ?allCheckGHGOther != ?allGHG) }
FILTER(ABS(?allGHG - ?allEnergy * ?allCheckFactorValue) <= 0.000000001) } }
}
GROUP BY ?lot ?op } } GROUP BY ?lot }
{ SELECT ?lot (COUNT(DISTINCT ?nc) AS ?numNC) WHERE {
?lot a i:Lot . OPTIONAL { ?lot i:hasNonConformity ?nc }
} GROUP BY ?lot } } ORDER BY ?lot

# --- Q12. Trazabilidad indicador, proceso, operación y recurso vinculados
PREFIX i: <http://w3id.org/protys/ontology/iso15531#>
PREFIX e: <http://w3id.org/protys/ontology/iso14040#>
PREFIX c: <http://w3id.org/protys/ontology/core#>
PREFIX a: <http://w3id.org/protys/ontology/alignment#>
PREFIX t: <http://w3id.org/protys/ontology/research#>
PREFIX p: <http://w3id.org/protys/ontology/paint-ext#>
PREFIX r: <http://w3id.org/protys/ontology/resource#>
PREFIX f: <http://w3id.org/protys/fixture#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?indicator ?process ?operation ?resource ?value
WHERE { ?indicator a e:ImpactIndicator ; e:computedForProcess ?lci ; e:hasIndicatorValue ?value . ?process a:hasInventoryRepresentation ?lci .
?operation i:partOfProcess ?process ; i:usesResource ?resource . } ORDER BY ?indicator ?operation ?resource

# --- Q13. Inventario explícito de flujos materiales por proceso
PREFIX i: <http://w3id.org/protys/ontology/iso15531#>
PREFIX e: <http://w3id.org/protys/ontology/iso14040#>
PREFIX c: <http://w3id.org/protys/ontology/core#>
PREFIX a: <http://w3id.org/protys/ontology/alignment#>
PREFIX t: <http://w3id.org/protys/ontology/research#>
PREFIX p: <http://w3id.org/protys/ontology/paint-ext#>
PREFIX r: <http://w3id.org/protys/ontology/resource#>
PREFIX f: <http://w3id.org/protys/fixture#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?process ?flow ?material ?quantityKg ?unit
WHERE { ?flow a e:ProductFlow ; t:belongsToProcess ?process ; e:refersToMaterial ?material ; t:materialQuantityKg ?quantityKg ; t:unit ?unit . }
ORDER BY ?process ?material

# --- Q14. Falta de registro de limpieza del mismo equipo entre lotes consecutivos
PREFIX i: <http://w3id.org/protys/ontology/iso15531#>
PREFIX e: <http://w3id.org/protys/ontology/iso14040#>
PREFIX c: <http://w3id.org/protys/ontology/core#>
PREFIX a: <http://w3id.org/protys/ontology/alignment#>
PREFIX t: <http://w3id.org/protys/ontology/research#>
PREFIX p: <http://w3id.org/protys/ontology/paint-ext#>
PREFIX r: <http://w3id.org/protys/ontology/resource#>
PREFIX f: <http://w3id.org/protys/fixture#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT ?lotA ?lotB ?equipment WHERE {
?lotA i:requiresCleaningBetween ?lotB ; i:processedOn ?equipment .
?lotB i:processedOn ?equipment .
?lotA t:endTimeSeconds ?endA .
FILTER(isNumeric(?endA))
FILTER NOT EXISTS { ?lotA t:endTimeSeconds ?pairEndOther .
FILTER(!isNumeric(?pairEndOther) || ?pairEndOther != ?endA) }
?lotB t:startTimeSeconds ?startB .
FILTER(isNumeric(?startB))
FILTER NOT EXISTS { ?lotB t:startTimeSeconds ?pairStartOther .
FILTER(!isNumeric(?pairStartOther) || ?pairStartOther != ?startB) }
FILTER(?endA <= ?startB)
FILTER NOT EXISTS { ?clean a i:CleaningOperation ; t:cleanedResource ?equipment .
?clean t:startTimeSeconds ?cleanStart .
FILTER(isNumeric(?cleanStart))
FILTER NOT EXISTS { ?clean t:startTimeSeconds ?cleanStartOther .
FILTER(!isNumeric(?cleanStartOther) || ?cleanStartOther != ?cleanStart) }
?clean t:endTimeSeconds ?cleanEnd .
FILTER(isNumeric(?cleanEnd))
FILTER NOT EXISTS { ?clean t:endTimeSeconds ?cleanEndOther .
FILTER(!isNumeric(?cleanEndOther) || ?cleanEndOther != ?cleanEnd) }
FILTER(?cleanStart >= ?endA && ?cleanEnd <= ?startB && ?cleanEnd >= ?cleanStart) }
} ORDER BY ?lotA ?lotB ?equipment

# --- Q15. Agua registrada por operación auxiliar de limpieza
PREFIX i: <http://w3id.org/protys/ontology/iso15531#>
PREFIX e: <http://w3id.org/protys/ontology/iso14040#>
PREFIX c: <http://w3id.org/protys/ontology/core#>
PREFIX a: <http://w3id.org/protys/ontology/alignment#>
PREFIX t: <http://w3id.org/protys/ontology/research#>
PREFIX p: <http://w3id.org/protys/ontology/paint-ext#>
PREFIX r: <http://w3id.org/protys/ontology/resource#>
PREFIX f: <http://w3id.org/protys/fixture#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?clean ?waterL WHERE { ?clean a i:CleaningOperation ; i:consumesWaterL ?waterL . } ORDER BY ?clean

# --- Q16. Tiempo de uso y OEE registrado por recurso y plan
PREFIX i: <http://w3id.org/protys/ontology/iso15531#>
PREFIX e: <http://w3id.org/protys/ontology/iso14040#>
PREFIX c: <http://w3id.org/protys/ontology/core#>
PREFIX a: <http://w3id.org/protys/ontology/alignment#>
PREFIX t: <http://w3id.org/protys/ontology/research#>
PREFIX p: <http://w3id.org/protys/ontology/paint-ext#>
PREFIX r: <http://w3id.org/protys/ontology/resource#>
PREFIX f: <http://w3id.org/protys/fixture#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?plan ?resource (SUM(?duration) AS ?usedTimeMinutes) ?oeePercent
WHERE { { SELECT DISTINCT ?plan ?operation ?resource ?duration WHERE {
?lot t:hasPlan ?plan ; i:hasProcess ?process . ?plan a i:ProcessPlan ; i:includesActivity ?operation .
?operation i:partOfProcess ?process ; i:usesResource ?resource ; i:duration ?duration . } }
OPTIONAL { ?resource t:oeePercent ?oeePercent } } GROUP BY ?plan ?resource ?oeePercent ORDER BY ?plan ?resource

# --- Q17. Emisiones eléctricas por unidad funcional de salida, litros positivos
PREFIX i: <http://w3id.org/protys/ontology/iso15531#>
PREFIX e: <http://w3id.org/protys/ontology/iso14040#>
PREFIX c: <http://w3id.org/protys/ontology/core#>
PREFIX a: <http://w3id.org/protys/ontology/alignment#>
PREFIX t: <http://w3id.org/protys/ontology/research#>
PREFIX p: <http://w3id.org/protys/ontology/paint-ext#>
PREFIX r: <http://w3id.org/protys/ontology/resource#>
PREFIX f: <http://w3id.org/protys/fixture#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?lot ?functionalUnit ?outputLiters
(SUM(?ghg)/?outputLiters AS ?impactPerFU) WHERE {
{ SELECT ?lot ?op (MIN(?inputEnergy) AS ?energy)
(MIN(?inputGHG) AS ?ghg) WHERE {
?lot a i:Lot ; i:hasProcess ?process ; i:hasActivity ?op .
?op a i:ProcessOperation ; i:partOfProcess ?process .
?lot t:hasGHGContribution ?op .
?op i:consumesEnergyKWh ?inputEnergy .
FILTER(isNumeric(?inputEnergy) && ?inputEnergy >= 0)
FILTER NOT EXISTS { ?op i:consumesEnergyKWh ?rowEnergyOther .
FILTER(!isNumeric(?rowEnergyOther) || ?rowEnergyOther != ?inputEnergy) }
?op t:hasEmissionFactor ?rowFactor .
FILTER(isIRI(?rowFactor))
FILTER NOT EXISTS { ?op t:hasEmissionFactor ?rowOtherFactor .
FILTER(!sameTerm(?rowOtherFactor,?rowFactor)) }
?rowFactor a t:ElectricityEmissionFactor ; t:factorUnit "kg CO2e/kWh" .
FILTER NOT EXISTS { ?rowFactor t:factorUnit ?rowOtherUnit .
FILTER(STR(?rowOtherUnit) != "kg CO2e/kWh") }
?rowFactor t:factorValue ?rowFactorValue .
FILTER(isNumeric(?rowFactorValue) && ?rowFactorValue >= 0)
FILTER NOT EXISTS { ?rowFactor t:factorValue ?rowFactorOther .
FILTER(!isNumeric(?rowFactorOther) || ?rowFactorOther != ?rowFactorValue) }
?op e:hasGHGImpactKgCO2e ?inputGHG .
FILTER(isNumeric(?inputGHG) && ?inputGHG >= 0)
FILTER NOT EXISTS { ?op e:hasGHGImpactKgCO2e ?rowGHGOther .
FILTER(!isNumeric(?rowGHGOther) || ?rowGHGOther != ?inputGHG) }
FILTER(ABS(?inputGHG - ?inputEnergy * ?rowFactorValue) <= 0.000000001)
FILTER NOT EXISTS { ?lot a i:Lot ; i:hasProcess ?allProcess ; i:hasActivity ?allOperation .
?allOperation a i:ProcessOperation ; i:partOfProcess ?allProcess .
FILTER NOT EXISTS { ?allOperation i:consumesEnergyKWh ?allEnergy .
FILTER(isNumeric(?allEnergy) && ?allEnergy >= 0)
FILTER NOT EXISTS { ?allOperation i:consumesEnergyKWh ?allCheckEnergyOther .
FILTER(!isNumeric(?allCheckEnergyOther) || ?allCheckEnergyOther != ?allEnergy) }
?allOperation t:hasEmissionFactor ?allCheckFactor .
FILTER(isIRI(?allCheckFactor))
FILTER NOT EXISTS { ?allOperation t:hasEmissionFactor ?allCheckOtherFactor .
FILTER(!sameTerm(?allCheckOtherFactor,?allCheckFactor)) }
?allCheckFactor a t:ElectricityEmissionFactor ; t:factorUnit "kg CO2e/kWh" .
FILTER NOT EXISTS { ?allCheckFactor t:factorUnit ?allCheckOtherUnit .
FILTER(STR(?allCheckOtherUnit) != "kg CO2e/kWh") }
?allCheckFactor t:factorValue ?allCheckFactorValue .
FILTER(isNumeric(?allCheckFactorValue) && ?allCheckFactorValue >= 0)
FILTER NOT EXISTS { ?allCheckFactor t:factorValue ?allCheckFactorOther .
FILTER(!isNumeric(?allCheckFactorOther) || ?allCheckFactorOther != ?allCheckFactorValue) }
?allOperation e:hasGHGImpactKgCO2e ?allGHG .
FILTER(isNumeric(?allGHG) && ?allGHG >= 0)
FILTER NOT EXISTS { ?allOperation e:hasGHGImpactKgCO2e ?allCheckGHGOther .
FILTER(!isNumeric(?allCheckGHGOther) || ?allCheckGHGOther != ?allGHG) }
FILTER(ABS(?allGHG - ?allEnergy * ?allCheckFactorValue) <= 0.000000001) } }
}
GROUP BY ?lot ?op }
?lot i:functionalUnit ?functionalUnit . FILTER(STR(?functionalUnit)="L")
FILTER NOT EXISTS { ?lot i:functionalUnit ?otherUnit . FILTER(STR(?otherUnit)!="L") }
{ SELECT ?lot (MIN(?rawLiters) AS ?outputLiters) WHERE {
?lot i:producesQuantity ?rawLiters .
FILTER(isNumeric(?rawLiters) && ?rawLiters > 0)
FILTER NOT EXISTS { ?lot i:producesQuantity ?fuVolumeOther .
FILTER(!isNumeric(?fuVolumeOther) || ?fuVolumeOther != ?rawLiters) }
} GROUP BY ?lot }
} GROUP BY ?lot ?functionalUnit ?outputLiters ORDER BY ?lot

# --- Q18. Actividades del plan, orden explícito y duración de cadena lineal
PREFIX i: <http://w3id.org/protys/ontology/iso15531#>
PREFIX e: <http://w3id.org/protys/ontology/iso14040#>
PREFIX c: <http://w3id.org/protys/ontology/core#>
PREFIX a: <http://w3id.org/protys/ontology/alignment#>
PREFIX t: <http://w3id.org/protys/ontology/research#>
PREFIX p: <http://w3id.org/protys/ontology/paint-ext#>
PREFIX r: <http://w3id.org/protys/ontology/resource#>
PREFIX f: <http://w3id.org/protys/fixture#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT ?plan ?activity ?stageIndex ?stageName ?lifecycleStage ?totalDurationMinutes WHERE {
?plan a i:ProcessPlan ; i:includesActivity ?activity ; t:lifecycleStage ?lifecycleStage .
?lot t:hasPlan ?plan ; i:hasProcess ?process .
?activity i:partOfProcess ?process ; t:stageIndex ?stageIndex ; c:hasName ?stageName .
{ SELECT ?plan (SUM(?d) AS ?totalDurationMinutes) WHERE {
{ SELECT DISTINCT ?plan ?op ?d WHERE { ?owner t:hasPlan ?plan ; i:hasProcess ?ownedProcess .
?plan i:includesActivity ?op . ?op i:partOfProcess ?ownedProcess ; i:duration ?d . } } } GROUP BY ?plan }
} ORDER BY ?plan ?stageIndex

# --- Q19. Ranking de lotes por emisiones eléctricas acumuladas
PREFIX i: <http://w3id.org/protys/ontology/iso15531#>
PREFIX e: <http://w3id.org/protys/ontology/iso14040#>
PREFIX c: <http://w3id.org/protys/ontology/core#>
PREFIX a: <http://w3id.org/protys/ontology/alignment#>
PREFIX t: <http://w3id.org/protys/ontology/research#>
PREFIX p: <http://w3id.org/protys/ontology/paint-ext#>
PREFIX r: <http://w3id.org/protys/ontology/resource#>
PREFIX f: <http://w3id.org/protys/fixture#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?lot (SUM(?ghg) AS ?ghgKgCO2e) WHERE {
{ SELECT ?lot ?op (MIN(?inputEnergy) AS ?energy)
(MIN(?inputGHG) AS ?ghg) WHERE {
?lot a i:Lot ; i:hasProcess ?process ; i:hasActivity ?op .
?op a i:ProcessOperation ; i:partOfProcess ?process .
?lot t:hasGHGContribution ?op .
?op i:consumesEnergyKWh ?inputEnergy .
FILTER(isNumeric(?inputEnergy) && ?inputEnergy >= 0)
FILTER NOT EXISTS { ?op i:consumesEnergyKWh ?rowEnergyOther .
FILTER(!isNumeric(?rowEnergyOther) || ?rowEnergyOther != ?inputEnergy) }
?op t:hasEmissionFactor ?rowFactor .
FILTER(isIRI(?rowFactor))
FILTER NOT EXISTS { ?op t:hasEmissionFactor ?rowOtherFactor .
FILTER(!sameTerm(?rowOtherFactor,?rowFactor)) }
?rowFactor a t:ElectricityEmissionFactor ; t:factorUnit "kg CO2e/kWh" .
FILTER NOT EXISTS { ?rowFactor t:factorUnit ?rowOtherUnit .
FILTER(STR(?rowOtherUnit) != "kg CO2e/kWh") }
?rowFactor t:factorValue ?rowFactorValue .
FILTER(isNumeric(?rowFactorValue) && ?rowFactorValue >= 0)
FILTER NOT EXISTS { ?rowFactor t:factorValue ?rowFactorOther .
FILTER(!isNumeric(?rowFactorOther) || ?rowFactorOther != ?rowFactorValue) }
?op e:hasGHGImpactKgCO2e ?inputGHG .
FILTER(isNumeric(?inputGHG) && ?inputGHG >= 0)
FILTER NOT EXISTS { ?op e:hasGHGImpactKgCO2e ?rowGHGOther .
FILTER(!isNumeric(?rowGHGOther) || ?rowGHGOther != ?inputGHG) }
FILTER(ABS(?inputGHG - ?inputEnergy * ?rowFactorValue) <= 0.000000001)
FILTER NOT EXISTS { ?lot a i:Lot ; i:hasProcess ?allProcess ; i:hasActivity ?allOperation .
?allOperation a i:ProcessOperation ; i:partOfProcess ?allProcess .
FILTER NOT EXISTS { ?allOperation i:consumesEnergyKWh ?allEnergy .
FILTER(isNumeric(?allEnergy) && ?allEnergy >= 0)
FILTER NOT EXISTS { ?allOperation i:consumesEnergyKWh ?allCheckEnergyOther .
FILTER(!isNumeric(?allCheckEnergyOther) || ?allCheckEnergyOther != ?allEnergy) }
?allOperation t:hasEmissionFactor ?allCheckFactor .
FILTER(isIRI(?allCheckFactor))
FILTER NOT EXISTS { ?allOperation t:hasEmissionFactor ?allCheckOtherFactor .
FILTER(!sameTerm(?allCheckOtherFactor,?allCheckFactor)) }
?allCheckFactor a t:ElectricityEmissionFactor ; t:factorUnit "kg CO2e/kWh" .
FILTER NOT EXISTS { ?allCheckFactor t:factorUnit ?allCheckOtherUnit .
FILTER(STR(?allCheckOtherUnit) != "kg CO2e/kWh") }
?allCheckFactor t:factorValue ?allCheckFactorValue .
FILTER(isNumeric(?allCheckFactorValue) && ?allCheckFactorValue >= 0)
FILTER NOT EXISTS { ?allCheckFactor t:factorValue ?allCheckFactorOther .
FILTER(!isNumeric(?allCheckFactorOther) || ?allCheckFactorOther != ?allCheckFactorValue) }
?allOperation e:hasGHGImpactKgCO2e ?allGHG .
FILTER(isNumeric(?allGHG) && ?allGHG >= 0)
FILTER NOT EXISTS { ?allOperation e:hasGHGImpactKgCO2e ?allCheckGHGOther .
FILTER(!isNumeric(?allCheckGHGOther) || ?allCheckGHGOther != ?allGHG) }
FILTER(ABS(?allGHG - ?allEnergy * ?allCheckFactorValue) <= 0.000000001) } }
}
GROUP BY ?lot ?op }
} GROUP BY ?lot ORDER BY DESC(?ghgKgCO2e)

# --- Q20. Datos críticos ausentes por tipo, con criterio explícito
PREFIX i: <http://w3id.org/protys/ontology/iso15531#>
PREFIX e: <http://w3id.org/protys/ontology/iso14040#>
PREFIX c: <http://w3id.org/protys/ontology/core#>
PREFIX a: <http://w3id.org/protys/ontology/alignment#>
PREFIX t: <http://w3id.org/protys/ontology/research#>
PREFIX p: <http://w3id.org/protys/ontology/paint-ext#>
PREFIX r: <http://w3id.org/protys/ontology/resource#>
PREFIX f: <http://w3id.org/protys/fixture#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?entity ?kind ?missingProperty WHERE {
{ ?entity a i:ManufacturingProcess . BIND("ManufacturingProcess" AS ?kind) BIND(e:computedForProcess AS ?missingProperty)
FILTER NOT EXISTS { ?entity t:hasInventoryRepresentation ?lci . ?indicator a e:ImpactIndicator ; e:computedForProcess ?lci ; e:indicatorValue ?value . } }
UNION { ?entity a i:ProcessOperation . BIND("ProcessOperation" AS ?kind) BIND(i:hasInput AS ?missingProperty)
FILTER NOT EXISTS { ?entity i:hasInput ?input . } }
UNION { ?entity a i:Quality_Control_Activity . BIND("QualityControl" AS ?kind) BIND(i:hasMeasurement AS ?missingProperty)
FILTER NOT EXISTS { ?entity i:hasMeasurement ?measurement . } }
} ORDER BY ?entity ?kind

# --- Q21. Términos con versión modificada respecto de la registrada
PREFIX i: <http://w3id.org/protys/ontology/iso15531#>
PREFIX e: <http://w3id.org/protys/ontology/iso14040#>
PREFIX c: <http://w3id.org/protys/ontology/core#>
PREFIX a: <http://w3id.org/protys/ontology/alignment#>
PREFIX t: <http://w3id.org/protys/ontology/research#>
PREFIX p: <http://w3id.org/protys/ontology/paint-ext#>
PREFIX r: <http://w3id.org/protys/ontology/resource#>
PREFIX f: <http://w3id.org/protys/fixture#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?entity ?currentVersion ?priorVersion WHERE { ?entity c:hasVersion ?currentVersion ; c:hasPriorVersion ?priorVersion .
FILTER(?currentVersion != ?priorVersion) } ORDER BY ?entity
