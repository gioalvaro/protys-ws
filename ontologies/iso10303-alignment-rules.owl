<?xml version='1.0' encoding='UTF-8'?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:swrl="http://www.w3.org/2003/11/swrl#" xmlns:swrlb="http://www.w3.org/2003/11/swrlb#" xmlns:core="http://w3id.org/protys/ontology/core#" xmlns:product="http://w3id.org/protys/ontology/product#" xmlns:align="http://w3id.org/protys/ontology/alignment#" xmlns:ap242="http://w3id.org/protys/ontology/iso10303#" xml:base="http://w3id.org/protys/ontology/alignment/iso10303">

    <owl:Ontology rdf:about="http://w3id.org/protys/ontology/alignment/iso10303">
        <rdfs:label>PROTYS ISO 10303 AP242 Alignment Rules</rdfs:label>
        <rdfs:comment>SWRL rules R27-R29 aligning the ISO 10303 AP242 fragment with the PROTYS core and Product modules. Supports the extensibility demonstration described in Section 5.4.3 of the thesis.</rdfs:comment>
        <owl:versionInfo>1.0</owl:versionInfo>
        <owl:imports rdf:resource="http://w3id.org/protys/ontology/core"/>
        <owl:imports rdf:resource="http://w3id.org/protys/ontology/product"/>
        <owl:imports rdf:resource="http://w3id.org/protys/ontology/iso10303"/>
        </owl:Ontology>

    <!-- ========================================
         R27-R29: ISO 10303 AP242 ↔ Core/ProductMod Mappings
         ======================================== -->

    <rdf:Description rdf:about="http://w3id.org/protys/ontology/alignment#R27"><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/><rdfs:label>R27: Registro del perfil piloto representa un producto</rdfs:label><swrl:body><rdf:Description><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/><swrl:classPredicate rdf:resource="http://w3id.org/protys/ontology/iso10303#Product_Definition"/><swrl:argument1 rdf:resource="http://w3id.org/protys/ontology/alignment#var_x"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/><swrl:classPredicate rdf:resource="http://w3id.org/protys/ontology/research#PilotProductRecord"/><swrl:argument1 rdf:resource="http://w3id.org/protys/ontology/alignment#var_x"/></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></rdf:rest></rdf:Description></swrl:body><swrl:head><rdf:Description><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/><swrl:classPredicate rdf:resource="http://w3id.org/protys/ontology/core#Product"/><swrl:argument1 rdf:resource="http://w3id.org/protys/ontology/alignment#var_x"/></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></swrl:head></rdf:Description><rdf:Description rdf:about="http://w3id.org/protys/ontology/alignment#R28"><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/><rdfs:label>R28: Registro marcado representa un componente del ensamblaje piloto</rdfs:label><swrl:body><rdf:Description><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/><swrl:classPredicate rdf:resource="http://w3id.org/protys/ontology/iso10303#Configuration_Item"/><swrl:argument1 rdf:resource="http://w3id.org/protys/ontology/alignment#var_x"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/><swrl:classPredicate rdf:resource="http://w3id.org/protys/ontology/research#PilotComponentRecord"/><swrl:argument1 rdf:resource="http://w3id.org/protys/ontology/alignment#var_x"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://w3id.org/protys/ontology/research#componentOf"/><swrl:argument1 rdf:resource="http://w3id.org/protys/ontology/alignment#var_x"/><swrl:argument2 rdf:resource="http://w3id.org/protys/ontology/alignment#var_assembly"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/><swrl:classPredicate rdf:resource="http://w3id.org/protys/ontology/research#PilotProductRecord"/><swrl:argument1 rdf:resource="http://w3id.org/protys/ontology/alignment#var_assembly"/></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></swrl:body><swrl:head><rdf:Description><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/><swrl:classPredicate rdf:resource="http://w3id.org/protys/ontology/product#Production_Component"/><swrl:argument1 rdf:resource="http://w3id.org/protys/ontology/alignment#var_x"/></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></swrl:head></rdf:Description><rdf:Description rdf:about="http://w3id.org/protys/ontology/alignment#R29"><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/><rdfs:label>R29: Representación geométrica del producto del perfil piloto</rdfs:label><swrl:body><rdf:Description><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/><swrl:classPredicate rdf:resource="http://w3id.org/protys/ontology/iso10303#Shape_Representation"/><swrl:argument1 rdf:resource="http://w3id.org/protys/ontology/alignment#var_x"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://w3id.org/protys/ontology/iso10303#hasShapeRepresentation"/><swrl:argument1 rdf:resource="http://w3id.org/protys/ontology/alignment#var_assembly"/><swrl:argument2 rdf:resource="http://w3id.org/protys/ontology/alignment#var_x"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/><swrl:classPredicate rdf:resource="http://w3id.org/protys/ontology/research#PilotProductRecord"/><swrl:argument1 rdf:resource="http://w3id.org/protys/ontology/alignment#var_assembly"/></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></swrl:body><swrl:head><rdf:Description><rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/><swrl:classPredicate rdf:resource="http://w3id.org/protys/ontology/product#Product_Information"/><swrl:argument1 rdf:resource="http://w3id.org/protys/ontology/alignment#var_x"/></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></swrl:head></rdf:Description><rdf:Description rdf:about="http://w3id.org/protys/ontology/alignment#var_x"><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/></rdf:Description><rdf:Description rdf:about="http://w3id.org/protys/ontology/alignment#var_assembly"><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/></rdf:Description></rdf:RDF>
