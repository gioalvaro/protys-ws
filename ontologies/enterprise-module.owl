<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:core="http://w3id.org/protys/ontology/core#"
         xmlns:enterprise="http://w3id.org/protys/ontology/enterprise#"
         xml:base="http://w3id.org/protys/ontology/enterprise">

    <owl:Ontology rdf:about="http://w3id.org/protys/ontology/enterprise">
        <rdfs:label xml:lang="es">PROTYS(KB) - Módulo de Empresa (EnterpriseMod)</rdfs:label>
        <rdfs:comment xml:lang="es">Módulo del Nivel de Refinamiento que profundiza el concepto Enterprise del Nivel Principal (Cap. 3, §3.3.2, Fig. 3.13), según el modelo de manufactura jerárquico de cuatro niveles de Zhao et al. (1999): Station - Cell - Shop - Factory - Enterprise, más el concepto Location.</rdfs:comment>
        <owl:versionInfo>2.0</owl:versionInfo>
        <owl:imports rdf:resource="http://w3id.org/protys/ontology/core"/>
    </owl:Ontology>

    <!-- ============ CLASES (Fig. 3.13) ============ -->

    <owl:Class rdf:about="http://w3id.org/protys/ontology/enterprise#Station">
        <rdfs:label xml:lang="en">Station</rdfs:label>
        <rdfs:comment xml:lang="es">Estación de trabajo individual donde se ejecuta una operación o tarea específica del proceso productivo (nivel más básico de la jerarquía).</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/protys/ontology/enterprise#isPartOf"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/protys/ontology/enterprise#Cell"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="http://w3id.org/protys/ontology/enterprise#Cell">
        <rdfs:label xml:lang="en">Cell</rdfs:label>
        <rdfs:comment xml:lang="es">Agrupación lógica de estaciones que realizan operaciones relacionadas dentro del flujo de producción.</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/protys/ontology/enterprise#isPartOf"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/protys/ontology/enterprise#Shop"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="http://w3id.org/protys/ontology/enterprise#Shop">
        <rdfs:label xml:lang="en">Shop</rdfs:label>
        <rdfs:comment xml:lang="es">Área o departamento de producción donde se coordinan múltiples células para completar una fase significativa del proceso manufacturero.</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/protys/ontology/enterprise#isPartOf"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/protys/ontology/enterprise#Factory"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="http://w3id.org/protys/ontology/enterprise#Factory">
        <rdfs:label xml:lang="en">Factory</rdfs:label>
        <rdfs:comment xml:lang="es">Instalación completa que alberga múltiples áreas de producción (shops) y cuenta con la infraestructura necesaria para la manufactura integral de productos.</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/protys/ontology/enterprise#isPartOf"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/protys/ontology/core#Enterprise"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="http://w3id.org/protys/ontology/enterprise#Location">
        <rdfs:label xml:lang="en">Location</rdfs:label>
        <rdfs:comment xml:lang="es">Ubicación geográfica de las instalaciones empresariales; una misma localización puede albergar múltiples entidades organizacionales (parques industriales o complejos compartidos).</rdfs:comment>
    </owl:Class>

    <!-- ============ PROPIEDADES DE OBJETO ============ -->

    <owl:ObjectProperty rdf:about="http://w3id.org/protys/ontology/enterprise#isPartOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:label>isPartOf</rdfs:label>
        <rdfs:comment xml:lang="es">Agregación jerárquica entre niveles organizacionales (Station en Cell, Cell en Shop, Shop en Factory, Factory en Enterprise).</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://w3id.org/protys/ontology/enterprise#locatedAt">
        <rdfs:label>locatedAt</rdfs:label>
        <rdfs:comment xml:lang="es">Relaciona Enterprise (y sus instalaciones) con Location para especificar la ubicación geográfica.</rdfs:comment>
        <rdfs:range rdf:resource="http://w3id.org/protys/ontology/enterprise#Location"/>
    </owl:ObjectProperty>

</rdf:RDF>
