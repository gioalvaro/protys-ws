<?xml version='1.0' encoding='UTF-8'?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#" xmlns:iso15531="http://w3id.org/protys/ontology/iso15531#" xml:base="http://w3id.org/protys/ontology/iso15531">

    <owl:Ontology rdf:about="http://w3id.org/protys/ontology/iso15531">
        <rdfs:label xml:lang="es">PROTYS(KB) - Módulo ISO 15531 (MANDATE)</rdfs:label>
        <rdfs:comment xml:lang="es">Formalización parcial propuesta a partir de conceptos de ISO15531 MANDATE para interoperabilidad. Las restricciones y ejemplos de manufactura se evalúan en el escenario construido; no constituyen formalización exhaustiva del estándar ni validación industrial.</rdfs:comment>
        <owl:versionInfo>2.0</owl:versionInfo>
    </owl:Ontology>

    <!-- ============ CLASES: declaraciones explícitas del módulo ============ -->

    <owl:Class rdf:about="http://w3id.org/protys/ontology/iso15531#ManufacturingResource">
        <rdfs:label xml:lang="es">Recurso de manufactura</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://w3id.org/protys/ontology/iso15531#EquipmentResource">
        <rdfs:label xml:lang="es">Recurso de equipamiento</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://w3id.org/protys/ontology/iso15531#ManufacturingResource"/>
    </owl:Class>

    <owl:Class rdf:about="http://w3id.org/protys/ontology/iso15531#HumanResource">
        <rdfs:label xml:lang="es">Recurso humano</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://w3id.org/protys/ontology/iso15531#ManufacturingResource"/>
    </owl:Class>

    <owl:AllDisjointClasses>
        <owl:members rdf:parseType="Collection">
            <owl:Class rdf:about="http://w3id.org/protys/ontology/iso15531#EquipmentResource"/>
            <owl:Class rdf:about="http://w3id.org/protys/ontology/iso15531#HumanResource"/>
        </owl:members>
    </owl:AllDisjointClasses>

    <owl:Class rdf:about="http://w3id.org/protys/ontology/iso15531#ManufacturingProcess">
        <rdfs:label xml:lang="es">Proceso de manufactura</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://w3id.org/protys/ontology/iso15531#ProcessOperation">
        <rdfs:label xml:lang="es">Operación de proceso</rdfs:label>
        <rdfs:comment xml:lang="es">Operación o actividad atómica de manufactura. En el Anexo C las reglas la referencian también como "Activity" (p. ej., R01, R02, R11); esta clase es su representación canónica.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://w3id.org/protys/ontology/iso15531#ProcessPlan">
        <rdfs:label xml:lang="es">Plan de proceso</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://w3id.org/protys/ontology/iso15531#ManufacturingFlow">
        <rdfs:label xml:lang="es">Flujo de manufactura</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://w3id.org/protys/ontology/iso15531#ManufacturingData">
        <rdfs:label xml:lang="es">Dato de manufactura</rdfs:label>
        <rdfs:comment xml:lang="es">Registro de datos de manufactura; los eventos MES (regla R13, Anexo C) se representan como individuos de esta clase.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://w3id.org/protys/ontology/iso15531#ProductionOrder">
        <rdfs:label xml:lang="es">Orden de producción</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://w3id.org/protys/ontology/iso15531#WorkOrder">
        <rdfs:label xml:lang="es">Orden de trabajo</rdfs:label>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/protys/ontology/iso15531#executedBy"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="http://w3id.org/protys/ontology/iso15531#Lot">
        <rdfs:label xml:lang="es">Lote</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://w3id.org/protys/ontology/iso15531#ManufacturingCapability">
        <rdfs:label xml:lang="es">Capacidad de manufactura</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://w3id.org/protys/ontology/iso15531#ResourceState">
        <rdfs:label xml:lang="es">Estado de recurso</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://w3id.org/protys/ontology/iso15531#ProcessState">
        <rdfs:label xml:lang="es">Estado de proceso</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://w3id.org/protys/ontology/iso15531#TimeAttribute">
        <rdfs:label xml:lang="es">Atributo temporal</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://w3id.org/protys/ontology/iso15531#CostAttribute">
        <rdfs:label xml:lang="es">Atributo de costo</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://w3id.org/protys/ontology/iso15531#QualityAttribute">
        <rdfs:label xml:lang="es">Atributo de calidad</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://w3id.org/protys/ontology/iso15531#ManufacturingFacility">
        <rdfs:label xml:lang="es">Instalación de manufactura</rdfs:label>
    </owl:Class>

    <!-- ============ PROPIEDADES DE OBJETO ============ -->

    <owl:ObjectProperty rdf:about="http://w3id.org/protys/ontology/iso15531#executedBy">
        <rdfs:label>executedBy</rdfs:label>
        <rdfs:comment xml:lang="es">Una WorkOrder es ejecutada por al menos un recurso (restricción del Fragmento de código 3.2; también usada por R14 para el operador responsable).</rdfs:comment>
        <rdfs:domain rdf:resource="http://w3id.org/protys/ontology/iso15531#WorkOrder"/>
        <rdfs:range rdf:resource="http://w3id.org/protys/ontology/iso15531#ManufacturingResource"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://w3id.org/protys/ontology/iso15531#producesLot">
        <rdfs:label>producesLot</rdfs:label>
        <rdfs:comment xml:lang="es">Una WorkOrder produce un Lot (reglas R03 y R23, Fragmento de código 3.4).</rdfs:comment>
        <rdfs:domain rdf:resource="http://w3id.org/protys/ontology/iso15531#WorkOrder"/>
        <rdfs:range rdf:resource="http://w3id.org/protys/ontology/iso15531#Lot"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://w3id.org/protys/ontology/iso15531#requiresResource">
        <rdfs:label>requiresResource</rdfs:label>
        <rdfs:comment xml:lang="es">Una operación requiere un recurso de manufactura (regla R12, Fragmento de código 3.4).</rdfs:comment>
        <rdfs:domain rdf:resource="http://w3id.org/protys/ontology/iso15531#ProcessOperation"/>
        <rdfs:range rdf:resource="http://w3id.org/protys/ontology/iso15531#ManufacturingResource"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://w3id.org/protys/ontology/iso15531#hasCapability">
        <rdfs:label>hasCapability</rdfs:label>
        <rdfs:comment xml:lang="es">Un recurso posee una capacidad de manufactura (cabeza de la regla R12, Fragmento de código 3.4).</rdfs:comment>
        <rdfs:domain rdf:resource="http://w3id.org/protys/ontology/iso15531#ManufacturingResource"/>
        <rdfs:range rdf:resource="http://w3id.org/protys/ontology/iso15531#ManufacturingCapability"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://w3id.org/protys/ontology/iso15531#resourceCurrentState">
        <rdfs:label>resourceCurrentState</rdfs:label>
        <rdfs:comment xml:lang="es">Estado registrado de un recurso de manufactura. El estado consumido no convierte el recurso en ElementaryFlow ni lo identifica con un registro de flujo.</rdfs:comment>
        <rdfs:domain rdf:resource="http://w3id.org/protys/ontology/iso15531#ManufacturingResource"/>
        <rdfs:range rdf:resource="http://w3id.org/protys/ontology/iso15531#ResourceState"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://w3id.org/protys/ontology/iso15531#partOfProcess">
        <rdfs:label>partOfProcess</rdfs:label>
        <rdfs:comment xml:lang="es">Una operación es parte de un proceso de manufactura (regla R02, Anexo C).</rdfs:comment>
        <rdfs:domain rdf:resource="http://w3id.org/protys/ontology/iso15531#ProcessOperation"/>
        <rdfs:range rdf:resource="http://w3id.org/protys/ontology/iso15531#ManufacturingProcess"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://w3id.org/protys/ontology/iso15531#hasProcess">
        <rdfs:label>hasProcess</rdfs:label>
        <rdfs:comment xml:lang="es">Un lote se asocia a los procesos por los que transita (regla R05, Anexo C).</rdfs:comment>
        <rdfs:domain rdf:resource="http://w3id.org/protys/ontology/iso15531#Lot"/>
        <rdfs:range rdf:resource="http://w3id.org/protys/ontology/iso15531#ManufacturingProcess"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://w3id.org/protys/ontology/iso15531#hasActivity">
        <rdfs:label>hasActivity</rdfs:label>
        <rdfs:comment xml:lang="es">Trazabilidad lote a actividades/operaciones (regla R21, Anexo C).</rdfs:comment>
        <rdfs:domain rdf:resource="http://w3id.org/protys/ontology/iso15531#Lot"/>
        <rdfs:range rdf:resource="http://w3id.org/protys/ontology/iso15531#ProcessOperation"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://w3id.org/protys/ontology/iso15531#assignsResource">
        <rdfs:label>assignsResource</rdfs:label>
        <rdfs:comment xml:lang="es">Un plan de proceso asigna recursos (regla R09, Anexo C).</rdfs:comment>
        <rdfs:domain rdf:resource="http://w3id.org/protys/ontology/iso15531#ProcessPlan"/>
        <rdfs:range rdf:resource="http://w3id.org/protys/ontology/iso15531#ManufacturingResource"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://w3id.org/protys/ontology/iso15531#includesActivity">
        <rdfs:label>includesActivity</rdfs:label>
        <rdfs:comment xml:lang="es">Un plan de proceso incluye operaciones/actividades (regla R09, Anexo C).</rdfs:comment>
        <rdfs:domain rdf:resource="http://w3id.org/protys/ontology/iso15531#ProcessPlan"/>
        <rdfs:range rdf:resource="http://w3id.org/protys/ontology/iso15531#ProcessOperation"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://w3id.org/protys/ontology/iso15531#usesResource">
        <rdfs:label>usesResource</rdfs:label>
        <rdfs:comment xml:lang="es">Una actividad usa un recurso (cabeza de la regla R09, Anexo C).</rdfs:comment>
        <rdfs:domain rdf:resource="http://w3id.org/protys/ontology/iso15531#ProcessOperation"/>
        <rdfs:range rdf:resource="http://w3id.org/protys/ontology/iso15531#ManufacturingResource"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://w3id.org/protys/ontology/iso15531#processedOn">
        <rdfs:label>processedOn</rdfs:label>
        <rdfs:comment xml:lang="es">Un lote se procesa sobre un equipo (regla R17, Anexo C).</rdfs:comment>
        <rdfs:domain rdf:resource="http://w3id.org/protys/ontology/iso15531#Lot"/>
        <rdfs:range rdf:resource="http://w3id.org/protys/ontology/iso15531#EquipmentResource"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://w3id.org/protys/ontology/iso15531#precedes">
        <rdfs:label>precedes</rdfs:label>
        <rdfs:comment xml:lang="es">Precedencia entre lotes u operaciones en la campaña de producción (reglas R17 y patrón R26).</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://w3id.org/protys/ontology/iso15531#precedesEvent">
        <rdfs:label>precedesEvent</rdfs:label>
        <rdfs:comment xml:lang="es">Precedencia de eventos MES con marcas numéricas en segundos desde un origen común y pertenecientes al mismo lote y proceso (R13).</rdfs:comment>
        <rdfs:domain rdf:resource="http://w3id.org/protys/ontology/iso15531#ManufacturingData"/>
        <rdfs:range rdf:resource="http://w3id.org/protys/ontology/iso15531#ManufacturingData"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://w3id.org/protys/ontology/iso15531#executesActivity">
        <rdfs:label>executesActivity</rdfs:label>
        <rdfs:comment xml:lang="es">Una orden de trabajo (ejecución de actividad) ejecuta una operación (regla R14, Anexo C).</rdfs:comment>
        <rdfs:domain rdf:resource="http://w3id.org/protys/ontology/iso15531#WorkOrder"/>
        <rdfs:range rdf:resource="http://w3id.org/protys/ontology/iso15531#ProcessOperation"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://w3id.org/protys/ontology/iso15531#responsibleOperator">
        <rdfs:label>responsibleOperator</rdfs:label>
        <rdfs:comment xml:lang="es">Operador responsable de una actividad, para trazabilidad (cabeza de la regla R14, Anexo C).</rdfs:comment>
        <rdfs:domain rdf:resource="http://w3id.org/protys/ontology/iso15531#ProcessOperation"/>
        <rdfs:range rdf:resource="http://w3id.org/protys/ontology/iso15531#HumanResource"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://w3id.org/protys/ontology/iso15531#hasMaintenance">
        <rdfs:label>hasMaintenance</rdfs:label>
        <rdfs:comment xml:lang="es">Asocia un recurso con un registro de mantenimiento. Sólo el estado research:maintenanceStatus ACTIVE de la instantánea permite R15; los registros PLANNED, COMPLETED o sin estado no implican indisponibilidad. No se infiere vigencia mediante fechas ni se retractan tipos al cambiar una instantánea.</rdfs:comment>
        <rdfs:domain rdf:resource="http://w3id.org/protys/ontology/iso15531#ManufacturingResource"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://w3id.org/protys/ontology/iso15531#hasNonConformity">
        <rdfs:label>hasNonConformity</rdfs:label>
        <rdfs:comment xml:lang="es">Un lote presenta una no conformidad de calidad (regla R18, Anexo C).</rdfs:comment>
        <rdfs:domain rdf:resource="http://w3id.org/protys/ontology/iso15531#Lot"/>
        <rdfs:range rdf:resource="http://w3id.org/protys/ontology/iso15531#QualityAttribute"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://w3id.org/protys/ontology/iso15531#requiresCleaningBetween">
        <rdfs:label>requiresCleaningBetween</rdfs:label>
        <rdfs:comment xml:lang="es">Se requiere limpieza entre dos lotes de familias incompatibles procesados en el mismo equipo (cabeza de la regla R17, Anexo C).</rdfs:comment>
        <rdfs:domain rdf:resource="http://w3id.org/protys/ontology/iso15531#Lot"/>
        <rdfs:range rdf:resource="http://w3id.org/protys/ontology/iso15531#Lot"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://w3id.org/protys/ontology/iso15531#hasInput">
        <rdfs:label>hasInput</rdfs:label>
        <rdfs:comment xml:lang="es">Entrada material de una actividad (patrón de validación R16, alignment-queries.sparql).</rdfs:comment>
        <rdfs:domain rdf:resource="http://w3id.org/protys/ontology/iso15531#ProcessOperation"/>
        <rdfs:range rdf:resource="http://w3id.org/protys/ontology/iso15531#ManufacturingResource"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://w3id.org/protys/ontology/iso15531#consumesMaterial">
        <rdfs:label>consumesMaterial</rdfs:label>
        <rdfs:comment xml:lang="es">Una actividad consume un material (regla R20, Anexo C).</rdfs:comment>
        <rdfs:domain rdf:resource="http://w3id.org/protys/ontology/iso15531#ProcessOperation"/>
        <rdfs:range rdf:resource="http://w3id.org/protys/ontology/iso15531#ManufacturingResource"/>
    </owl:ObjectProperty>

    <!-- ============ PROPIEDADES DE DATOS ============ -->

    <owl:DatatypeProperty rdf:about="http://w3id.org/protys/ontology/iso15531#consumesEnergyKWh">
        <rdfs:label>consumesEnergyKWh</rdfs:label>
        <rdfs:comment xml:lang="es">Consumo energético de una actividad en kWh (reglas R01 y R21, Anexo C).</rdfs:comment>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://w3id.org/protys/ontology/iso15531#consumesWaterL">
        <rdfs:label>consumesWaterL</rdfs:label>
        <rdfs:comment xml:lang="es">Consumo de agua de una actividad en litros (regla R02, Anexo C).</rdfs:comment>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://w3id.org/protys/ontology/iso15531#cycleTime">
        <rdfs:label>cycleTime</rdfs:label>
        <rdfs:comment xml:lang="es">Duración de ciclo de una operación en minutos (R23); R12 utiliza el tipo explícito FineGrindingOperation.</rdfs:comment>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://w3id.org/protys/ontology/iso15531#functionalUnit">
        <rdfs:label>functionalUnit</rdfs:label>
        <rdfs:comment xml:lang="es">Unidad funcional declarada de un lote (regla R08, Anexo C).</rdfs:comment>
        <rdfs:domain rdf:resource="http://w3id.org/protys/ontology/iso15531#Lot"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://w3id.org/protys/ontology/iso15531#producesQuantity">
        <rdfs:label>producesQuantity</rdfs:label>
        <rdfs:comment xml:lang="es">Cantidad producida por un lote (regla R08, Anexo C).</rdfs:comment>
        <rdfs:domain rdf:resource="http://w3id.org/protys/ontology/iso15531#Lot"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://w3id.org/protys/ontology/iso15531#yield">
        <rdfs:label>yield</rdfs:label>
        <rdfs:comment xml:lang="es">Rendimiento de una actividad (regla R11, Anexo C).</rdfs:comment>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://w3id.org/protys/ontology/iso15531#duration">
        <rdfs:label>duration</rdfs:label>
        <rdfs:comment xml:lang="es">Duración de una actividad (regla R11, Anexo C).</rdfs:comment>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://w3id.org/protys/ontology/iso15531#timestamp">
        <rdfs:label>timestamp</rdfs:label>
        <rdfs:comment xml:lang="es">Marca temporal de un evento MES (regla R13, Anexo C).</rdfs:comment>
        <rdfs:domain rdf:resource="http://w3id.org/protys/ontology/iso15531#ManufacturingData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://w3id.org/protys/ontology/iso15531#productFamily">
        <rdfs:label>productFamily</rdfs:label>
        <rdfs:comment xml:lang="es">Nombre legible de la familia del lote. El código entero research:productFamilyCode representa la misma categoría para comparación operativa en R17 con el motor declarado.</rdfs:comment>
        <rdfs:domain rdf:resource="http://w3id.org/protys/ontology/iso15531#Lot"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://w3id.org/protys/ontology/iso15531#hasQualityStatus">
        <rdfs:label>hasQualityStatus</rdfs:label>
        <rdfs:comment xml:lang="es">Estado de calidad de un lote (regla R10, Anexo C).</rdfs:comment>
        <rdfs:domain rdf:resource="http://w3id.org/protys/ontology/iso15531#Lot"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://w3id.org/protys/ontology/iso15531#propagatedQualityStatus">
        <rdfs:label>propagatedQualityStatus</rdfs:label>
        <rdfs:comment xml:lang="es">Estado de calidad registrado como propagable sobre el mismo lote (R10); no crea ni modifica el producto final.</rdfs:comment>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://w3id.org/protys/ontology/iso15531#skillCode">
        <rdfs:label>skillCode</rdfs:label>
        <rdfs:comment xml:lang="es">Código de habilidad de un recurso humano (instancias del caso de estudio, Cap. 4).</rdfs:comment>
        <rdfs:domain rdf:resource="http://w3id.org/protys/ontology/iso15531#HumanResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://w3id.org/protys/ontology/iso15531#experienceYears">
        <rdfs:label>experienceYears</rdfs:label>
        <rdfs:comment xml:lang="es">Años de experiencia de un recurso humano (instancias del caso de estudio, Cap. 4).</rdfs:comment>
        <rdfs:domain rdf:resource="http://w3id.org/protys/ontology/iso15531#HumanResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://w3id.org/protys/ontology/iso15531#setupTimeMinutes">
        <rdfs:label>setupTimeMinutes</rdfs:label>
        <rdfs:comment xml:lang="es">Tiempo de preparación en minutos (instancias del caso de estudio, Cap. 4).</rdfs:comment>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://w3id.org/protys/ontology/iso15531#cycleTimeMinutes">
        <rdfs:label>cycleTimeMinutes</rdfs:label>
        <rdfs:comment xml:lang="es">Tiempo de ciclo en minutos (instancias del caso de estudio, Cap. 4).</rdfs:comment>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://w3id.org/protys/ontology/iso15531#operationSequence">
        <rdfs:label>operationSequence</rdfs:label>
        <rdfs:comment xml:lang="es">Secuencia de una operación dentro del plan (instancias del caso de estudio, Cap. 4).</rdfs:comment>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>

</rdf:RDF>
