    paint:OEEPercent 88.0 ;
    iso15531:hasCapability paint:Batch_Mixing ;
    paint:temperatureCelsius 40.0 ;
    paint:speedRPM 150.0 ;
    paint:hasURI "http://w3id.org/protys/instances/equipment/MixingReactor_02"^^xsd:anyURI ;
    paint:belongsTo paint:Cell_Mixing .

paint:Batch_Mixing
    rdf:type iso15531:ManufacturingCapability ;
