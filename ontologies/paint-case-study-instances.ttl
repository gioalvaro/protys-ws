    rdfs:label "Molino de Perlas Unidad 01"@es ;
    core:hasName "PearlMill_01" ;
    core:hasDescription "Horizontal pearl mill for fine grinding and pigment dispersion" ;
    paint:energyConsumptionKW 75.0 ;
    paint:capacityLitersPerHour 500.0 ;
    paint:availabilityPercent 85.0 ;
    paint:OEEPercent 82.0 ;
    iso15531:hasCapability paint:Fine_Grinding ;
    paint:hasURI "http://w3id.org/protys/instances/equipment/PearlMill_01"^^xsd:anyURI ;
    paint:belongsTo paint:Cell_Dispersion .

