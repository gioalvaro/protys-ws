    paint:capacityUnitsPerMinute 75.0 ;
    paint:availabilityPercent 92.0 ;
    paint:OEEPercent 90.0 ;
    iso15531:hasCapability paint:Auto_Packaging ;
    paint:hasURI "http://w3id.org/protys/instances/equipment/PackagingMachine_05"^^xsd:anyURI ;
