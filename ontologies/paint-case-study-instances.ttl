    paint:hasURI "http://w3id.org/protys/instances/product/WhitePaint_Final_001"^^xsd:anyURI .

# ========================================
# QUALITY SPECIFICATIONS
# ========================================

paint:Viscosity_KU_Spec
    rdf:type paint:QualitySpec ;
    rdfs:label "Viscosity Specification (KU)"@en ;
    rdfs:label "Especificación de Viscosidad (KU)"@es ;
    core:hasName "Viscosity_85±5_KU" ;
    core:hasDescription "Viscosity must be 85 ± 5 Krebs Units" ;
    paint:hasValue 85.0 ;
    paint:impactUnit "KU (Krebs Units)" ;
    paint:hasURI "http://w3id.org/protys/instances/spec/Viscosity_001"^^xsd:anyURI .

paint:ParticleSize_Hegman_Spec
    rdf:type paint:QualitySpec ;
    rdfs:label "Particle Size Specification (Hegman)"@en ;
    rdfs:label "Especificación de Tamaño de Partícula (Hegman)"@es ;
    core:hasName "ParticleSize_Hegman_7plus" ;
    core:hasDescription "Hegman grind gauge reading must be 7 or greater (finer than 25 micrometers)" ;
    paint:hasValue 7.0 ;
    paint:impactUnit "Hegman Gauge Points" ;
    paint:hasURI "http://w3id.org/protys/instances/spec/ParticleSize_001"^^xsd:anyURI .

