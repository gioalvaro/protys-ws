# ========================================
# MANUFACTURING PROCESSES
# ========================================

paint:RawMaterialInspection
    rdf:type paint:Inspection ;
    rdfs:label "Raw Material Inspection"@en ;
    rdfs:label "Inspección de Materia Prima"@es ;
    core:hasName "RawMaterialInspection" ;
    core:hasDescription "Quality inspection of incoming raw materials" ;
    paint:durationMinutes 15.0 ;
    core:precedes paint:PigmentDispersion ;
    paint:belongsTo paint:Workshop_QC ;
    paint:hasURI "http://w3id.org/protys/instances/process/RawMatInsp_001"^^xsd:anyURI .

paint:PigmentDispersion
    rdf:type process:Procedure_Activity ;
    rdfs:label "Pigment Dispersion"@en ;
    rdfs:label "Dispersión de Pigmento"@es ;
    core:hasName "PigmentDispersion" ;
    core:hasDescription "Fine grinding and dispersion of TiO2 pigment using pearl mill" ;
    paint:durationMinutes 45.0 ;
    paint:inputQuantity 500.0 ;
    paint:outputQuantity 485.0 ;
    paint:yieldPercent 97.0 ;
    paint:speedRPM 1500.0 ;
    paint:throughput 11.1 ;
    resource:requiresResource paint:PearlMill_01 ;
    resource:consumesResource paint:TiO2_Material ;
    core:produces paint:PigmentPaste_Intermediate ;
    core:precedes paint:MainMixing ;
    paint:belongsTo paint:Cell_Dispersion ;
    paint:hasURI "http://w3id.org/protys/instances/process/PigmentDisp_001"^^xsd:anyURI .

paint:MainMixing
    rdf:type paint:BatchProcess ;
    rdfs:label "Main Mixing"@en ;
    rdfs:label "Mezcla Principal"@es ;
    core:hasName "MainMixing" ;
    core:hasDescription "Batch mixing of pigment paste with acrylic resin and solvents" ;
    paint:durationMinutes 25.0 ;
    paint:inputQuantity 485.0 ;
    paint:outputQuantity 510.0 ;
    paint:yieldPercent 105.0 ;
    paint:temperatureCelsius 45.0 ;
    paint:speedRPM 250.0 ;
    paint:throughput 20.4 ;
    resource:requiresResource paint:MixingReactor_02 ;
    resource:consumesResource paint:PigmentPaste_Intermediate ;
    resource:consumesResource paint:AcrylicResin ;
    resource:consumesResource paint:AqueousSolvent ;
    core:produces paint:AdjustedMix_Intermediate ;
    core:precedes paint:ViscosityAdjustment ;
    paint:belongsTo paint:Cell_Mixing ;
    paint:hasURI "http://w3id.org/protys/instances/process/MainMix_001"^^xsd:anyURI .

paint:ViscosityAdjustment
    rdf:type process:Procedure_Activity ;
    rdfs:label "Viscosity Adjustment"@en ;
    rdfs:label "Ajuste de Viscosidad"@es ;
    core:hasName "ViscosityAdjustment" ;
    core:hasDescription "Fine-tuning of paint viscosity to specifications using rheology modifiers" ;
    paint:durationMinutes 15.0 ;
    paint:inputQuantity 510.0 ;
    paint:outputQuantity 515.0 ;
    paint:yieldPercent 101.0 ;
    resource:requiresResource paint:DosingSystem_03 ;
    resource:consumesResource paint:RheologyModifier ;
    core:precedes paint:Filtration ;
    paint:belongsTo paint:Cell_Mixing ;
    paint:hasURI "http://w3id.org/protys/instances/process/ViscAdj_001"^^xsd:anyURI .

paint:Filtration
    rdf:type process:Procedure_Activity ;
    rdfs:label "Filtration"@en ;
    rdfs:label "Filtración"@es ;
    core:hasName "Filtration" ;
    core:hasDescription "Removal of coarse particles and agglomerates through filtration" ;
    paint:durationMinutes 10.0 ;
    paint:inputQuantity 515.0 ;
    paint:outputQuantity 512.0 ;
    paint:yieldPercent 99.4 ;
    paint:throughput 51.2 ;
    core:precedes paint:QualityControl_Stage ;
    paint:hasURI "http://w3id.org/protys/instances/process/Filtration_001"^^xsd:anyURI .

paint:QualityControl_Stage
    rdf:type paint:QualityControl ;
    rdfs:label "Quality Control"@en ;
    rdfs:label "Control de Calidad"@es ;
    core:hasName "QualityControl" ;
    core:hasDescription "Comprehensive quality testing and verification of final paint formulation" ;
    paint:durationMinutes 30.0 ;
    paint:inputQuantity 512.0 ;
    resource:requiresResource paint:Workshop_QC ;
    core:precedes paint:Packaging_Stage ;
    paint:belongsTo paint:Workshop_QC ;
    paint:hasURI "http://w3id.org/protys/instances/process/QC_001"^^xsd:anyURI .

paint:Packaging_Stage
    rdf:type paint:Packaging ;
    rdfs:label "Packaging"@en ;
    rdfs:label "Empaquetado"@es ;
    core:hasName "Packaging" ;
    core:hasDescription "Automatic packaging of finished paint into containers" ;
    paint:durationMinutes 20.0 ;
    paint:inputQuantity 500.0 ;
    paint:outputQuantity 500.0 ;
    paint:yieldPercent 100.0 ;
    paint:capacityUnitsPerMinute 75.0 ;
    paint:throughput 25.0 ;
    resource:requiresResource paint:PackagingMachine_05 ;
    core:produces paint:WhitePaint_WaterBased ;
    paint:belongsTo paint:Cell_Packaging ;
    paint:hasURI "http://w3id.org/protys/instances/process/Packaging_001"^^xsd:anyURI .

