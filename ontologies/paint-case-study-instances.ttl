# Canonical scenario, units and equipment are defined in research/data and research/catalog.json.
# Preserve original illustrative data; load ERP examples only in explicitly separate optional graphs.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix core:     <http://w3id.org/protys/ontology/core#> .
@prefix product:  <http://w3id.org/protys/ontology/product#> .
@prefix process:  <http://w3id.org/protys/ontology/process#> .
@prefix resource: <http://w3id.org/protys/ontology/resource#> .
@prefix enterprise: <http://w3id.org/protys/ontology/enterprise#> .
@prefix iso14040: <http://w3id.org/protys/ontology/iso14040#> .
@prefix iso15531: <http://w3id.org/protys/ontology/iso15531#> .
@prefix paint:    <http://w3id.org/protys/ontology/paint-ext#> .

# ========================================
# PAINT MANUFACTURING CASE STUDY INSTANCES
# ========================================

# ========================================
# MATERIALS
# ========================================

paint:TiO2_Material
    rdf:type resource:Raw_Material ;
    rdfs:label "Titanium Dioxide (TiO2)"@en ;
    rdfs:label "Dióxido de Titanio (TiO2)"@es ;
    core:hasName "TiO2 Pigment" ;
    core:hasDescription "High-purity titanium dioxide for white paint formulations" ;
    iso14040:carbonFootprintKgCO2eq 5.3 ;
    iso14040:waterFootprintLiters 45.0 ;
    paint:particleSize 0.25 ;
    paint:purityPercent 98.0 ;
    paint:hasURI "http://w3id.org/protys/instances/material/TiO2_001"^^xsd:anyURI .

paint:AcrylicResin
    rdf:type paint:Chemical_Compound ;
    rdfs:label "Acrylic Resin"@en ;
    rdfs:label "Resina Acrílica"@es ;
    core:hasName "Acrylic Binder Resin" ;
    core:hasDescription "Water-soluble acrylic resin for paint binder formulation" ;
    iso14040:waterFootprintLiters 127.0 ;
    paint:volatileOrganicCompounds 2.5 ;
    paint:solidContent 45.0 ;
    paint:viscosity 500.0 ;
    paint:shelfLifeMonths 12 ;
    paint:hasURI "http://w3id.org/protys/instances/material/AcrylicResin_001"^^xsd:anyURI .

paint:AqueousSolvent
    rdf:type resource:Raw_Material ;
    rdfs:label "Aqueous Solvent"@en ;
    rdfs:label "Disolvente Acuoso"@es ;
    core:hasName "Water Solvent" ;
    core:hasDescription "Deionized water used as primary solvent" ;
    iso14040:waterFootprintLiters 100.0 ;
    paint:solidContent 0.0 ;
    paint:hasURI "http://w3id.org/protys/instances/material/H2O_001"^^xsd:anyURI .

paint:DispersantAdditive
    rdf:type paint:Chemical_Compound ;
    rdfs:label "Dispersant Additive"@en ;
    rdfs:label "Aditivo Dispersante"@es ;
    core:hasName "Pigment Dispersant" ;
    core:hasDescription "Additive to improve pigment dispersion and stability" ;
    paint:volatileOrganicCompounds 0.5 ;
    paint:solidContent 85.0 ;
    paint:hasURI "http://w3id.org/protys/instances/material/Dispersant_001"^^xsd:anyURI .

paint:AntifoamAdditive
    rdf:type paint:Chemical_Compound ;
    rdfs:label "Antifoam Additive"@en ;
    rdfs:label "Aditivo Antiespuma"@es ;
    core:hasName "Silicone-based Antifoam" ;
    core:hasDescription "Reduces foam formation during mixing and application" ;
    paint:solidContent 80.0 ;
    paint:hasURI "http://w3id.org/protys/instances/material/Antifoam_001"^^xsd:anyURI .

paint:Biocide
    rdf:type paint:Chemical_Compound ;
    rdfs:label "Biocide"@en ;
    rdfs:label "Biocida"@es ;
    core:hasName "Preservative Biocide" ;
    core:hasDescription "Antimicrobial agent for product preservation" ;
    paint:solidContent 100.0 ;
    paint:hasURI "http://w3id.org/protys/instances/material/Biocide_001"^^xsd:anyURI .

paint:RheologyModifier
    rdf:type paint:Chemical_Compound ;
    rdfs:label "Rheology Modifier"@en ;
    rdfs:label "Modificador de Reología"@es ;
    core:hasName "Viscosity Control Agent" ;
    core:hasDescription "Controls paint viscosity and flow properties" ;
    paint:solidContent 75.0 ;
    paint:hasURI "http://w3id.org/protys/instances/material/RheologyMod_001"^^xsd:anyURI .

