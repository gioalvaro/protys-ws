    rdfs:label "Mezcla por Lotes"@es ;
    core:hasName "Batch_Mixing_Capability" .

paint:DosingSystem_03
    rdf:type resource:Equip ;
    rdfs:label "Dosing System Unit 03"@en ;
    rdfs:label "Sistema de Dosificación Unidad 03"@es ;
    core:hasName "DosingSystem_03" ;
    core:hasDescription "Precision metering system for additive dosing with ±0.1% accuracy" ;
    paint:capacityLitersPerHour 100.0 ;
    paint:availabilityPercent 95.0 ;
    paint:OEEPercent 92.0 ;
    iso15531:hasCapability paint:Precision_Metering ;
    paint:hasURI "http://w3id.org/protys/instances/equipment/DosingSystem_03"^^xsd:anyURI ;
    paint:belongsTo paint:Cell_Mixing .

paint:Precision_Metering
    rdf:type iso15531:ManufacturingCapability ;
    rdfs:label "Precision Metering"@en ;
    rdfs:label "Dosificación Precisa"@es ;
    core:hasName "Precision_Metering_Capability" .

paint:DryingDrum_04
    rdf:type resource:Equip ;
    rdfs:label "Drying Drum Unit 04"@en ;
    rdfs:label "Tambor de Secado Unidad 04"@es ;
    core:hasName "DryingDrum_04" ;
    core:hasDescription "Industrial drying drum with temperature control 60-120°C and 5-20 rpm rotation" ;
    paint:temperatureCelsius 90.0 ;
    paint:speedRPM 10.0 ;
    paint:availabilityPercent 88.0 ;
    paint:OEEPercent 85.0 ;
    iso15531:hasCapability paint:Thermal_Drying ;
    paint:hasURI "http://w3id.org/protys/instances/equipment/DryingDrum_04"^^xsd:anyURI .

paint:Thermal_Drying
    rdf:type iso15531:ManufacturingCapability ;
